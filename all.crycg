      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color.xyz = decalColor.xyz * IN.Color.xyz;
        OUT.Color.a = decalColor.b;
      }
      
