      #include "../CGVPMacro.csi"

      NoFog

      VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR SEC_COLOR }
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, BEND, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
          IN_C1
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy; // * float2(4,0.5);
                
        // Tangent space light vector
        OUT.Color1.xyz = IN.Color1.xyz;
        OUT.Tex2.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex3.xy  = mul(FogMatrix, vPos);
        OUT.Color   = IN.Color;
      }
