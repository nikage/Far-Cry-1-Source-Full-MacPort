      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, BEND, uniform float4 ObjPos }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
