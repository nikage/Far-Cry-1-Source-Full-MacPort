// ===============================================================
// Fragment Program: hologram
// Description: used with holograms..
// Last Update: 2/10/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D tableMap : texunit0,
            uniform sampler2D decalMap : texunit1,
            uniform sampler2D noiseMap : texunit2
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
  };

  FOUT
}

CoreScript
{
  // load colors
  float4 tableColor = tex2D(tableMap, IN.Tex0.xy);                
  float4 decalColor = tex2D(decalMap, IN.Tex1.xy);                
  float4 noiseColor = tex2D(noiseMap, IN.Tex2.xy);                
              
  float fLum = 2*dot(float3(0.5, 0.5, 0.5), decalColor.xyz);
  float fNoiseLum= 2*dot(float3(0.33, 0.59, 0.11), noiseColor.xyz);
  fNoiseLum*=fNoiseLum;
  fNoiseLum*=fNoiseLum*0.5;
          
  OUT.Color.xyz = HDREncode(tableColor*fLum*fNoiseLum); 
  OUT.Color.w= 1;  
}// ===============================================================
// Fragment Program: Indoor Water
// Description: used in indoor refractive water (w/ fake reflection)
// Last Update: 03/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1,
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 WaterColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
  };

  FOUT
}

CoreScript
{  
  // load the decal
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);

// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...
  float4 refrColor;
#ifdef D3D
  # ifdef _PS_1_1
    refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);
  # else
    float2 newst = IN.Tex1.xy / IN.Tex1.w;
    float2 newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    refrColor = tex2D(refMap, newst);
  # endif
#endif
#ifdef OPENGL
  # ifdef _PS_1_1
    refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);
  # else
    float2 newst = IN.Tex1.xy / IN.Tex1.w;
    float2 newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    refrColor = texRECT(refMap, newst);
  # endif
#endif  
  
  float fFakeSpec=dot(refrColor.xyz, float3(0.33, 0.59, 0.11));                                 // get brightest color
  fFakeSpec=saturate(0.75*fFakeSpec + fFakeSpec);                                   // bright it a bit
  float3 fFakeSpecColor=refrColor.xyz*fFakeSpec;                                         // compute specular color
  OUT.Color.xyz = Ambient.xyz*( saturate(fFakeSpecColor*WaterColor.w + WaterColor.xyz) );      // compute final surface color  
}// ===============================================================
// Fragment Program: Indoor Water
// Description: used in indoor refractive water (w/ fake specular)
// Last Update: 03/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1,
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 WaterColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
  };

  FOUT
}

CoreScript
{  
  // load the decal
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);

  // get env bump map surface
# ifdef _PS_1_1
  float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);          
# else
  float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
  float4 refrColor = tex2D(refMap, newst);
# endif                
  
  // get brightest color  
  float fDiffuse=2*(dot(refrColor.xyz, float3(0.33, 0.59, 0.11))-0.5);                          

  // aprox~ spec^8      
  float fFakeSpec=fDiffuse;
  fFakeSpec=saturate(2*(fFakeSpec*fFakeSpec-0.6));                                            
        
  // compute water surface color  
  float3 fWaterSurfColor=saturate(fDiffuse*WaterColor.xyz+fFakeSpec*Ambient.w);            
  
  // set water to ambient color
  OUT.Color.xyz =Ambient.xyz*fWaterSurfColor;                                    
  // output fresnel*transparency amount
  OUT.Color.w = IN.Color.w*WaterColor.w; 
}// ===============================================================
// Fragment Program: Indoor Water
// Description: used in indoor refractive water
// Last Update: 29/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"

MainInput { uniform sampler2D bumpMap : texunit0,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit1,             
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit1,
#endif
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 WaterColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
  };

  FOUT
}

CoreScript
{
  // load the decal
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
  
// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...
#ifdef D3D
  # ifdef _PS_1_1
    float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);
  # else
    float2 newst = IN.Tex1.xy / IN.Tex1.w;
    newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = tex2D(refMap, newst);
  # endif
#endif
#ifdef OPENGL
  # ifdef _PS_1_1
    float4 refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);
  # else
    float2 newst = IN.Tex1.xy / IN.Tex1.w;
    newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = texRECT(refMap, newst);
  # endif
#endif  

# ifdef _HDR
	refrColor.xyz = refrColor.xyz * 2;
# endif	

  OUT.Color.xyz = refrColor.xyz*WaterColor.xyz;                                   // compute final water refraction color
  OUT.Color.w = 1; //IN.Color.w;                                                   // output fresnel term
}
// ===============================================================
// Fragment Program: Invulnerability
// Description: used in characters when in invulneability mode
// Last Update: 02/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1, 
            uniform float4 Matrix,
            uniform float4 Amount
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
  };

  FOUT
}

CoreScript
{
  // load the decal
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
  float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);
  
  // get brightest color..
  float fBrightest=dot(float3(0,1,0), refrColor.xyz);
  fBrightest*=fBrightest;
  fBrightest*=fBrightest;
     
  OUT.Color.xyz = fBrightest*Amount.w*Amount.xyz;
  OUT.Color.w= fBrightest*Amount.w;
}// ===============================================================
// Fragment Program: Invulnerability metal fx
// Description: used in characters when in invulneability mode
// Last Update: 02/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1,
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 Amount
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
  };

  FOUT
}

CoreScript
{    
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
# ifdef _PS_1_1
  float4 refColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);  
# else
  float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
  float4 refColor = tex2D(refMap, newst);
# endif
  float fLum=dot(float3(0.33, 0.59, 0.11), refColor.xyz);
  fLum*=fLum;
  
  OUT.Color.xyz =fLum*Amount.xyz*Ambient.xyz;
  OUT.Color.w= Amount.w;    
}      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform sampler2D bumpMap : register(s1),
                  uniform sampler2D glossMap : register(s2),
                  uniform sampler1D iridescenceMap : register(s3),
                  uniform float4 Ambient : register(c0),
                  uniform float4 IridescenceScaleBias : register(c1),
                  uniform float4 TranslucencyCoeff : register(c2) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
          OUT_T5
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 baseColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        float4 vNormal = tex2D(bumpMap, IN.Tex1.xy)*2-1;
        // load the gloss map
        float4 glossColor = tex2D(glossMap, IN.Tex2.xy);

        // normalize post-filtered bump normals
        //vNormal.xyz = normalize(vNormal.xyz);
        
        Ambient.xyz = float3(0.5,0.5,0.5);
        
        //======================//
        // Compute diffuse term //
        //======================//

        // Compute the color components based on the input base texture color, 
        // the alpha value for the given pixel, ambient material color and orientation 
        // toward the light source:
        float3 Light = normalize(IN.Tex3.xyz);
        float3 scatteredIllumination = saturate(dot(-vNormal.xyz, Light.xyz)) * baseColor.a * TranslucencyCoeff.x;
        float3 diffuseContribution   = saturate(dot(vNormal.xyz, Light.xyz)) + Ambient.xyz;

        baseColor.xyz *= scatteredIllumination.xyz + diffuseContribution.xyz;

        float fOpacity = 1 - baseColor.a;

        // Premultiply alpha blend to avoid clamping:
        baseColor.xyz = baseColor.xyz * fOpacity;

        //==================================//
        // Compute Iridescence contribution //
        //==================================//
         
        //.....................................................................................//
        // Compute index into the iridescence gradient map, which consists of N*V coefficient  //
        //.....................................................................................//
        float3 View = IN.Tex4.xyz;
        float fGradientIndex = dot( vNormal.xyz, View.xyz ) * IridescenceScaleBias.z + IridescenceScaleBias.w;
         
        // Load the iridescence value from the gradient map based on the indices we just computed above:
        float4 iridescence = tex1D( iridescenceMap, fGradientIndex );

        // Compute the final color using this equation: N*H * Gloss * Iridescence + Diffuse
        float3 Half = IN.Tex5.xyz;
        float3 vGloss = glossColor.xyz * (saturate( dot( vNormal.xyz, Half.xyz )) * IridescenceScaleBias.x + IridescenceScaleBias.y);

        OUT.Color.xyz = baseColor.xyz + vGloss.xyz * iridescence.xyz;
        OUT.Color.a = fOpacity;
      }

// ===============================================================
// Fragment Program: Lava
// Description: used in lava volumes
// Last Update: 23/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D difMap : texunit0,
            uniform sampler2D bumpMap : texunit1,
            uniform sampler2D refMap : texunit2,            
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 LavaColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
    OUT_C0
  };

  FOUT
}

CoreScript
{  
  // load the decal
  float4 difColor  = tex2D(difMap,  IN.Tex0.xy);
  float4 bumpColor = tex2D(bumpMap, IN.Tex1.xy);      

# ifdef _PS_1_1
  float4 refrColor = offsettex2D(refMap, IN.Tex2.xy, bumpColor, Matrix);          // get env bump map surface
# else
        float2 newst = IN.Tex2.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
        float4 refrColor = tex2D(refMap, newst);
# endif                
  
  float fLum=2*(dot(refrColor.xyz, float3(0.0, 1.0, 0.0))-0.5);    
  fLum=(fLum-0.75)*4;
  float3 fNewColor=LavaColor.xyz*0.5;
  float3 fFinal=saturate(fLum*LavaColor.xyz + fNewColor);                                       
  fFinal = saturate(fFinal*fFinal + fNewColor); 
  
  float3 fColorOverlay=difColor*fFinal.xyz;  		
  fColorOverlay=lerp(fFinal, fColorOverlay*fColorOverlay*4, LavaColor.w);
  fColorOverlay = HDREncode(fColorOverlay.xyz);
  OUT.Color.xyz = HDRFogBlend(fColorOverlay.xyz, IN.Color.w, GlobalFogColor.xyz);
  OUT.Color.w = 1.0;
}////////////////////////////////////////////////////////////////////////////
