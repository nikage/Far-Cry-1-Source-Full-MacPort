      #include "../CGVPMacro.csi"

      NoFog
      
      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Color }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color = IN.Color.a * decalColor * Color;
      }
// ===============================================================
// Vertex Program: color contrast
// Description: used in color contrast post-processing fx
// Last Update: 02/06/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D baseMap0 : texunit0,
            uniform float4 fContrastAmount            
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  // load the decal
  float3 fTex0 = tex2D(baseMap0, IN.Tex0.xy).rgb;
      
  OUT.Color.rgb= 0.5f+fContrastAmount.a*(fTex0-0.5f);
  OUT.Color.a = 1.0f;
}


// ===============================================================
// Vertex Program: color transfer
// Description: used in color transfer post-processing fx
// Last Update: 02/06/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D baseMap0 : texunit0,
            uniform float4 fTransfColor,
            uniform float4 fTransfAmount
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  // load the decal
  float3 fTex0 = tex2D(baseMap0, IN.Tex0.xy).rgb;
    
  float3 fColor=float3(1.0, .86, 0.61);
  float3 fLumSet=float3(0.30f, 0.59f, 0.11f);
  float3 fLuminosity= dot( fLumSet, fTex0 )*2.0f;  
  
  //float3 fFinal=(1-fLuminosity)*fColor+fLuminosity;  
  //OUT.Color.rgb = fFinal*fLuminosity;

  float3 fFinal=fLuminosity*fColor+(1.0f-fColor)* (fLuminosity-1.0f);

  OUT.Color.rgb= lerp(fTex0, fFinal, fTransfAmount.a);
  OUT.Color.a = 1.0f;
}


