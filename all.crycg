      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 TANG_3X3 }
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, TEX_MATRIX2x4, LIGHT_POS, BEND }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosBending
      CoreScript
      {
        float2 tCoords = mul(TexMatrix, IN.TexCoord0);
        OUT.Tex0.xy = tCoords;
        OUT.Tex1.xy = tCoords;

        // compute the 3x3 tranform from tangent space to object space
        // store normalized light vector
        float3 lightVec = normalize(LightPos.xyz - vPos.xyz);
        float3 normal = IN.TNormal;
        float fDot = dot(lightVec, normal);
        normal = normal * sign(fDot);

        float3x3 objToTangentSpace;
        objToTangentSpace[0] = IN.Tangent;
        objToTangentSpace[1] = IN.Binormal;
        objToTangentSpace[2] = normal;
        
        // transform light vector from object space to tangent space and pass it as a color
        OUT.Tex2.xyz = mul(objToTangentSpace, LightPos.xyz - vPos.xyz);
        OUT.Color = IN.Color;
# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif        
      }
