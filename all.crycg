// Fragment Program: Night Vision
// Description: Night vision fx
// Last Update: 23/06/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
#ifdef OPENGL
	uniform samplerRECT baseMap0 : texunit0,
#endif	
#ifdef D3D
	uniform sampler2D baseMap0 : texunit0,
#endif	
	uniform sampler2D baseMap1 : texunit1,
	uniform float4 fBluryParams
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	};

	FOUT
}

CoreScript
{
	// fetch textures
#ifdef OPENGL
	float4 fTex0 = texRECT(baseMap0, IN.Tex0.xy);
#endif	
#ifdef D3D
	float4 fTex0 = tex2D(baseMap0, IN.Tex0.xy);
#endif	
	float4 fTex1 = tex2D(baseMap1, IN.Tex1.xy);
		
	// transfer color(0.6, .9, 0.81), -1.0+fAmbientGain(0.2)
	float3 fColor=float3(0.6-0.85, .9-0.85, 0.81-0.85);	
	
	// double luminosity = (0.30f, 0.59f, 0.11f)*2
	float3 fLumSet=float3(0.30f, 0.59f, 0.11f);//(0.6f, 1.0f, 0.22f);
	
	// compute luminosity		
	float fLuminosity= dot( fLumSet, fTex0 );  	
	
	// tranfer color = fLuminosity+fColor;
	float3 fFinal=fLuminosity+fColor;
	
	// apply noise to final color
	OUT.Color.xyz = fFinal*(fTex1+0.5);
	
	OUT.Color.w = 1.0f;
}

// ===============================================================
// Fragment Program: CryVision + Glare
// Description: Cryvision + glare, optimized version
// Last Update: 21/10/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
#ifdef OPENGL
	uniform samplerRECT ScreenTex : texunit0,
	uniform samplerRECT GlareTex : texunit1,	
	uniform samplerRECT HeatTex : texunit2,	
#endif	
#ifdef D3D
	uniform sampler2D ScreenTex : texunit0,
	uniform sampler2D GlareTex : texunit1,	
	uniform sampler2D HeatTex : texunit2,	
#endif	
	uniform sampler2D NoiseTex : texunit3,	
	uniform float4 Glare,
	uniform float4 NVColor
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	  OUT_T2
	  OUT_T3
	};

	FOUT
}

CoreScript
{
  float3 fLuminosity=float3(0.33f, 0.59f, 0.11f);
  float3 fNightColor= float3(-0.1, 0.25, 0.2);
  //float3 fNightColor= float3(-0.1, 0.3, 0.6);

	// load the decal
#ifdef OPENGL
	float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);
	float4 fGlareColor = texRECT(GlareTex, IN.Tex1.xy);
	float4 fHeatColor = texRECT(HeatTex, IN.Tex2.xy);
#endif	
#ifdef D3D
	float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);
	float4 fGlareColor = tex2D(GlareTex, IN.Tex1.xy);
	float4 fHeatColor = tex2D(HeatTex, IN.Tex2.xy);
#endif	
	float4 fNoiseColor = tex2D(NoiseTex, IN.Tex3.xy);
				
				
	// compute luminosity		
	float fScreenLuminosity= dot( fLuminosity, fScreenColor.xyz );  		
	float fGlareLuminosity= dot( fLuminosity, fGlareColor.xyz );
		
	float fColor = saturate( fGlareLuminosity );	
	fColor = saturate(fColor*Glare.w + fScreenLuminosity);
	
	float3 fFinal= saturate( 2*(fColor*fNoiseColor + fNightColor*0.2)*fHeatColor)*fNoiseColor;
							  			
	OUT.Color.xyz = fFinal;
	OUT.Color.w = 1;
}

