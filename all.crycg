      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the fade color
        float4 fadeColor = tex2D(fadeMap, IN.Tex1.xy);
        
        float4 color = decalColor * IN.Color;

        // finally add them all together
        OUT.Color.xyz = color.xyz;
        OUT.Color.w = color.w * fadeColor.b;
      }
// ===============================================================
// Fragment Program: Blur
// Description: averages texture colors
// Last Update: 12/09/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{
	uniform sampler2D baseMap0 : texunit0,
	uniform sampler2D baseMap1 : texunit1,
	uniform sampler2D baseMap2 : texunit2,
	uniform sampler2D baseMap3 : texunit3 
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	  OUT_T2
	  OUT_T3
	};

	FOUT
}

CoreScript
{
	// load the decal
	float4 color0 = tex2D(baseMap0, IN.Tex0.xy);
	float4 color1 = tex2D(baseMap1, IN.Tex1.xy);
	float4 color2 = tex2D(baseMap2, IN.Tex2.xy);
	float4 color3 = tex2D(baseMap3, IN.Tex3.xy);

  // safe/acurate version
	//float4 avg= float4(0.5, 0.5, 0.5, 0.5);
	//float4 colorA = saturate(color0*avg+color1*avg)*0.5;
	//float4 colorB = saturate(color2*avg+color3*avg)*0.5;
	
	// fast version
	float4 avg=saturate(color0*0.25+color2*0.25+color1*0.25+color3*0.25);
	
	// finally add them all together
	OUT.Color =avg;
}

// ===============================================================
// Fragment Program: Blur
// Description: averages texture colors
// Last Update: 12/09/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{
	uniform samplerRECT baseMap0 : texunit0,
	uniform samplerRECT baseMap1 : texunit1,
	uniform samplerRECT baseMap2 : texunit2,
	uniform samplerRECT baseMap3 : texunit3 
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	  OUT_T2
	  OUT_T3
	};

	FOUT
}

CoreScript
{
	// load the decal
	float4 color0 = texRECT(baseMap0, IN.Tex0.xy);
	float4 color1 = texRECT(baseMap1, IN.Tex1.xy);
	float4 color2 = texRECT(baseMap2, IN.Tex2.xy);
	float4 color3 = texRECT(baseMap3, IN.Tex3.xy);

	float4 avg= float4(0.5, 0.5, 0.5, 0.5);
	float4 colorA = saturate(color0*avg+color1*avg)*0.5;
	float4 colorB = saturate(color2*avg+color3*avg)*0.5;
	
	// finally add them all together
	OUT.Color = saturate(colorA+colorB);
}


#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
	uniform sampler2D BlurSampler : texunit0,
  uniform FLOAT4 BlurOffset,
  uniform FLOAT4 vPixelWeights[8]
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	};

	FOUT
}

CoreScript
{
	FLOAT4 color = tex2D( BlurSampler, IN.Tex0.xy );

	// Sample pixels on either side
	for(int i=0; i<8; i++)
	{
		color += tex2D( BlurSampler, IN.Tex0.xy + ( BlurOffset.xy * i ) ) * vPixelWeights[i];
		color += tex2D( BlurSampler, IN.Tex0.xy - ( BlurOffset.xy * i ) ) * vPixelWeights[i];
	}

	OUT.Color = color;
}

// ===============================================================
// Fragment Program: Blury screen
// Description: lerp between blured texture and sharp texture
// Last Update: 20/06/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{ 
#ifdef OPENGL
	uniform samplerRECT baseMap0 : texunit0,    
  uniform samplerRECT baseMap1 : texunit1,
#endif  
#ifdef D3D
	uniform sampler2D baseMap0 : texunit0,    
  uniform sampler2D baseMap1 : texunit1,
#endif  
    uniform float4 fBluryParams
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	};

	FOUT
}
CoreScript
{
	// load the decal
#ifdef OPENGL
	float4 fColor0 = texRECT(baseMap0, IN.Tex0.xy);
	float4 fColor1 = texRECT(baseMap1, IN.Tex1.xy);
#endif
#ifdef D3D
	float4 fColor0 = tex2D(baseMap0, IN.Tex0.xy);
	float4 fColor1 = tex2D(baseMap1, IN.Tex1.xy);
#endif

	float fTemp = dot(float3(0.33, 0.59, 0.11), fColor0.xyz);
	float3 fDesaturated= fTemp*fBluryParams.xyz; //lerp(fColor0.xyz, fTemp, 0.5)

	// finally add them all together	
	OUT.Color.xyz = lerp(fColor1.xyz, fDesaturated*fDesaturated*4, fBluryParams.w);                
	OUT.Color.w = 1.0f;
}


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D bumpMap : texunit0,
                  uniform sampler2D gradMap : texunit2,
                  uniform sampler2D baseMap : texunit3,
                  uniform float4 Diffuse,
	                uniform float4 Specular,
	                uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex3.xy);
        // load the bump normal
        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex0.xy)-0.5);
        // compute texCoord(NdotH, 0) and use it to look up NdotH^power in the power texture
        // This should create a texm3x2tex instruction for ps_1_1 equivalent to the ps_1_1
        // builtin tex2D_dp3x2 (which is not supported in any other profile):
        //    float4 NdotL_NdotH = tex2D_dp3x2(specPowMap, IN.Tex2, bumpNormal);
        float2 texCoord = float2(
            dot(IN.Tex1.xyz, bumpNormal.xyz),
            dot(IN.Tex2.xyz, bumpNormal.xyz));
        float4 NdotL_NdotH = tex2D(gradMap, texCoord);

        float3 dif = (Diffuse.rgb * NdotL_NdotH.xyz * decalColor.xyz) * 2;
        float3 amb = decalColor.xyz * Ambient.xyz;
        // compute the specular color
        float3 spec = (Specular.xyz * NdotL_NdotH.w) * 2;
        
        // finally add them all together
        OUT.Color.xyz = amb + dif + spec;
        OUT.Color.w = Ambient.w * decalColor.w;
      }

      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform samplerCUBE envMap : register(s1),
                  uniform float4 AlphaScaleBias : register(c0) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 baseColor = tex2D(baseMap, IN.Tex0.xy);
        // load the env cube
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);
        
        float3 color = saturate(baseColor.xyz * envColor.xyz * 2);
        float fresnel = (1-abs(IN.Tex2.r)) * AlphaScaleBias.x + AlphaScaleBias.y;
        float glow = saturate((envColor.a*envColor.a-0.75)*4);
        
        color = lerp(color.xyz, envColor.xyz, glow);
        float alpha = fresnel + glow;

        OUT.Color.xyz = color.xyz;
        OUT.Color.a = alpha;
      }

