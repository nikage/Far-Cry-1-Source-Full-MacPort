      #include "../CGVPMacro.csi"

      NoFog

      VertAttributes { POSITION_3 TNORMAL_3 }
      
      MainInput { VIEWPROJ_MATRIX, uniform float4 Offset }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        vPos.xyz = vPos.xyz + IN.TNormal.xyz * Offset.x;
        OUT.Tex0.xy = dot(ModelViewProj._31_32_33_34, vPos) / dot(ModelViewProj._41_42_43_44, vPos);
      }
