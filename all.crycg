////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D bumpMap : texunit1,
                  uniform sampler2D fogMap : texunit2,
                  uniform sampler2D fogEnterMap : texunit3,
                  uniform float4 Ambient,
                  uniform float4 FogColor,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);
        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex2.xy);
        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex3.xy);

        // light vector
        float3 lightVec = EXPAND(IN.Color1.xyz);
        float fDif = saturate(dot(bumpNormal.xyz, lightVec));
        float3 dif = (fDif * Diffuse.xyz);
        float3 color = Ambient.xyz * (IN.Color.xyz + dif.xyz) * decalColor.xyz;
        color.xyz = HDREncode(color.xyz);

        float fog = fogColor.a * fogEnterColor.a;
        color.xyz = HDREncodeAmb(FogColor.xyz)*fog + color.xyz*(1-fog);
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = decalColor.a * Ambient.a * IN.Color.a;
      }
      
////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCPlants_FV.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D fogMap : texunit1,
                  uniform sampler2D fogEnterMap : texunit2,
                  uniform float4 Ambient,
                  uniform float4 FogColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex1.xy);
        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex2.xy);

        float4 color = decalColor * Ambient;
        float fog = fogColor.a * fogEnterColor.a;
        color.xyz = color.xyz * IN.Color.xyz;
        color.xyz = HDREncodeAmb(FogColor.xyz)*fog + HDREncode(color.xyz)*(1-fog);
        color.xyz = color.xyz;
        color.a = color.a * IN.Color.a;
        OUT.Color = color;
      }
      
