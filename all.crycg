        float2 vHighUv=IN.Tex0.xy+vPixelSize.zw*(vTaps[t].xy);                
        float4 tapHigh= tex2D(ScreenMap, vHighUv.xy);
                
        float4 tap=(tapLow*tapHigh.w+tapHigh*(1.0-tapHigh.w));        
        tap.w=(tapHigh.w-tapCenter.w>=0)? 1.0: tap.w;
        
        vFinalColor.xyz+=tap.xyz*tap.w;
        vFinalColor.w+=tap.w;
    }
    // normalize color
    vFinalColor/=vFinalColor.w;*/
    
    float tapLerp=tapCenter.w*0.5+tapBlured.w*0.5;        
    float3 vFinalColor=tapBlured.xyz*tapCenter.w+tapCenter.xyz*(1-tapCenter.w);
    
