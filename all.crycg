#include "../CGVPMacro.csi"

PS20Only
NoFog

MainInput 
{
	uniform sampler2D ScreenMap : texunit0,
	uniform float4    DofFocalParams
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
      OUT_C0
    };

    FOUT
}

CoreScript
{
	float4 vScrColor = tex2D(ScreenMap, IN.Tex0.xy);

	// get max scale
	const float fDistanceScale=1.0/2048.0;
	
	float fFocus=saturate(DofFocalParams.x*fDistanceScale);
	float fRange=1/(DofFocalParams.y*fDistanceScale);
		
	// compute pixel depth
	float fDepth=saturate(fDistanceScale*IN.Tex1.w);
	// compute pixel focal distance
	float fFocalDist=saturate(fRange*abs(fFocus-fDepth));	
	
    OUT.Color.xyz =fFocalDist;
    //OUT.Color.xyz = IN.Tex1.w; //IN.Color.w; //vScrColor.xyz;
    OUT.Color.a = vScrColor.w;
}
// ===============================================================
// Fragment Program: Eye shader
// Description: used in character eyes
// Last Update: 15/20/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
  uniform sampler2D baseMap : texunit0,
  uniform sampler2D opacityMap : texunit1,
  uniform sampler2D reflMap : texunit2,
  uniform float4 Ambient
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
    OUT_C0
  };

  FOUT
}

CoreScript
{
  // load the decal
  float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
  float4 opColor = tex2D(opacityMap, IN.Tex1.xy);
  float4 reflColor = tex2D(reflMap, IN.Tex2.xy);
  
  float3 vFinalRefl=reflColor.xyz*opColor.xyz;
//  vFinalRefl*=vFinalRefl;
  float3 vFinalDecal=saturate(decalColor.xyz+vFinalRefl.xyz);//-decalColor.xyz*vFinalRefl.xyz);
  //vFinalDecal*=vFinalDecal;
    
  float3 vFinal=2*vFinalDecal.xyz*IN.Color.xyz+vFinalDecal.xyz*Ambient.xyz;
 
  OUT.Color.xyz = vFinal;
  OUT.Color.w = 1.0;
}// ===============================================================
// Fragment Program: Fire
// Description: used in fire volumes
// Last Update: 17/11/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1,                        
            uniform float4 Matrix
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
  };

  FOUT
}

CoreScript
{  
  // load the decal  
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);      

# ifdef _PS_1_1
  float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);          // get env bump map surface
# else
        float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
        float4 refrColor = tex2D(refMap, newst);
# endif                
    
  //float3 fColorSquare=refrColor.xyz*refrColor.xyz; 
  //float fColorLum=dot(refrColor.xyz, float3(0.33, 0.59, 0.11)); 

  OUT.Color.xyz =refrColor.xyz*refrColor.w*IN.Color.w;
  OUT.Color.w = 1;
}////////////////////////////////////////////////////////////////////////////
