      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      //NoFog      
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1_2
          OUT_T2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        float4 shadTC0 = mul(TexGen0, vPos);
        OUT.Tex0 = shadTC0;
        OUT.Tex1.xy = IN.TexCoord0.xy;
#ifdef D3D
        float4 WTC = (float4)0;
        WTC.w = 1;
        WTC.z = shadTC0.w * 0.5 + 0.5;
        OUT.Tex2 = WTC;
#endif       
      }
