      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TNORMAL_3 }
      MainInput { VIEWPROJ_MATRIX, CAMERA_POS, uniform float4x4 TexMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        float3 tCamVec = normalize(CameraPos.xyz - vPos.xyz);
        float3 tNormal = IN.TNormal.xyz;
        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;
        //float3 tRef = reflect(tCamVec, tNormal.xyz);
        float4 tRM;
        tRM.xyz = tRef.xyz;
        tRM.w = vPos.w;
        OUT.Tex0 = mul(tRM, TexMatrix);
      }
    // ===============================================================
// Vertex Program: 
// Description: 
// Last Update: 14/08/2003
// Coder: Andrey Honich
// ===============================================================

      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, LIGHT_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        // Ambient color
        float3 cAmbient = float3(0.2, 0.2, 0.2);
        // Diffuse color
        float3 cDiffuse = float3(1, 0.8, 0.2);
        
        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);
        float fDiffuse = dot(vLightDir, IN.Normal);
        OUT.Color.xyz = cDiffuse * fDiffuse + cAmbient;
        OUT.Color.w = 1;
        OUT.Tex0 = IN.TexCoord;
      }
    