// This include is required for all vertex/fragment programs. Contains shared stuff.
#include "../CGVPMacro.csi"

// Fragment program inputs. Can be texture samplers and constants
MainInput 
{
    uniform sampler2D BumpMap : texunit0    
}

// Fragment program inputs declaration. Where data comes from, vertex texture coordinates, vertex colors, etc.
DeclarationsScript
{
  struct vertout
  {
    OUT_T0    
  };

  FOUT
}

// This is where main CG/HLSL fragment program code goes
CoreScript
{
    float4 vBumpColor = tex2D(BumpMap, IN.Tex0.xy);
    
    OUT.Color.xyz = vBumpColor.xyz;
    OUT.Color.a = 1;
}
      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform sampler2D bumpMap : register(s1),
                  uniform samplerCUBE envMap : register(s2),
                  uniform float4 Diffuse,
                  uniform float4 Specular,
                  uniform float4 Params,
                  uniform float4 SparkleDistort,
                  uniform float4 SparkleColor,
                  uniform float4 BaseColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
          OUT_T5
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        float3 bumpNormal = EXPAND(tex2D(bumpMap, IN.Tex1.xy).xyz);
        
        // Increase the microflake perturbed normal a bit
        //bumpNormal.xyz = lerp(float3(0,0,1), bumpNormal.xyz, Params.x);
        bumpNormal.xyz = normalize(bumpNormal.xyz);
        
        float3x3 worldTangentSpace;
        worldTangentSpace[0] = IN.Tex2.xyz;
        worldTangentSpace[1] = IN.Tex3.xyz;
        worldTangentSpace[2] = IN.Tex4.xyz;
        
        float3 viewVec = normalize(IN.Tex5.xyz);
        float NdotE = dot(bumpNormal.xyz, viewVec);
        float3 reflectVect = (2.0*NdotE*bumpNormal.xyz)-(dot(bumpNormal.xyz, bumpNormal.xyz)*viewVec.xyz);
        float3 worldReflectVec = mul(reflectVect, worldTangentSpace);
        // load the env noise map
        float4 envColorNoise = texCUBE(envMap, worldReflectVec.xyz);
        envColorNoise.xyz = HDREncode(envColorNoise.xyz * envColorNoise.a) * 2;
        
        // load the env bumbed map
        float3 bumpNormalEnv = float3(0,0,1);
        float NdotEEnv = dot(bumpNormalEnv.xyz, viewVec);
        float3 reflectVectEnv = (2.0*NdotEEnv*bumpNormalEnv.xyz)-(dot(bumpNormalEnv.xyz, bumpNormalEnv.xyz)*viewVec.xyz);
        float3 worldReflectVecEnv = mul(reflectVectEnv, worldTangentSpace);
        float4 envColor = texCUBE(envMap, worldReflectVecEnv.xyz);
        envColor.xyz = HDREncode(envColor.xyz * envColor.a);
                
        // load the bump normal
        float4 bumpNormal2 = tex2D(bumpMap, IN.Tex1.xy);
        
        // Compute (1-N.V)^2
        float fAtten = ((1-viewVec.z) * (1-viewVec.z)) + 0.255;
        // Simulate color scattering
        float3 scatt = lerp(viewVec.z, NdotE, SparkleDistort.xyz);
        // Combine resulting color with base color
        float3 color = HDREncodeAmb(scatt * BaseColor.xyz);
        // Combine sparkles with base color gradient
        color.xyz = bumpNormal2.xyz * envColorNoise.xyz * envColor.xyz + color.xyz; 
        // Add reflections from the environment map
        color.xyz = lerp(color.xyz, envColor.xyz, fAtten);
        
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = envColorNoise.a * SparkleColor.a * BaseColor.a;
      }

// ===============================================================
// Fragment Program: Motion
// Description: Used in motion blur fx's
// Last Update: 01/05/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput
{
#ifdef OPENGL
  uniform samplerRECT baseMap0 : texunit0,
  uniform samplerRECT baseMap1 : texunit1,
  uniform samplerRECT baseMap2 : texunit2,
  uniform samplerRECT baseMap3 : texunit3,
#endif  
#ifdef D3D
  uniform sampler2D baseMap0 : texunit0,
  uniform sampler2D baseMap1 : texunit1,
  uniform sampler2D baseMap2 : texunit2,
  uniform sampler2D baseMap3 : texunit3,
#endif  
  uniform float4 fMotionParams
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
    OUT_T3
  };

  FOUT
}

CoreScript
{
  // load the decal
#ifdef OPENGL
  float4 mColor0 = texRECT(baseMap0, IN.Tex0.xy);
  float4 mColor1 = texRECT(baseMap1, IN.Tex1.xy);
  float4 mColor2 = texRECT(baseMap2, IN.Tex2.xy);
  float4 mColor3 = texRECT(baseMap3, IN.Tex3.xy);
#endif
#ifdef D3D
  float4 mColor0 = tex2D(baseMap0, IN.Tex0.xy);
  float4 mColor1 = tex2D(baseMap1, IN.Tex1.xy);
  float4 mColor2 = tex2D(baseMap2, IN.Tex2.xy);
  float4 mColor3 = tex2D(baseMap3, IN.Tex3.xy);
#endif
  
  float4 col = mColor3*0.25;
  col = mColor2*0.25+col;
  col = mColor1*0.25+col;
  col = mColor0*0.25+col;
  
  OUT.Color.xyz = col.xyz;
  OUT.Color.w = fMotionParams.w;
}


// ===============================================================
// Fragment Program: Motion Amount
// Description: used for gl motion blur...
// Last Update: 16/09/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
#ifdef OPENGL
	uniform samplerRECT CurrScreen : texunit0,
	uniform samplerRECT LastScreen : texunit1,	
#endif	
#ifdef D3D
	uniform sampler2D CurrScreen : texunit0,
	uniform sampler2D LastScreen : texunit1,	
#endif	
	uniform float4 vMotionParams
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	};

	FOUT
}

CoreScript
{
	// load the decal
#ifdef OPENGL
	float4 fCurrColor = texRECT(CurrScreen , IN.Tex0.xy);
	float4 fColor = texRECT(LastScreen, IN.Tex1.xy);
#endif			
#ifdef D3D
	float4 fCurrColor = tex2D(CurrScreen , IN.Tex0.xy);
	float4 fColor = tex2D(LastScreen, IN.Tex1.xy);
#endif			
	// interpolate between previous and current screen
	float3 fFinal = lerp(fColor.xyz, fCurrColor.xyz, vMotionParams.w);	
		
	OUT.Color.xyz = fFinal;
	OUT.Color.a = 1;	
}

