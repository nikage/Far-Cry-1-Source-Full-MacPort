        float NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));
        float3 dif = (decalColor.xyz * NdotL * atten * Diffuse.xyz) * 2;
        float3 amb = IN.Color1.xyz * decalColor.xyz;

