      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform sampler2D bumpMap : register(s1),
                  uniform sampler2D attenMap : register(s2),
                  uniform samplerCUBE envMap : register(s3),
                  uniform float4 Ambient,
                  uniform float4 Diffuse,
                  uniform float4 Specular,
                  uniform float4 EnvMapParams,
                  uniform float4 FresnelParams }
      DeclarationsScript
      {
