      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Flare }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 flareColor = tex2D(baseMap, IN.Tex0.xy);

        float3 color = flareColor.xyz * Flare.xyz * IN.Color.xyz;
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = flareColor.a;
      }

// ===============================================================
// Fragment Program: FlashBang
// Description: Flashbang fx
// Last Update: 24/04/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{
#ifdef OPENGL
    uniform samplerRECT baseMap : texunit0,
    uniform samplerRECT flashMap : texunit1,
#endif    
#ifdef D3D
    uniform sampler2D baseMap : texunit0,
    uniform sampler2D flashMap : texunit1,
#endif    
    uniform float4 FlashBang 
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
    };

    FOUT
}

CoreScript
{
    // load the decal
#ifdef OPENGL
    float4 screenColor = texRECT(baseMap, IN.Tex0.xy);
    float4 flashColor = texRECT(flashMap, IN.Tex1.xy);
#endif    
#ifdef D3D
    float4 screenColor = tex2D(baseMap, IN.Tex0.xy);
    float4 flashColor = tex2D(flashMap, IN.Tex1.xy);
#endif    

    float3 color = (flashColor.xyz * 4) + FlashBang.w;
    
    //OUT.Color.xyz = lerp(screenColor.xyz, color.xyz, FlashBang.w);
    OUT.Color.xyz = screenColor.xyz*(1-FlashBang.w)+ color.xyz*FlashBang.w;
    
    OUT.Color.a = 1; //saturate(1-FlashBang.w)*0.75;
}
      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D fogEnterMap : texunit0,
                  uniform sampler2D fogMap : texunit1,
                  uniform float4 FogColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex1.xy);
        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex0.xy);

        float4 color = fogColor * fogEnterColor;
        color.xyz = color.xyz * HDREncodeAmb(FogColor.xyz);
        OUT.Color = color;
      }

      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D fogMap : texunit0,
                  uniform float4 FogColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex0.xy);

        OUT.Color.xyz = HDREncodeAmb(FogColor.xyz);
        OUT.Color.a = fogColor.a;
      }

      #include "../CGVPMacro.csi"

      NoFog
      AutoEnumTC

      MainInput { uniform sampler2D furNormalMap : register(sn),
                  uniform sampler3D furLightMap  : register(sn),
                  uniform sampler2D furMap       : register(sn),
                  uniform float4 FurColor,
                  uniform float4 LightColor }
      DeclarationsScript
      {
        // define outputs from vertex shader
        struct vertout
        {
          float4 HPosition  : POSITION;
          float4 Tex0       : TEXCOORDN;
          float4 Tex1       : TEXCOORDN;
          float4 Tex2       : TEXCOORDN;
          float4 Tex3       : TEXCOORDN;
          float4 Tex4       : TEXCOORDN;
        };

        FOUT
      }
      CoreScript
      {
        // load the normal
        float4 vNormal = tex2D(furNormalMap, IN.Tex0.xy)*2-1;
        
        float3 tcLight;
        tcLight.x = dot(IN.Tex1.xyz, vNormal.xyz);
        tcLight.y = dot(IN.Tex2.xyz, vNormal.xyz);
        tcLight.z = IN.Tex1.z * 0.5 + 0.5;
        
        float fFurOffs = vNormal.x*vNormal.x + vNormal.y*vNormal.y + 1;
        float2 tcFur = vNormal.xy * fFurOffs * IN.Tex4.xy + IN.Tex3.xy;
        
        float4 vLight = tex3D(furLightMap, tcLight.xyz);
        float4 vFur = tex2D(furMap, tcFur.xy);
        vFur.xyz = vFur.xyz * FurColor.xyz;

        float3 dif = HDREncodeAmb(vFur.xyz * vLight.xyz);
        float3 spec = HDREncodeAmb(vLight.a * vFur.xyz * LightColor.xyz);
      
        OUT.Color.xyz = dif + spec;
        OUT.Color.w = vFur.a * FurColor.a;
      }

      #include "../CGVPMacro.csi"

      NoFog
      PS20Only

      MainInput { uniform sampler2D offsMap : register(s0),
                  uniform sampler2D normMap : register(s1) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        // load the offset
        float4 vOffs = tex2D(offsMap, IN.Tex0.xy);
        float4 vNorm = tex2D(normMap, vOffs.xy);
        
        OUT.Color = vNorm;
      }

      #include "../CGVPMacro.csi"

      NoFog
      PS20Only

      MainInput { uniform sampler2D offsMap : register(s0),
                  uniform sampler2D clampMap : register(s1) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
        };

        FOUT
      }
      CoreScript
      {
        // load the offset
        float4 vOffs = tex2D(offsMap, IN.Tex0.xy);
        
        float2 vForce = IN.Tex1.xy*0.5+0.5;
        float2 offs = IN.Tex2.x*vForce.xy + (1-IN.Tex2.x)*vOffs.xy;

        float4 vClamp = tex2D(clampMap, offs.xy);
        
        OUT.Color = vClamp;
      }

// ===============================================================
// Fragment Program: geometric refraction
// Description: used for arbytraty geometry refraction
// Last Update: 28/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit1, 
            //uniform sampler2D refMap : texunit1,
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit1,
#endif
            uniform sampler2D maskMap : texunit2,            
            uniform float4 Matrix,
            uniform float4 Amount,
            uniform float4 RefrColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
  };

  FOUT
}

CoreScript
{
  // load the decal  
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
  float4 maskColor = tex2D(maskMap, IN.Tex2.xy);
              
// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...
#ifdef D3D
  # ifdef _PS_1_1
    float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);                 // get env bump map   
  # else
    float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = tex2D(refMap, newst);
  # endif                
#endif

#ifdef OPENGL
      //float4 refrColor = tex2D(refMap, IN.Tex1.xy);
      float4 refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);                 // get env bump map   
#endif           

              
  OUT.Color.xyz = refrColor.xyz*RefrColor.xyz;
  OUT.Color.w= maskColor.w;  
}// ===============================================================
// Fragment Program: Glare
// Description: glare/contrast/saturation adjustment
// Last Update: 09/10/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{ 
#ifdef OPENGL
    uniform samplerRECT ScreenTex : texunit0,
    uniform samplerRECT GlareTex : texunit1,
#endif
#ifdef D3D
    uniform sampler2D ScreenTex : texunit0,
    uniform sampler2D GlareTex : texunit1,
#endif
    uniform float4    vSaturationAmount,
    uniform float4    vConstrastAmount,
    uniform float4    vConstrastAmount02
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
    };

    FOUT
}

CoreScript
{         
#ifdef OPENGL
    // get screen
    float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);
    // get glare map
    float4 fGlareColor  = texRECT(GlareTex, IN.Tex1.xy);
#endif
#ifdef D3D
    // get screen
    float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);
    // get glare map
    float4 fGlareColor  = tex2D(GlareTex, IN.Tex1.xy);
#endif
    
    // ## Add glare to scene ##    
    float3 vFinalGlareColor=saturate(fGlareColor.xyz+fScreenColor.xyz);
    float3 vLum=dot(fScreenColor.xyz, float3(0.3, 0.59, 0.11));        
    float3 vFinalComposing=saturate(fScreenColor.xyz*(1-vLum.z) + vFinalGlareColor.xyz*vLum.z );
            
    // ## adjust scene saturation ##
    //float3 vSceneLuminosity = saturate(dot(float3(0.33, 0.59, 0.11), vFinalComposing.xyz));        
    float3 vSaturationAdjust=saturate(vFinalComposing.xyz*(1-vSaturationAmount.w) + vLum.xyz*vSaturationAmount.w );
                
    // ## adjust scene contrast ##  Optimization: Not used anymore                    
    //float  fContrastLerp=saturate(fGlareColor.w*vConstrastAmount.w+vConstrastAmount02.w);    
    //float3 vConstrastAdjust=saturate(lerp( 2*(vSaturationAdjust.xyz-0.5), vSaturationAdjust.xyz, fContrastLerp));
                                                
    OUT.Color.xyz =vSaturationAdjust;
    OUT.Color.w=1;
}


// ===============================================================
// Fragment Program: GlareAmount
// Description: Screen glare amount
// Last Update: 09/08/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{ 
#ifdef OPENGL
  uniform samplerRECT texScreen01 : texunit0,
	uniform samplerRECT texScreen02 : texunit1,
	uniform samplerRECT texScreen03 : texunit2,
	uniform samplerRECT texScreen04 : texunit3,		
#endif
#ifdef D3D
  uniform sampler2D texScreen01 : texunit0,
	uniform sampler2D texScreen02 : texunit1,
	uniform sampler2D texScreen03 : texunit2,
	uniform sampler2D texScreen04 : texunit3,		
#endif
	
	uniform float4 Glare 
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	  OUT_T2
	  OUT_T3
	};

	FOUT
}

CoreScript
{	
#ifdef OPENGL
	float4 vColor01 = texRECT(texScreen01 , IN.Tex0.xy);
	float4 vColor02 = texRECT(texScreen02 , IN.Tex1.xy);
	float4 vColor03 = texRECT(texScreen03 , IN.Tex2.xy);
	float4 vColor04 = texRECT(texScreen04 , IN.Tex3.xy);
#endif
#ifdef D3D
	float4 vColor01 = tex2D(texScreen01 , IN.Tex0.xy);
	float4 vColor02 = tex2D(texScreen02 , IN.Tex1.xy);
	float4 vColor03 = tex2D(texScreen03 , IN.Tex2.xy);
	float4 vColor04 = tex2D(texScreen04 , IN.Tex3.xy);
#endif
	
	float3 vAvgColor=saturate(saturate(vColor01.xyz*0.25+vColor02.xyz*0.25+vColor03.xyz*0.25+vColor04.xyz*0.25)); //*0.8+0.2);
	vAvgColor=saturate(4*vAvgColor*vAvgColor);
	float fAvgLum=dot(float3(0.3, 0.59, 0.11), vAvgColor.xyz);
		
	// only output luminosity
	OUT.Color.xyz = fAvgLum; //saturate(2*fAvgLum*fAvgLum);
	OUT.Color.w = Glare.w;
}

// ==============================================================================
// Fragment Program: Glare Map
// Description: used in glare map generation, mask's out low luminosity fragments
// Last Update: 09/08/2003
// Coder: Tiago Sousa
// ==============================================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
#ifdef OPENGL
	uniform samplerRECT baseMap : texunit0,
	uniform samplerRECT glareAmountMap : texunit1,
#endif
#ifdef D3D
	uniform sampler2D baseMap : texunit0,
	uniform sampler2D glareAmountMap : texunit1,
#endif
	uniform float4 vGlare,
	uniform float4 vGlareAmount
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	};

	FOUT
}

CoreScript
{
#ifdef OPENGL
	// load the decal
	float4 glareColor = texRECT(baseMap, IN.Tex0.xy);
	float4 glareAmount= texRECT(glareAmountMap, IN.Tex1.xy);
#endif
#ifdef D3D
	// load the decal
	float4 glareColor = tex2D(baseMap, IN.Tex0.xy);
	float4 glareAmount= tex2D(glareAmountMap, IN.Tex1.xy);
#endif

	     
	// remove dark pixels, leave brightest ones (color-threshold)*MaxAmount
	// BTW: i've add to negate vGlare.xyz values from CPP code, since CG generates really wrong instruction on this..
  float3 fGlareMap=saturate(glareColor.xyz+vGlare.xyz)*vGlare.w;
  fGlareMap*=2*fGlareMap;  
    
	
	OUT.Color.xyz = fGlareMap*saturate((1-glareAmount.xyz)+vGlareAmount.xyz); 
	OUT.Color.a = glareAmount.z;
}


