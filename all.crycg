      #include "../CGVPMacro.csi"

      AutoEnumTC
      
      MainInput
      {
        uniform sampler2D baseMap : register(sn),
#if %BUMP_MAP
        uniform sampler2D bumpMap : register(sn),
  #if %BUMP_DIFFUSE && %DIFFUSE
        uniform sampler2D bumpMapDiffuse : register(sn),
  #endif
#endif

#if %DIFFUSE
  #if %DIFFUSE_NCM && !%DIFFUSE_PERPIXEL
        uniform samplerCUBE normCubeMapLV : register(sn),
  #endif
#else        
  #if %DIFFUSE_NCM && %SPECULAR_PERPIXEL
        uniform samplerCUBE normCubeMapLV : register(sn),
  #endif
#endif

#if %SPECULAR
  #if %SPECULAR_NCM || %VIEWVEC_NCM
        uniform samplerCUBE normCubeMapHA : register(sn),
  #endif
#endif

#if %TEMP_POINTLIGHT
        uniform sampler2D attenMap : register(sn),
#elif %TEMP_PROJLIGHT
        uniform samplerCUBE projMap : register(sn),
  #if %PROJLIGHT_PERPIXELATTEN        
        uniform sampler2D attenMap : register(sn),
  #endif        
#endif        

#if %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        uniform sampler2D glossMap : register(sn),
#elif %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        uniform sampler2D glossMap : register(sn),
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        uniform sampler2D glossMap : register(sn),
  #endif
#endif        

#if %TEMP_SPECULAR_OCCLUSIONMAP && !%DIFFUSE
        uniform sampler2D occlusionMap : register(sn),
#endif

#if %TEMP_AMBIENT
        uniform float4 Ambient,
  #if %ENVCMAMB
        uniform samplerCUBE envMap : register(sn),
        uniform float4 Reflect,
  #elif %ENVCMSPEC
        uniform samplerCUBE envMap : register(sn),
        uniform float4 EnvMapParams,
        uniform float4 FresnelParams,
  #endif
#endif

# ifdef _3DC_A
        uniform sampler2D bumpHeight : register(sn),
# endif
# ifdef _SPEC_ANTIALIAS
        uniform sampler2D specularMap : register(sn),
# endif

#if %DIFFUSE
        uniform float4 Diffuse,
#endif

#if %SPECULAR
        uniform float4 Specular,
#endif

#if %OFFSETBUMPMAPPING
        uniform float4 BumpOffset,
#endif
#if %TEMP_SPECULAR_OCCLUSIONMAP && !%DIFFUSE
        uniform float4 OcclusionMask,
#endif
      }

      DeclarationsScript
      {
        struct vertout
        {
          float4 HPosition  : POSITION;
          float4 baseTC     : TEXCOORDN;
#if %BUMP_MAP          
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
          float4 bumpTC     : TEXCOORDN;
  #endif
#endif
  
#if %DIFFUSE_NCM
          float4 lightVec   : TEXCOORDN;
#endif
          
#if %SPECULAR
   #if %SPECULAR_NCM
          float4 halfAngVec : TEXCOORDN;
   #endif
#endif   

#if %TEMP_POINTLIGHT
          float4 attenTC    : TEXCOORDN;
#elif %TEMP_PROJLIGHT
          float4 projTC     : TEXCOORDN;
  #if %PROJLIGHT_PERPIXELATTEN
          float4 attenTC    : TEXCOORDN;
  #endif
#endif

#if %TEMP_POINTLIGHT || %TEMP_PROJLIGHT
          float4 Color      : COLOR0;
#elif %DIFFUSE && !%DIFFUSE_NCM
          float4 Color      : COLOR0;
#endif

          float4 Color1     : COLOR1;

#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
          float4 glossTC    : TEXCOORDN;
#elif !%TEMP_AMBIENT || !%ENVCMSPEC
  #if %SPECULAR
    #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
          float4 glossTC    : TEXCOORDN;
    #endif
  #endif
#endif          

#if %TEMP_SPECULAR_OCCLUSIONMAP && !%DIFFUSE
          float4 lmTC_ZW    : TEXCOORDN;
#elif %BUMP_ZCORRECT
          float4 lmTC_ZW    : TEXCOORDN;
#endif

#if %TEMP_AMBIENT
  #if %ENVCMAMB
          float4 envTC      : TEXCOORDN;
  #elif %ENVCMSPEC
    #if !%SPECULAR || !%SPECULAR_PERPIXEL
          float4 viewVec    : TEXCOORDN;
    #endif
          float4 tangVec    : TEXCOORDN;
          float4 binormVec  : TEXCOORDN;
          float4 normVec    : TEXCOORDN;
  #endif
#endif

#if !%DIFFUSE_NCM
  #if %DIFFUSE_PERPIXEL
          float4 lightVec : TEXCOORDN;
  #elif %SPECULAR_PERPIXEL
          float4 lightVec : TEXCOORDN;
  #endif
#endif
          
#if %SPECULAR && %SPECULAR_PERPIXEL
          float4 viewVec : TEXCOORDN;
#elif %TEMP_AMBIENT && %ENVCMSPEC
#elif %OFFSETBUMPMAPPING && %BUMP_MAP
          float4 viewVec    : TEXCOORDN;
#endif
        };

# ifdef _HDR_MRT
        FOUT_2
# else
  #if %BUMP_ZCORRECT
        FOUT_DEPTH
  #else
        FOUT
  #endif
# endif

      }
      CoreScript
      {        
        float2 baseTC = IN.baseTC.xy;
        float2 bumpTC = baseTC;
#if %BUMP_MAP
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
        bumpTC = IN.bumpTC.xy;
  #endif
#endif

        float2 glossTC = baseTC;
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        glossTC = IN.glossTC.xy;
#elif !%TEMP_AMBIENT || !%ENVCMSPEC
  #if %SPECULAR
    #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        glossTC = IN.glossTC.xy;
    #endif
  #endif
#endif

        FLOAT fHeight = 0;
#if %OFFSETBUMPMAPPING && %BUMP_MAP
  # ifdef _3DC_A
        fHeight = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        fHeight = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        fHeight *= BumpOffset.x;
        FLOAT3 viewVec = normalize(IN.viewVec.xyz);
        baseTC = baseTC + viewVec.xy * fHeight;
        bumpTC = bumpTC + viewVec.xy * fHeight;
        glossTC = glossTC + viewVec.xy * fHeight;
#endif

        // load the diffuse texture
        FLOAT4 decalColor = tex2D(baseMap, baseTC.xy);
        FLOAT fAlpha = decalColor.a;

#if %TEMP_SPECULAR_OCCLUSIONMAP && !%DIFFUSE
        FLOAT4 occColor = tex2D(occlusionMap, IN.lmTC_ZW.xy);
        FLOAT fOccl = dot(occColor, OcclusionMask);
#endif

#if %BUMP_MAP
        // load the bump normal
        FLOAT3 bumpNormal = GetNormalMap(bumpMap, bumpTC.xy);
        FLOAT3 Na = bumpNormal;
  #if %BUMP_DIFFUSE && %DIFFUSE
        FLOAT3 bumpNormalDiffuse = GetNormalMap(bumpMapDiffuse, bumpTC.xy);
  #endif

  #if %BUMP_NORMALIZE
    # if !defined (_3DC) && !defined (_V8U8) && !defined (_Cx_V8U8)
        // normalize post-filtered bump normals
        bumpNormal.xyz = normalize(bumpNormal.xyz);
    # endif
  #endif
#else        
        FLOAT3 bumpNormal = float3(0,0,1);
        FLOAT3 bumpNormalDiffuse = float3(0,0,1);
#endif

#if %BUMP_ZCORRECT
// Calculate depth bias.
  # ifdef _3DC_A
        FLOAT height = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        FLOAT height = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        FLOAT fZ = DepthBias(height, bumpNormal, viewVec, IN.lmTC_ZW.zw);
#else
        FLOAT fZ = 1;
#endif

        // load the gloss
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
  #endif
#elif %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
#endif
  
        // Calculate attenuation
        FLOAT atten = 1;
#if %TEMP_POINTLIGHT
        atten = saturate(EXPAND(IN.Color.a) * -EXPAND(IN.Color.a) + (1-tex2D(attenMap, IN.attenTC.xy).b));
#elif %TEMP_PROJLIGHT
        FLOAT4 projColor = texCUBE(projMap, IN.projTC.xyz);
   #if %PROJLIGHT_PERPIXELATTEN
        atten = saturate(EXPAND(IN.Color.a) * -EXPAND(IN.Color.a) + (1-tex2D(attenMap, IN.attenTC.xy).b));
   #else
        atten = saturate(IN.Color.a);
   #endif
#endif
        // For some reason multiplying on very small 
        // attenuation cause specular negative lighting on NV40 hardware
# ifdef _HDR
          atten = max(atten, 0.00001);
# endif
        
        // Calculate diffuse contribution
#if %DIFFUSE
  #if %DIFFUSE_PERPIXEL
        FLOAT3 lVec = normalize(IN.lightVec.xyz);
  #elif %DIFFUSE_NCM
        // Light vector from normalization cube-map
        FLOAT3 lVec = EXPAND(texCUBE(normCubeMapLV, IN.lightVec.xyz).xyz);
  #else
        FLOAT3 lVec = EXPAND(IN.Color.xyz);
  #endif        
    #if %BUMP_DIFFUSE
        FLOAT NdotL = saturate(dot(lVec.xyz, bumpNormalDiffuse.xyz));
    #else
        FLOAT NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));
    #endif
        FLOAT3 dif = decalColor.xyz * NdotL * Diffuse.xyz;
  #if %TEMP_POINTLIGHT
        dif = dif * atten;
  #elif %TEMP_PROJLIGHT
        dif = dif * atten * projColor.xyz;
  #endif
        dif.xyz = HDREncode(dif);  
#else
        FLOAT3 dif = float3(0,0,0);
#endif

#if %VERTCOLORS
        dif *= IN.Color1.w;
#endif
        

        // Calculate specular contribution
#if %SPECULAR
  #if %SPECULAR_PERPIXEL
    #if !%OFFSETBUMPMAPPING
      #if %VIEWVEC_NCM
        FLOAT3 viewVec = EXPAND(texCUBE(normCubeMapHA, IN.viewVec.xyz).xyz);
      #else
        FLOAT3 viewVec = normalize(IN.viewVec.xyz);
      #endif
    #endif        
  #elif %SPECULAR_NCM
        // Half angle vector from normalization cube-map
        FLOAT3 hVec = EXPAND(texCUBE(normCubeMapHA, IN.halfAngVec.xyz).xyz);
  #else
        FLOAT3 hVec = EXPAND(IN.Color1.xyz);
  #endif        
  #if %SPECULAR_PERPIXEL
    #if !%DIFFUSE
      #if %DIFFUSE_NCM
        FLOAT3 lVec = EXPAND(texCUBE(normCubeMapLV, IN.lightVec.xyz).xyz);
      #else
        FLOAT3 lVec = normalize(IN.lightVec.xyz);
      #endif
    #endif
    # ifdef _SPEC_ANTIALIAS
        FLOAT3 Hn = normalize(viewVec.xyz + lVec.xyz);
        FLOAT NaH = dot(Hn , Na);
	      FLOAT NaNa = dot(Na , Na);
    	  FLOAT specVal = tex2D(specularMap, float2(NaH,NaNa)).x;
    # else
        FLOAT3 reflVec = (2*dot(lVec.xyz, bumpNormal.xyz)*bumpNormal.xyz)-lVec.xyz;
        FLOAT NdotR = saturate(dot(reflVec.xyz, viewVec.xyz));
        FLOAT fPow = Specular.w;
      #if %SPECULARPOW_GLOSSALPHA
        fPow *= glossColor.a;
      #endif
        FLOAT specVal = pow(NdotR, fPow);
    # endif
  #else        
        FLOAT NdotH = saturate(dot(hVec.xyz, bumpNormal.xyz));
        FLOAT  specVal = saturate((NdotH - 0.75)*4);
        specVal = specVal * specVal;
  #endif        
        FLOAT3 spec = specVal * Specular.xyz;
  #if %TEMP_SPECULAR_OCCLUSIONMAP && !%DIFFUSE
        spec *= fOccl;
  #endif
                
  #if %TEMP_POINTLIGHT
        spec = spec * atten;
  #elif %TEMP_PROJLIGHT
        spec = spec * atten * projColor.xyz;
  #endif
  #if %GLOSS_MAP
        spec *= glossColor.xyz;
  #elif %GLOSS_DIFFUSEALPHA
        spec *= fAlpha;
  #endif
        spec = HDREncode(spec);
#else
        FLOAT3 spec = float3(0,0,0);
#endif

#if %VERTCOLORS
        spec *= IN.Color1.w;
#endif

        // Calculate ambient and environment contribution
#if %TEMP_AMBIENT
  #if %ENVCMAMB
        // load the environment map
        FLOAT4 envColor = texCUBE(envMap, IN.envTC.xyz);
        FLOAT fLerp = Reflect.a;
    #if %ENVCM_MASKED
        // load the gloss
        fLerp *= glossColor.a;
    #endif
        FLOAT3 amb = lerp(decalColor.xyz*Ambient.xyz, envColor.xyz, fLerp);
        FLOAT3 env = float3(0,0,0);
  #elif %ENVCMSPEC        
        FLOAT fEnvmapAmount = EnvMapParams.x;

        float fFresnelScale = FresnelParams.x;
        float fFresnelBias = FresnelParams.y;
        float fFresnelPow = FresnelParams.z;

        // Calc Reflection Vector
        float3x3 worldTangentSpace;
        worldTangentSpace[0] = IN.tangVec.xyz;
        worldTangentSpace[1] = IN.binormVec.xyz;
        worldTangentSpace[2] = IN.normVec.xyz;

    #if !%SPECULAR || !%SPECULAR_PERPIXEL
      #if !%OFFSETBUMPMAPPING
        float3 viewVec = normalize(IN.viewVec.xyz);
      #endif
    #endif        
        float NdotE = dot(bumpNormal.xyz, viewVec);
        float3 reflectVect = (2.0*NdotE*bumpNormal.xyz)-(dot(bumpNormal.xyz, bumpNormal.xyz)*viewVec);
        float3 worldReflectVec = mul(reflectVect, worldTangentSpace);

        // Calc Fresnel factor
        FLOAT fresnel = fFresnelBias + (pow((1-NdotE), fFresnelPow) * fFresnelScale);

        // Calc environment
        FLOAT3 env = texCUBE(envMap, worldReflectVec).xyz * fEnvmapAmount;
        env *= fresnel;
     #if %GLOSS_MAP
        env *= glossColor.xyz;
     #elif %GLOSS_DIFFUSEALPHA
        env *= fAlpha;
     #endif
        FLOAT3 amb = Ambient.xyz * decalColor.xyz;
  #else
        FLOAT3 amb = Ambient.xyz * decalColor.xyz;
        FLOAT3 env  = float3(0,0,0);
  #endif
  #if %ALPHAGLOW
        amb += fAlpha * decalColor.xyz;
  #endif
        amb = HDREncodeAmb(amb);
#else
        FLOAT3 amb = float3(0,0,0);
        FLOAT3 env  = float3(0,0,0);
#endif                

        // Finally add them all together
        FLOAT3 finalColor = amb + dif + spec + env;
        FLOAT fOutA = 1.0f;
#if %TEMP_AMBIENT
  #if !%ALPHAGLOW && %DIFFUSEALPHA && !%GLOSS_DIFFUSEALPHA
        fOutA = fAlpha * Ambient.w;
  #else        
        fOutA = Ambient.w;
  #endif        
#else  
        fOutA = fAlpha;
#endif

        FLOAT _fFogFrac = IN.Color1.w;
        HDROutput(OUT, FLOAT4 (finalColor, fOutA), fZ, GlobalFogColor.xyz, _fFogFrac);
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLightTempl_PS2B.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: General lighting fragment template for PS2B shader model (several light sources)
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      PS2XOnly
      AutoEnumTC
      SupportsMultiLights

#if !%SPECULAR
      NoSpecular
#endif

      MainInput
      {
        uniform sampler2D baseMap : register(sn),
#if %BUMP_MAP
        uniform sampler2D bumpMap : register(sn),
  #if %BUMP_DIFFUSE && %DIFFUSE
        uniform sampler2D bumpMapDiffuse : register(sn),
  #endif
#endif

#if %TEMP_LM || %TEMP_DOT3LM
        uniform sampler2D lightMap : register(sn),
#endif        
#if %TEMP_DOT3LM
        uniform sampler2D lightDirMap : register(sn),
#endif
#if %TEMP_SPECULAR_OCCLUSIONMAP
        uniform sampler2D occlusionMap : register(sn),
#endif

#if %DIFFUSE
    # ifdef _LIGHT0_TYPE
        uniform half4 Diffuse[ _NUM_LIGHTS ] : register(c2),
    # endif
#endif

#if %SPECULAR
    # ifdef _LIGHT0_TYPE
        uniform half4 Specular[ _NUM_LIGHTS ] : register(c6),
        uniform half4 SpecularExp : register(c14),
    # endif
#endif        

#if %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        uniform sampler2D glossMap : register(sn),
#elif %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        uniform sampler2D glossMap : register(sn),
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        uniform sampler2D glossMap : register(sn),
  #endif
#endif        

#if %TEMP_AMBIENT
        uniform half4 Ambient : register(c0),
  #if %ENVCMAMB
        uniform samplerCUBE envMap : register(sn),
        uniform half4 Reflect,
  #elif %ENVCMSPEC
        uniform samplerCUBE envMap : register(sn),
        uniform half4 EnvMapParams,
        uniform half4 FresnelParams,
  #endif
#endif
    # ifdef _LIGHT0_TYPE
        uniform sampler2D attenMap : register(sn),
        uniform samplerCUBE projMap : register(sn),
    # endif

#if %TEMP_SPECULAR_OCCLUSIONMAP
    # ifdef _LIGHT0_TYPE
        uniform half4 OcclusionMasks[ _NUM_LIGHTS ] : register(c10),
    # endif
#endif

#if %OFFSETBUMPMAPPING
        uniform half4 BumpOffset,
#endif

    # ifdef _HDRLM
        uniform sampler2D lightMapHDR : register(sn),
    # endif
    # ifdef _3DC_A
        uniform sampler2D bumpHeight : register(sn),
    # endif
    # ifdef _SPEC_ANTIALIAS
        uniform sampler2D specularMap : register(sn),
    # endif
    
        uniform half4 AttenInfo : register(c1),
      }

      DeclarationsScript
      {
        struct vertout
        {
          half4 baseTC     : TEXCOORDN;
#if %BUMP_MAP          
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
          half4 bumpTC     : TEXCOORDN;
  #endif
#endif

#if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA            
  #if !%ENVCMSPEC && !%ENVCMAMB
          half4 glossTC    : TEXCOORDN;
  #endif
#endif

#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP || %BUMP_ZCORRECT
          half4 lmTC_ZW    : TEXCOORDN;
#endif

          half4 viewVec    : TEXCOORDN;

#if %TEMP_AMBIENT
  #if %ENVCMAMB
          half4 envTC      : TEXCOORDN;
  #elif %ENVCMSPEC
          half4 tangVec    : TEXCOORDN;
          half4 binormVec  : TEXCOORDN;
          half4 normVec    : TEXCOORDN;
  #endif
#endif

    # ifdef _LIGHT0_TYPE
          half4 projTC      : TEXCOORDN;          
          half4 lightVec[ _NUM_LIGHTS ] : TEXCOORDN;
    # endif
        };

# ifdef _HDR_MRT
        FOUT_2
# else
  #if %BUMP_ZCORRECT
        FOUT_DEPTH
  #else
        FOUT
  #endif
# endif        

      }
      CoreScript
      {        
        half2 baseTC = IN.baseTC.xy;
        half2 bumpTC = baseTC;
#if %BUMP_MAP
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
        bumpTC = IN.bumpTC.xy;
  #endif
#endif

        half2 glossTC = baseTC;
#if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA            
  #if !%ENVCMSPEC && !%ENVCMAMB
        glossTC = IN.glossTC.xy;
  #endif
#endif          

        half3 viewVec = normalize(IN.viewVec.xyz);

        half fHeight = 0;
#if %OFFSETBUMPMAPPING
  # ifdef _3DC_A
        fHeight = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        fHeight = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        fHeight *= BumpOffset.x;
        baseTC = baseTC + viewVec.xy * fHeight;
        bumpTC = bumpTC + viewVec.xy * fHeight;
        glossTC = glossTC + viewVec.xy * fHeight;
#endif

        // load the diffuse texture
        half4 decalColor = tex2D(baseMap, baseTC.xy);
        half fAlpha = decalColor.a;

#if %TEMP_SPECULAR_OCCLUSIONMAP
        half4 occColor = tex2D(occlusionMap, IN.lmTC_ZW.xy);
#endif

#if %BUMP_MAP
        // load the bump normal
        half3 bumpNormal = GetNormalMap(bumpMap, bumpTC.xy);
        half3 Na = bumpNormal;
  #if %BUMP_DIFFUSE && %DIFFUSE
        half3 bumpNormalDiffuse = GetNormalMap(bumpMapDiffuse, bumpTC.xy);
  #endif

  #if %BUMP_NORMALIZE && %SPECULAR
    # if !defined (_3DC) && !defined (_V8U8) && !defined (_Cx_V8U8)
        // normalize post-filtered bump normals
        bumpNormal.xyz = normalize(bumpNormal.xyz);
    # endif
  #endif
#else        
        half3 bumpNormal = half3 (0,0,1);
#endif

#if %BUMP_ZCORRECT
// Calculate depth bias.
  # ifdef _3DC_A
        half height = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        half height = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        half fZ = DepthBias(height, bumpNormal, viewVec, IN.lmTC_ZW.zw);
#else
        half fZ = 1;
#endif

        // load the gloss
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        half4 glossColor = tex2D(glossMap, glossTC.xy);
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        half4 glossColor = tex2D(glossMap, glossTC.xy);
  #endif
#elif %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        half4 glossColor = tex2D(glossMap, glossTC.xy);
#endif
        half3 vFinalDif = half3 (0,0,0);
        half3 vFinalSpec = half3 (0,0,0);

        half NdotL;
        
        // 0 type = directional light source (no attenuation)
        // 1 type = omni light source
        // 2 type = projected light source
    # ifdef _LIGHT0_TYPE
        int aLType[ _NUM_LIGHTS ];
        aLType[0] = _LIGHT0_TYPE;
      # ifdef _LIGHT1_TYPE
        aLType[1] = _LIGHT1_TYPE;
      # endif
      # ifdef _LIGHT2_TYPE
        aLType[2] = _LIGHT2_TYPE;
      # endif
      # ifdef _LIGHT3_TYPE
        aLType[3] = _LIGHT3_TYPE;
      # endif
        
        // Only specular pass is used for light-map light sources
        bool aBOnlySpec[ _NUM_LIGHTS ];
      # ifdef _LIGHT0_ONLYSPEC
        aBOnlySpec[0] = _LIGHT0_ONLYSPEC;
      # endif
      # ifdef _LIGHT1_ONLYSPEC
        aBOnlySpec[1] = _LIGHT1_ONLYSPEC;
      # endif
      # ifdef _LIGHT2_ONLYSPEC
        aBOnlySpec[2] = _LIGHT2_ONLYSPEC;
      # endif
      # ifdef _LIGHT3_ONLYSPEC
        aBOnlySpec[3] = _LIGHT3_ONLYSPEC;
      # endif

        // Using specular occlusion maps for specific light source
        bool aBSpecOcclusion[ _NUM_LIGHTS ];
      # ifdef _LIGHT0_SPECOCCLUSION
        aBSpecOcclusion[0] = _LIGHT0_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT1_SPECOCCLUSION
        aBSpecOcclusion[1] = _LIGHT1_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT2_SPECOCCLUSION
        aBSpecOcclusion[2] = _LIGHT2_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT3_SPECOCCLUSION
        aBSpecOcclusion[3] = _LIGHT3_SPECOCCLUSION;
      # endif
        half fAttenFunction = 4.f/16.f;
        for (int i=0; i<_NUM_LIGHTS; i++)
        {
          // Calculate attenuation
          half atten = 1;
          if (aLType[i] != 0)
          {
            half dist = length(IN.lightVec[i].xyz) * AttenInfo[i];
            atten = tex2D(attenMap, half2(dist, fAttenFunction)).a;
          }
          // Get projector filter color if needed
          half3 filterColor = half3 (1,1,1);
          if (aLType[i] == 2)
            filterColor = texCUBE(projMap, IN.projTC.xyz);
            
          half3 lVec = normalize(IN.lightVec[i].xyz);
          // Calculate diffuse contribution
#if %DIFFUSE          
          if (!aBOnlySpec[i])
          {
  #if %BUMP_DIFFUSE
            NdotL = saturate(dot(lVec.xyz, bumpNormalDiffuse.xyz));
  #else
            NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));
  #endif
            half3 dif = decalColor.xyz * NdotL * ( half3 )Diffuse[i].xyz * atten * filterColor.xyz;
            dif.xyz = HDREncode(dif.xyz);  
            vFinalDif += dif.xyz;
          }
#endif

          // Calculate specular contribution
#if %SPECULAR
    # ifdef _SPEC_ANTIALIAS
          half3 Hn = normalize(viewVec.xyz + lVec.xyz);
          half NaH = dot(Hn , Na);
	        half NaNa = dot(Na , Na);
    	    half specVal = tex2D(specularMap, half2(NaH, NaNa)).x;
    # else
          half3 reflVec = (2*dot(lVec.xyz, bumpNormal.xyz)*bumpNormal.xyz)-lVec.xyz;
          half NdotR = saturate(dot(reflVec.xyz, viewVec.xyz));
          half fPow = SpecularExp.x;
  #if %SPECULARPOW_GLOSSALPHA
          fPow *= glossColor.a;
  #endif
          half specVal = pow(NdotR, fPow);
    # endif
          half3 spec = specVal * ( half3 )Specular[i].xyz;
  #if %TEMP_SPECULAR_OCCLUSIONMAP
          if (aBSpecOcclusion[i])
          {
            half fOccl = dot(occColor, OcclusionMasks[i]);
            spec.xyz *= fOccl;
          }
  #endif
          spec = spec * atten * filterColor.xyz;
  #if %GLOSS_MAP
          spec.xyz *= glossColor.xyz;
  #elif %GLOSS_DIFFUSEALPHA
          spec.xyz *= fAlpha;
  #endif
          spec.xyz = HDREncode(spec.xyz);  
          vFinalSpec += spec.xyz;
#endif
        }
    # endif

        // Calculate ambient, LM and environment contribution
#if %TEMP_AMBIENT
        half3 amb = decalColor.xyz * ( half3 )Ambient.xyz;
        half3 difLM = half3(0,0,0);
        half3 env = half3(0,0,0);
  #if %TEMP_LM
        // load the lm
        half4 lmColor = tex2D(lightMap, IN.lmTC_ZW.xy);
        difLM = (decalColor.xyz * lmColor.xyz);
        difLM = HDREncodeLM(difLM);
  #elif %TEMP_DOT3LM
        // load the lm
        half4 lmColor = tex2D(lightMap, IN.lmTC_ZW.xy);
        // load the lm dir
        half4 lmDir = tex2D(lightDirMap, IN.lmTC_ZW.xy);
        half lmNdotL = saturate(dot( EXPAND(lmDir.xyz), bumpNormal.xyz));
        half  lmIntens = lmNdotL * lmColor.a + (1-lmColor.a);
    # ifdef _HDRLM
        // Decode RGBE LM HDR color
        half4 lmHDRColor = tex2D(lightMapHDR, IN.lmTC_ZW.xy);
        half fExp = ( lmHDRColor.a * 256 - HDR_EXP_OFFSET );
	      half fScale = pow( HDR_EXP_BASE, fExp );
	      difLM = lmHDRColor.xyz * fScale * lmIntens;
    # else
        difLM = HDREncodeLM(lmColor.xyz * lmDir.a * lmIntens);
    # endif        
        difLM *= decalColor.xyz;
  #endif        

  #if %ENVCMAMB
        // load the environment map
        half4 envColor = texCUBE(envMap, IN.envTC.xyz);
        half fLerp = Reflect.a;
    #if %ENVCM_MASKED
        // load the gloss
        fLerp *= glossColor.a;
    #endif
        amb = lerp(amb.xyz, envColor.xyz, fLerp);
  #elif %ENVCMSPEC        
        half fEnvmapAmount = EnvMapParams.x;

        half fFresnelScale = FresnelParams.x;
        half fFresnelBias = FresnelParams.y;
        half fFresnelPow = FresnelParams.z;

        // Calc Reflection Vector
        half3x3 worldTangentSpace;
        worldTangentSpace[0] = IN.tangVec.xyz;
        worldTangentSpace[1] = IN.binormVec.xyz;
        worldTangentSpace[2] = IN.normVec.xyz;

        half NdotE = dot(bumpNormal.xyz, viewVec);
        half3 reflectVect = (2.0*NdotE*bumpNormal.xyz)-(dot(bumpNormal.xyz, bumpNormal.xyz)*viewVec);
        half3 worldReflectVec = mul(reflectVect, worldTangentSpace);

        // Calc Fresnel factor
        half fresnel = fFresnelBias + (pow((1-NdotE), fFresnelPow) * fFresnelScale);

        // Calc environment
        env = texCUBE(envMap, worldReflectVec).xyz * fEnvmapAmount * fresnel;
     #if %GLOSS_MAP
        env *= glossColor.xyz;
     #elif %GLOSS_DIFFUSEALPHA
        env *= fAlpha;
     #endif
  #endif
  #if %ALPHAGLOW
        amb += fAlpha * decalColor.xyz;
  #endif
        amb = HDREncodeAmb(amb);
        env = HDREncodeAmb(env);
#else
        half3 amb = half3 (0,0,0);
        half3 env  = half3 (0,0,0);
        half3 difLM = half3 (0,0,0);
#endif                

        // Finally add them all together
        half3 finalColor = amb + env + difLM + vFinalDif + vFinalSpec;
        half fOutA = 1.0f;
        
#if %TEMP_AMBIENT
  #if %ALPHAGLOW && %TEMP_DOT3LM
  // Fake (for compatibility with old system)
  // TODO: remove after patch 2
        fOutA = fAlpha * Ambient.w;        
  #elif !%ALPHAGLOW && %DIFFUSEALPHA && !%GLOSS_DIFFUSEALPHA
        fOutA = fAlpha * Ambient.w;
  #else        
        fOutA = Ambient.w;
  #endif        
#else  
        fOutA = fAlpha;
#endif  
      
# ifdef _HDR
        HDROutput(OUT, half4 (finalColor.xyz, fOutA), fZ);
# else
        OUT.Color.xyz = finalColor.xyz;
        OUT.Color.a = fOutA;
  #if %BUMP_ZCORRECT
        OUT.Depth = fZ;
  #endif
# endif        

      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLightTempl_PS30.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: General lighting fragment template for PS30 shader model (several light sources)
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      PS30Only
      AutoEnumTC
      SupportsMultiLights

#if !%SPECULAR
      NoSpecular
#endif

      MainInput
      {
        uniform sampler2D baseMap : register(sn),
#if %BUMP_MAP
        uniform sampler2D bumpMap : register(sn),
  #if %BUMP_DIFFUSE && %DIFFUSE
        uniform sampler2D bumpMapDiffuse : register(sn),
  #endif
#endif

#if %TEMP_LM || %TEMP_DOT3LM
        uniform sampler2D lightMap : register(sn),
#endif        
#if %TEMP_DOT3LM
        uniform sampler2D lightDirMap : register(sn),
#endif
#if %TEMP_SPECULAR_OCCLUSIONMAP
        uniform sampler2D occlusionMap : register(sn),
#endif

#if %DIFFUSE
    # ifdef _LIGHT0_TYPE
        uniform float4 Diffuse[ _NUM_LIGHTS ] : register(c2),
    # endif
#endif

#if %SPECULAR
    # ifdef _LIGHT0_TYPE
        uniform float4 Specular[ _NUM_LIGHTS ] : register(c6),
        uniform float4 SpecularExp : register(c14),
    # endif
#endif        

#if %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        uniform sampler2D glossMap : register(sn),
#elif %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        uniform sampler2D glossMap : register(sn),
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        uniform sampler2D glossMap : register(sn),
  #endif
#endif        

#if %TEMP_AMBIENT
        uniform float4 Ambient : register(c0),
  #if %ENVCMAMB
        uniform samplerCUBE envMap : register(sn),
        uniform float4 Reflect,
  #elif %ENVCMSPEC
        uniform samplerCUBE envMap : register(sn),
        uniform float4 EnvMapParams,
        uniform float4 FresnelParams,
  #endif
#endif
    # ifdef _LIGHT0_TYPE
        uniform sampler2D attenMap : register(sn),
        uniform samplerCUBE projMap : register(sn),
    # endif

#if %TEMP_SPECULAR_OCCLUSIONMAP
    # ifdef _LIGHT0_TYPE
        uniform float4 OcclusionMasks[ _NUM_LIGHTS ] : register(c10),
    # endif
#endif

#if %OFFSETBUMPMAPPING
        uniform float4 BumpOffset,
#endif

    # ifdef _HDRLM
        uniform sampler2D lightMapHDR : register(sn),
    # endif
    # ifdef _3DC_A
        uniform sampler2D bumpHeight : register(sn),
    # endif
    # ifdef _SPEC_ANTIALIAS
        uniform sampler2D specularMap : register(sn),
    # endif
    
        uniform float4 AttenInfo : register(c1),
      }

      DeclarationsScript
      {
        struct vertout
        {
          float4 baseTC     : TEXCOORDN;
#if %BUMP_MAP          
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
          float4 bumpTC     : TEXCOORDN;
  #endif
#endif
            
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
          float4 glossTC    : TEXCOORDN;
#elif !%TEMP_AMBIENT || !%ENVCMSPEC
  #if %SPECULAR
    #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
          float4 glossTC    : TEXCOORDN;
    #endif
  #endif
#endif          

#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP || %BUMP_ZCORRECT
          float4 lmTC_ZW    : TEXCOORDN;
#endif

          float4 viewVec    : COLOR0;

#if %TEMP_AMBIENT
  #if %ENVCMAMB
          float4 envTC      : TEXCOORDN;
  #elif %ENVCMSPEC
          float4 tangVec    : TEXCOORDN;
          float4 binormVec  : TEXCOORDN;
          float4 normVec    : TEXCOORDN;
  #endif
#endif

    # ifdef _LIGHT0_TYPE
          FLOAT4 lightVec[ _NUM_LIGHTS ] : TEXCOORDN;
          float4 projTC      : COLOR1;          
    # endif
        };

# ifdef _HDR_MRT
        FOUT_2
# else
  #if %BUMP_ZCORRECT
        FOUT_DEPTH
  #else
        FOUT
  #endif
# endif        

      }
      CoreScript
      {        
        float2 baseTC = IN.baseTC.xy;
        float2 bumpTC = baseTC;
#if %BUMP_MAP
  #if !%TEMP_AMBIENT || !%ENVCMSPEC
        bumpTC = IN.bumpTC.xy;
  #endif
#endif

        float2 glossTC = baseTC;
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        glossTC = IN.glossTC.xy;
#elif !%TEMP_AMBIENT || !%ENVCMSPEC
  #if %SPECULAR
    #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        glossTC = IN.glossTC.xy;
    #endif
  #endif
#endif          

        FLOAT3 viewVec = normalize(IN.viewVec.xyz);

        FLOAT fHeight = 0;
#if %OFFSETBUMPMAPPING
  # ifdef _3DC_A
        fHeight = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        fHeight = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        fHeight *= BumpOffset.x;
        baseTC = baseTC + viewVec.xy * fHeight;
        bumpTC = bumpTC + viewVec.xy * fHeight;
        glossTC = glossTC + viewVec.xy * fHeight;
#endif

        // load the diffuse texture
        FLOAT4 decalColor = tex2D(baseMap, baseTC.xy);
        FLOAT fAlpha = decalColor.a;

#if %TEMP_SPECULAR_OCCLUSIONMAP
        FLOAT4 occColor = tex2D(occlusionMap, IN.lmTC_ZW.xy);
#endif

#if %BUMP_MAP
        // load the bump normal
        FLOAT3 bumpNormal = GetNormalMap(bumpMap, bumpTC.xy);
        FLOAT3 Na = bumpNormal;
  #if %BUMP_DIFFUSE && %DIFFUSE
        FLOAT3 bumpNormalDiffuse = GetNormalMap(bumpMapDiffuse, bumpTC.xy);
  #endif

  #if %BUMP_NORMALIZE && %SPECULAR
    # if !defined (_3DC) && !defined (_V8U8) && !defined (_Cx_V8U8)
        // normalize post-filtered bump normals
        bumpNormal.xyz = normalize(bumpNormal.xyz);
    # endif
  #endif
#else        
        FLOAT3 bumpNormal = FLOAT3 (0,0,1);
#endif

#if %BUMP_ZCORRECT
// Calculate depth bias.
  # ifdef _3DC_A
        FLOAT height = EXPAND(tex2D(bumpHeight, bumpTC.xy).x);
  # else
        FLOAT height = EXPAND(tex2D(bumpMap, bumpTC.xy).a);
  # endif
        FLOAT fZ = DepthBias(height, bumpNormal, viewVec, IN.lmTC_ZW.zw);
#else
        FLOAT fZ = 1;
#endif

        // load the gloss
#if %TEMP_AMBIENT && %ENVCMAMB && %ENVCM_MASKED
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
#elif %SPECULAR
  #if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
  #endif
#elif %TEMP_AMBIENT && %ENVCMSPEC && %GLOSS_MAP
        FLOAT4 glossColor = tex2D(glossMap, glossTC.xy);
#endif
        FLOAT3 vFinalDif = FLOAT3 (0,0,0);
        FLOAT3 vFinalSpec = FLOAT3 (0,0,0);

        FLOAT NdotL;
        
        // 0 type = directional light source (no attenuation)
        // 1 type = omni light source
        // 2 type = projected light source
    # ifdef _LIGHT0_TYPE
        int aLType[ _NUM_LIGHTS ];
        aLType[0] = _LIGHT0_TYPE;
      # ifdef _LIGHT1_TYPE
        aLType[1] = _LIGHT1_TYPE;
      # endif
      # ifdef _LIGHT2_TYPE
        aLType[2] = _LIGHT2_TYPE;
      # endif
      # ifdef _LIGHT3_TYPE
        aLType[3] = _LIGHT3_TYPE;
      # endif
        
        // Only specular pass is used for light-map light sources
        bool aBOnlySpec[ _NUM_LIGHTS ];
      # ifdef _LIGHT0_ONLYSPEC
        aBOnlySpec[0] = _LIGHT0_ONLYSPEC;
      # endif
      # ifdef _LIGHT1_ONLYSPEC
        aBOnlySpec[1] = _LIGHT1_ONLYSPEC;
      # endif
      # ifdef _LIGHT2_ONLYSPEC
        aBOnlySpec[2] = _LIGHT2_ONLYSPEC;
      # endif
      # ifdef _LIGHT3_ONLYSPEC
        aBOnlySpec[3] = _LIGHT3_ONLYSPEC;
      # endif

        // Using specular occlusion maps for specific light source
        bool aBSpecOcclusion[ _NUM_LIGHTS ];
      # ifdef _LIGHT0_SPECOCCLUSION
        aBSpecOcclusion[0] = _LIGHT0_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT1_SPECOCCLUSION
        aBSpecOcclusion[1] = _LIGHT1_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT2_SPECOCCLUSION
        aBSpecOcclusion[2] = _LIGHT2_SPECOCCLUSION;
      # endif
      # ifdef _LIGHT3_SPECOCCLUSION
        aBSpecOcclusion[3] = _LIGHT3_SPECOCCLUSION;
      # endif
        FLOAT fAttenFunction = 4.f/16.f;
        for (int i=0; i<_NUM_LIGHTS; i++)
        {
          // Calculate attenuation
          FLOAT atten = 1;
          if (aLType[i] != 0)
          {
            FLOAT dist = length(IN.lightVec[i].xyz) * AttenInfo[i];
            atten = tex2D(attenMap, float2(dist, fAttenFunction)).a;
          }
          //if (atten > 0)
          {
            // Get projector filter color if needed
            FLOAT3 filterColor = FLOAT3 (1,1,1);
            if (aLType[i] == 2)
              filterColor = texCUBE(projMap, IN.projTC.xyz);
              
            FLOAT3 lVec = normalize(IN.lightVec[i].xyz);
            // Calculate diffuse contribution
#if %DIFFUSE          
            if (!aBOnlySpec[i])
            {
  #if %BUMP_DIFFUSE
              NdotL = saturate(dot(lVec.xyz, bumpNormalDiffuse.xyz));
  #else
              NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));
  #endif
              FLOAT3 dif = decalColor.xyz * NdotL * ( FLOAT3 )Diffuse[i].xyz * atten * filterColor.xyz;
              dif.xyz = HDREncode(dif.xyz);  
              vFinalDif += dif.xyz;
            }
#endif

            // Calculate specular contribution
#if %SPECULAR
    # ifdef _SPEC_ANTIALIAS
            FLOAT3 Hn = normalize(viewVec.xyz + lVec.xyz);
            FLOAT NaH = dot(Hn , Na);
	          FLOAT NaNa = dot(Na , Na);
    	      FLOAT specVal = tex2D(specularMap, float2(NaH, NaNa)).x;
    # else
            FLOAT3 reflVec = (2*dot(lVec.xyz, bumpNormal.xyz)*bumpNormal.xyz)-lVec.xyz;
            FLOAT NdotR = saturate(dot(reflVec.xyz, viewVec.xyz));
            FLOAT fPow = SpecularExp.x;
  #if %SPECULARPOW_GLOSSALPHA
            fPow *= glossColor.a;
  #endif
            FLOAT specVal = pow(NdotR, fPow);
    # endif
            FLOAT3 spec = specVal * ( FLOAT3 )Specular[i].xyz;
  #if %TEMP_SPECULAR_OCCLUSIONMAP
            if (aBSpecOcclusion[i])
            {
              FLOAT fOccl = dot(occColor, OcclusionMasks[i]);
              spec.xyz *= fOccl;
            }
  #endif
            spec = spec * atten * filterColor.xyz;
  #if %GLOSS_MAP
            spec.xyz *= glossColor.xyz;
  #elif %GLOSS_DIFFUSEALPHA
            spec.xyz *= fAlpha;
  #endif
            spec.xyz = HDREncode(spec.xyz);  
            vFinalSpec += spec.xyz;
#endif
          }
        }
    # endif

        // Calculate ambient, LM and environment contribution
#if %TEMP_AMBIENT
        FLOAT3 amb = decalColor.xyz * ( FLOAT3 )Ambient.xyz;
        FLOAT3 difLM = float3(0,0,0);
        FLOAT3 env = float3(0,0,0);
  #if %TEMP_LM
        // load the lm
        FLOAT4 lmColor = tex2D(lightMap, IN.lmTC_ZW.xy);
        difLM = (decalColor.xyz * lmColor.xyz);
        difLM = HDREncodeLM(difLM);
  #elif %TEMP_DOT3LM
        // load the lm
        FLOAT4 lmColor = tex2D(lightMap, IN.lmTC_ZW.xy);
        // load the lm dir
        FLOAT4 lmDir = tex2D(lightDirMap, IN.lmTC_ZW.xy);
        FLOAT lmNdotL = saturate(dot( EXPAND(lmDir.xyz), bumpNormal.xyz));
        FLOAT  lmIntens = lmNdotL * lmColor.a + (1-lmColor.a);
    # ifdef _HDRLM
        // Decode RGBE LM HDR color
        FLOAT4 lmHDRColor = tex2D(lightMapHDR, IN.lmTC_ZW.xy);
        FLOAT fExp = ( lmHDRColor.a * 256 - HDR_EXP_OFFSET );
	      FLOAT fScale = pow( HDR_EXP_BASE, fExp );
	      difLM = lmHDRColor.xyz * fScale * lmIntens;
    # else
        difLM = HDREncodeLM(lmColor.xyz * lmDir.a * lmIntens);
    # endif        
        difLM *= decalColor.xyz;
  #endif        

  #if %ENVCMAMB
        // load the environment map
        FLOAT4 envColor = texCUBE(envMap, IN.envTC.xyz);
        FLOAT fLerp = Reflect.a;
    #if %ENVCM_MASKED
        // load the gloss
        fLerp *= glossColor.a;
    #endif
        amb = lerp(amb.xyz, envColor.xyz, fLerp);
  #elif %ENVCMSPEC        
        FLOAT fEnvmapAmount = EnvMapParams.x;

        FLOAT fFresnelScale = FresnelParams.x;
        FLOAT fFresnelBias = FresnelParams.y;
        FLOAT fFresnelPow = FresnelParams.z;

        // Calc Reflection Vector
        float3x3 worldTangentSpace;
        worldTangentSpace[0] = IN.tangVec.xyz;
        worldTangentSpace[1] = IN.binormVec.xyz;
        worldTangentSpace[2] = IN.normVec.xyz;

        FLOAT NdotE = dot(bumpNormal.xyz, viewVec);
        FLOAT3 reflectVect = (2.0*NdotE*bumpNormal.xyz)-(dot(bumpNormal.xyz, bumpNormal.xyz)*viewVec);
        FLOAT3 worldReflectVec = mul(reflectVect, worldTangentSpace);

        // Calc Fresnel factor
        FLOAT fresnel = fFresnelBias + (pow((1-NdotE), fFresnelPow) * fFresnelScale);

        // Calc environment
        env = texCUBE(envMap, worldReflectVec).xyz * fEnvmapAmount * fresnel;
     #if %GLOSS_MAP
        env *= glossColor.xyz;
     #elif %GLOSS_DIFFUSEALPHA
        env *= fAlpha;
     #endif
  #endif
  #if %ALPHAGLOW
        amb += fAlpha * decalColor.xyz;
  #endif
        amb = HDREncodeAmb(amb);
        env = HDREncodeAmb(env);
#else
        FLOAT3 amb = FLOAT3 (0,0,0);
        FLOAT3 env  = FLOAT3 (0,0,0);
        FLOAT3 difLM = FLOAT3 (0,0,0);
#endif                

        // Finally add them all together
        FLOAT3 finalColor = amb + env + difLM + vFinalDif + vFinalSpec;
        FLOAT _fFogFrac = IN.viewVec.w;
        FLOAT fOutA = 1.0f;
        
#if %TEMP_AMBIENT
  #if %ALPHAGLOW && %TEMP_DOT3LM
  // Fake (for compatibility with old system)
  // TODO: remove after patch 2
        fOutA = fAlpha * Ambient.w;        
  #elif !%ALPHAGLOW && %DIFFUSEALPHA && !%GLOSS_DIFFUSEALPHA
        fOutA = fAlpha * Ambient.w;
  #else        
        fOutA = Ambient.w;
  #endif        
#else  
        fOutA = fAlpha;
#endif  
      
# ifdef _HDR
        HDROutput(OUT, FLOAT4 (finalColor.xyz, fOutA), fZ, GlobalFogColor.xyz, _fFogFrac); //.Color.xyz = lerp(HDREncodeAmb(( FLOAT3 )GlobalFogColor.xyz), finalColor.xyz, _fFogFrac);
# else
        OUT.Color.xyz = lerp(( FLOAT3 )GlobalFogColor.xyz, saturate(finalColor.xyz), saturate(_fFogFrac));
        OUT.Color.a = fOutA;
  #if %BUMP_ZCORRECT
        OUT.Depth = fZ;
  #endif
# endif        

      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLightVol.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
        };

        FOUT
      }
      CoreScript
      {
        // IN.Tex1.xyz = fPos;
        // IN.Tex2.xyz = lPos;
        // IN.Tex3.xyz = lightVec;
        // IN.Tex4.xyz = normal;

        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);

        float v1 = dot(IN.Tex1.xyz, IN.Tex1.xyz);
        float v2 = dot(IN.Tex1.xyz, IN.Tex2.xyz);
        float3 p = saturate(v2 / v1) * IN.Tex1.xyz - IN.Tex2.xyz;
        float fP = dot(p, p) * 0.02 + 1.2;
        float fT = dot(IN.Tex3.xyz, IN.Tex3.xyz) * 0.004 + 1;
        float fDiffuse = saturate(dot(IN.Tex3.xyz, IN.Tex4.xyz));
        fT = fDiffuse / fT + 0.1;
        float3 color = decalColor.xyz * fT + 1 / fP;

        OUT.Color.xyz = color.xyz*Diffuse.xyz;
        OUT.Color.w = decalColor.w * Diffuse.w;
      }


////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLight_Decal_Diff_ProjSingleLight_NoAtten.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE projMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);

        float3 dif = (decalColor.xyz * projColor.xyz * Diffuse.xyz * IN.Color.xyz) * 2;
        float3 amb = decalColor.xyz * Ambient.xyz;

        // finally add them all together
        OUT.Color.xyz = amb + dif;
        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLight_Decal_Diff_SingleLight.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Ambient,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);

        float3 dif = (decalColor.xyz * Diffuse.xyz * IN.Color1.xyz * IN.Color.xyz) * 2;
        float3 amb = decalColor.xyz * Ambient.xyz;

        // finally add them all together
        OUT.Color.xyz = amb + dif;
        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLight_Diff.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE normCubeMap : texunit1,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);

        // Light vector from input color
        float lVec = 2*(texCUBE(normCubeMap, IN.Tex1.xyz).b-0.5);
        float NdotL = lVec;
        float3 dif = (decalColor.xyz * NdotL * Diffuse.xyz) * 2;

        // finally add them all together
        OUT.Color.xyz = dif;
        OUT.Color.w = decalColor.w * Diffuse.w;
      }


////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCLight_Diff_AlphaGlow.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE normCubeMap : texunit1,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);

        // Light vector from input color
        float lVec = 2*(texCUBE(normCubeMap, IN.Tex1.xyz).b-0.5);
        float NdotL = lVec;
        float3 dif = (decalColor.xyz * NdotL * Diffuse.xyz) * 2;

        // finally add them all together
        OUT.Color.xyz = dif;
        OUT.Color.w = decalColor.w * Diffuse.w;
      }


