      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      //NoFog      
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, BEND, TEX_MATRIX2x4, uniform float2x4 ShadowModelMatr0, uniform float ShadowBias }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1_2
          OUT_T2_2
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        OUT.Tex0 = mul(TexGen0, vPos);          
        OUT.Tex1.xy = mul(TexMatrix, IN.TexCoord0);

        float fZ = dot(ShadowModelMatr0._11_12_13_14, vPos);
        float fW = dot(ShadowModelMatr0._21_22_23_24, vPos);
        OUT.Tex2.x = fZ;
        OUT.Tex2.y = fW;
      }
