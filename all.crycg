        float fDist = length(viewVec.xyz);
        float fFade = max(0.001, FadingDist.x);
        fDist = fDist / fFade;
        fDist = min(fDist, 1);
        fDist = fDist * fDist;
        fDist = fDist * fDist;
        
        OUT.Color.b = IN.Color1.x * fDist;
      }
