      #include "../CGVPMacro.csi"

      VS20Only

      Noise
      Projected

      Param4f ( Name = NoisePos Comp 'time 0.8' Comp 'time 0.6' Comp = 0 User 'WaveAmplitude') // xy = wavepos, z = 0, w = amplitude
      Param4f ( Name = WaterLevel Comp 'WaterLevel' Comp = 0 Comp = 1)  // Water level
      
      VertAttributes { POSITION_3 PRIM_COLOR }

      MainInput { VIEWPROJ_MATRIX, uniform float4 NoisePos, CAMERA_POS, uniform float4 Normal, uniform float4 Scale, uniform float4 WaterLevel, uniform float4 TexShiftRipple, uniform float4 TexGenRipple0, uniform float4 TexGenRipple1, uniform float4 TexDetailScale, uniform float4x4 TexProjMatrix, uniform float4 pg[66] : register(c30) }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2_2
          OUT_T3
          OUT_T4
          OUT_T5_2
          OUT_C0
        };

      }
      PositionScript = PosWaterDeform_PlusWaterLevel
      CoreScript
      {
        float fZ = dot(ModelViewProj._31_32_33_34, vPos);
        float fW = dot(ModelViewProj._41_42_43_44, vPos);
        OUT.Tex5.x = fZ;
        OUT.Tex5.y = fW;

        OUT.Tex0.xyz = vPos.xyz * Scale.xyz;
        OUT.Tex3.xyz = Normal.xyz;
        OUT.Tex4.xyz = normalize(vPos.xyz - CameraPos.xyz);

        float2 vTex;
        vTex.x = dot(vPos, TexGenRipple0);
        vTex.y = dot(vPos, TexGenRipple1);
        OUT.Tex2.xy = (vTex.xy + TexShiftRipple.xy) * TexDetailScale.xy;
    
        float4 vProjTex = mul(TexProjMatrix, vPos);
        OUT.Tex1 = vProjTex;
    
        OUT.Color = IN.Color;
      }
    // ===============================================================
// Vertex Program: 
// Description: 
// Last Update: 14/08/2003
// Coder: Andrey Honich
// ===============================================================

      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TANG_3X3 TEXCOORD0_2 }
      
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_T2
          OUT_T3_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex3.xy = IN.TexCoord0.xy;

        TANG_MATR

        // store normalized light vector
        float3 lightVec = normalize(LightPos.xyz - vPos.xyz);
        // transform light vector from object space to tangent space and pass it as a tex coords
        OUT.Tex1.xyz = mul(objToTangentSpace, lightVec.xyz);

        // compute view vector
        float3 viewVec = normalize(CameraPos.xyz - vPos.xyz);

        // compute half angle vector
        float3 halfAngleVector = normalize(lightVec + viewVec);

        // transform half angle vector from object space to tangent space and pass it as a tex coords
        OUT.Tex2.xyz = mul(objToTangentSpace, halfAngleVector);
      }
    ////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Vertex Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGVProg_BumpDiffSpec_PS.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 TANG_3X3 }

      MainInput { uniform float4x4 ModelViewProj, uniform float4 LightPos, uniform float4 CameraPos, uniform float4 AttenInfo }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_T3
          OUT_C0
        };

      }
      SubrScript
      {
        // returns light distance
        float ComputeLightVectors(
            out float3 lightDir, 
            out float3 viewDir, 
            out float3 halfVec, 
            float3 vertPos, float3 lightPos, float3 camPos) 
        {
	        // find the light distance and normalized light direction
	        lightDir = lightPos-vertPos;
	        float lightDist = length(lightDir);
	        lightDir /= lightDist; // normalize

	        // find the view distance and normalized view direction
	        viewDir = normalize(camPos-vertPos);

	        // find the half-angle vector
	        halfVec = normalize(viewDir+lightDir);

          return lightDist;
        }
      }
      PositionScript = PosCommon
      CoreScript
      {
        TANG_MATR

        // compute lighting vectors
        float3 LightDirection, ViewDirection, HalfVector;
        float LightDistance = ComputeLightVectors(LightDirection, ViewDirection, HalfVector, vPos.xyz, LightPos.xyz, CameraPos.xyz);
    
        // transform the light direction to tangent space
        OUT.Tex2.xyz = normalize(mul(objToTangentSpace, LightDirection)).xyzz;

        // transform the half vector to tangent space
        float3 halfVecTangent = normalize(mul(objToTangentSpace, HalfVector)).xyz;

	      // compute light attenuation
        float3 lightVec = LightPos.xyz - vPos.xyz;
        float fiSqDist = rsqrt(dot(lightVec, lightVec));        
        OUT.Color.w = (AttenInfo.x - 1/fiSqDist) * AttenInfo.y;

	      // copy the texcoord over (duplicate for the bump map, also).
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;

        // Set up texcoords for texm3x2tex to get specular
        OUT.Tex3.xyz = halfVecTangent.xyzz;
      }

      #include "../CGVPMacro.csi"


      ParamStateMatrix (Name = ModelView Type = View)
      VertAttributes { POSITION_3 NORMAL_3 TEXCOORD0_2 }
      
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 ModelView, uniform float4 Constants }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        float2 vTex;
        vTex.x = dot(IN.Normal.xyz, ModelView[0].xyz) + 1;
        vTex.y = dot(IN.Normal.xyz, ModelView[1].xyz) - 0.5;
        vTex.xy = vTex.xy * 0.5;
        OUT.Tex3.xy = vTex.xy;
        OUT.Tex0.xy = IN.TexCoord0;
        OUT.Tex1.xy = IN.TexCoord0;
        OUT.Color.xyz = (0.3).xxx;
      }
    ////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Vertex Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGVProg_CartoonShading.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, uniform float4 Color }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        // 1. Calculate L dot N and pass result to ToonLookup texture
        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);
        float LdotN = dot(vLightDir.xyz, IN.Normal.xyz);
        OUT.Tex0.x = LdotN;

        // 2. Calculate E dot N and pass result to EdgeLookup texture
        float3 vEyeDir = normalize(CameraPos.xyz - vPos.xyz);
        float EdotN = dot(vEyeDir.xyz, IN.Normal.xyz);          
        OUT.Tex1.x = EdotN;
        
        // Use custom color
        OUT.Color = Color;
      }
    
      #include "../CGVPMacro.csi"


      VertAttributes { TANG_3X3 }
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, ATTEN, CAMERA_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;

        // compute the 3x3 tranform from tangent space to object space
        float3x3 objToTangentSpace;
        objToTangentSpace[0] = IN.Tangent;
        objToTangentSpace[1] = IN.Binormal;
        objToTangentSpace[2] = IN.TNormal;

        // store normalized light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        lightVec = mul(objToTangentSpace, lightVec);
        
        float3 vDist = PROC_ATTENPIX;
        // transform light vector from object space to tangent space and pass it as a tex coords
        OUT.Tex2.xyz = vDist;
        OUT.Color.w = vDist.z;
        
        float fDirect = (AttenInfo.z - AttenInfo.y) * AttenInfo.w;
        lightVec = lightVec * fDirect.x;
        OUT.Color1.xyz = AttenInfo.y * normalize(lightVec) + AttenInfo.y;

        // calc normalized eye vector
        float3 eyeVec = normalize(CameraPos.xyz - vPos.xyz);
        
        OUT.Color.xyz = (dot(IN.TNormal, eyeVec)).xxx;
      }
    
      #include "../CGVPMacro.csi"


      VertAttributes { TNORMAL_3 TANG_3X3 }
      MainInput { VIEWPROJ_MATRIX, uniform float3 LightPos, LIGHT_MATRIX, ATTEN, CAMERA_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;
        OUT.Tex2 = mul(LightMatrix, vPos);

        TANG_MATR

        // store normalized light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        float fiSqDist = rsqrt(dot(lightVec, lightVec));
        lightVec = lightVec * fiSqDist;
        
        OUT.Color.a = PROC_ATTENVERT;
        float fDirect = (AttenInfo.z - AttenInfo.y) * AttenInfo.w;
        lightVec = lightVec * fDirect.x;
        OUT.Color1.xyz = 0.5 * mul(objToTangentSpace, lightVec.xyz) + 0.5.xxx;

        // calc normalized eye vector
        float3 eyeVec = normalize(CameraPos.xyz - vPos.xyz);
        
        OUT.Color.xyz = (dot(IN.TNormal, eyeVec)).xxx;
      }
    // ===============================================================
// Vertex Program: FlashBang
// Description: Flashbang fx
// Last Update: 17/06/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
	VIEWPROJ_MATRIX,
	
	uniform float4   vTexCoordScale // need uv scale, for rectangular textures in gl...    
}

DeclarationsScript
{
	struct appin
	{
	  IN_P
	  IN_T0
	};
	struct vertout
	{
	  OUT_P
	  OUT_T0_2
	  OUT_T1_2
	};

}

PositionScript = PosCommon

CoreScript
{
	OUT.Tex0.xy = IN.TexCoord0.xy*vTexCoordScale.xy;
	OUT.Tex1.xy = IN.TexCoord0.xy*vTexCoordScale.zw;
}
   
    
