    ////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Vertex Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGVProgFogCaust.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////



      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 }
      MainInput { uniform float4x4 ModelViewProj, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix, uniform float4 CaustTexGen0, uniform float4 CaustTexGen1, uniform float3 WaterLevel, uniform float4 CameraPos }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex1.xy  = mul(FogMatrix, vPos);
        OUT.Tex2.x = dot(CaustTexGen0, vPos);
        OUT.Tex2.y = dot(CaustTexGen1, vPos);

        float fDistBlendFactor = vPos.w - length(vPos.xyz - CameraPos.xyz) * CameraPos.w;
        OUT.Color.w = fDistBlendFactor * (float)((WaterLevel.x - vPos.z) >= vPos.w);
        OUT.Color.xyz = IN.Color.xyz;
      }
    ////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Vertex Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGVProgFogVol.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////



      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 }
      MainInput { VIEWPROJ_MATRIX, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
	      // y
	      float2 tex0;
	      tex0.xy = mul(FogEnterMatrix, vPos);

	      //x
	      float2 temp = mul(FogMatrix, vPos);
	      temp.x -= 0.5f;
	      temp.x = abs(temp.x);
	      temp.x = clamp(temp.x,0,.4921875f); //63.f/128.f = .4921875

	      if(tex0.x > 0.5)
		      temp.x += 0.5;
	      tex0.x = temp.x;

      	OUT.Tex0.xy = tex0;
      }
    ////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Vertex Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGVProgFur_DiffSpec.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////



      #include "../CGVPMacro.csi"


      NoFog
      AutoEnumTC
      
      VertAttributes { POSITION_3 TANG_3X3 TEXCOORD0_2 }
      MainInput { VIEWPROJ_MATRIX, uniform float4 Modifiers, uniform float4 FurParams, LIGHT_POS, CAMERA_POS, uniform float4 ScaleBiasTC }
      DeclarationsScript
      {
        struct appin
        {
          float4 Position  : POSITION;
          IN_TANGVECS
          float4 TexCoord0 : TEXCOORD0;
        };
        
        // define outputs from vertex shader
        struct vertout
        {
          float4 HPosition  : POSITION;
          float2 Tex0       : TEXCOORDN;
          float4 Tex1       : TEXCOORDN;
          float4 Tex2       : TEXCOORDN;
          float2 Tex3       : TEXCOORDN;
          float2 Tex4       : TEXCOORDN;
        };
      }
      PositionScript = PosFur
      CoreScript
      {
        // FurParams.x = FurScaleX
        // FurParams.y = FurScaleY
        
        // Modifiers.x = FurLength
        // Modifiers.w = FurOffsetScale
        OUT.Tex0.xy = (IN.TexCoord0.xy+ScaleBiasTC.zw)*ScaleBiasTC.xy;
        OUT.Tex3.xy = IN.TexCoord0.xy * FurParams.xy;

        TANG_MATR

        // store normalized light vector
        float3 lightVec = normalize(LightPos.xyz - vPos.xyz);
        OUT.Tex1.xyz  = mul(objToTangentSpace, lightVec);

        // compute view vector
        float3 viewVec = CameraPos.xyz - vPos.xyz;

        // compute half angle vector
        float3 halfAngleVector = lightVec.xyz + normalize(viewVec);
        OUT.Tex2.xyz = normalize(mul(objToTangentSpace, halfAngleVector));
        
        float2 vRadius = float2(1, 1); //IN.TexCoord0.xy;
        float2 vScale = float2(0.5, 0.5); //IN.TexCoord0.xy;
        vRadius.xy = vRadius.xy / (vRadius.xy + Modifiers.xx);
        OUT.Tex4.xy = vRadius.xy * vScale.xy * Modifiers.ww;
      }
