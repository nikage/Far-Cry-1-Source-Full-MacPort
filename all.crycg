////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCTreeSprites.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float3 color = HDREncode(decalColor.xyz * IN.Color.xyz);
        color.xyz = HDRFogBlend(color.xyz, IN.Color.w, GlobalFogColor.xyz);

        // finally add them all together
        OUT.Color.xyz = color.xyz;
        OUT.Color.w = decalColor.w * IN.Color.w;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCTreeSprites_FV.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D fogMap : texunit1,
                  uniform sampler2D fogEnterMap : texunit2,
                  uniform float4 FogColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex1.xy);
        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex2.xy);

        float3 color = HDREncode(decalColor.xyz * IN.Color.xyz);
        float fog = fogColor.a * fogEnterColor.a;
        color.xyz = HDREncodeAmb(FogColor.xyz)*fog + color.xyz*(1-fog);

        // finally add them all together
        OUT.Color.xyz = color.xyz;
        OUT.Color.w = decalColor.w * IN.Color.w;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCWater.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      //PS20Only
      
      MainInput { uniform sampler2D bumpMap : texunit0,
                  uniform sampler2D envMap : texunit1,
                  uniform sampler2D fresnelMap : texunit2,
                  uniform sampler2D baseMap : texunit3,
                  uniform float4 Matrix,
                  uniform float4 ReflectAmount,
                  uniform float4 WaterColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);

# ifdef _PS_1_1
        float4 env = offsettex2D(envMap, IN.Tex1.xy, bumpColor, Matrix);
# else
        float2 newst = IN.Tex1.xy / IN.Tex1.w;
        newst.xy = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
        float4 env = tex2D(envMap, newst.xy);
# endif        
        float4 fresnelColor = tex2D(fresnelMap, IN.Tex2.xy);
        float4 baseColor = tex2D(baseMap, IN.Tex3.xy);

        float3 color = lerp(HDREncodeAmb(baseColor.xyz), env.xyz, ReflectAmount.xyz);
        
        OUT.Color.xyz = HDRFogBlend(color.xyz, IN.Color1.w, GlobalFogColor.xyz);
        float fTransp = fresnelColor.b + (baseColor.b-0.5);
                
        OUT.Color.a = IN.Color.a*ReflectAmount.a * fTransp;
      }
      
////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCWaterReflectCMap.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////



      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D bumpMap : texunit0,
                  uniform samplerCUBE envMap : texunit3,
                  uniform float4 WaterColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
# ifdef _PS_1_1
        float4 env = texCUBE_reflect_dp3x3(envMap, IN.Tex3, IN.Tex1, IN.Tex2, bumpColor);
# else
        float3 E = float3(IN.Tex1.w, IN.Tex2.w, IN.Tex3.w);
        float3 N = float3(dot(IN.Tex1.xyz, bumpColor.xyz),
                          dot(IN.Tex2.xyz, bumpColor.xyz),
                          dot(IN.Tex3.xyz, bumpColor.xyz));
        float3 env = texCUBE(envMap, 2*(dot(N, E)/dot(N, N))*N - E);
# endif        
        
        OUT.Color.xyz = lerp(env.xyz, WaterColor.xyz, IN.Color1.xyz);
        OUT.Color.a = IN.Color.a * WaterColor.a;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCWaterRipples.crycg
//  Version:     v1.00
//  Created:     19/03/2004 by Tiago Sousa.
//  Compilers:   CG/HLSL
//  Description: Water ripples effect
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////

#include "../CGVPMacro.csi"

MainInput { uniform sampler2D bumpMask : texunit0, 
            uniform sampler2D bumpMap : texunit1,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit2, 
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit2,
#endif
            uniform float4 Matrix
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
    OUT_C0
  };

  FOUT
}

CoreScript
{
  // fetch mask/bump/refraction maps  
  float4 maskColor = tex2D(bumpMask, IN.Tex0.xy);
  float4 bumpColor = tex2D(bumpMap, IN.Tex1.xy);

#ifdef D3D
  #ifdef PROFILE_PS_1_1 
    float4 refrColor = offsettex2D(refMap, IN.Tex2.xy, bumpColor, Matrix); 
  #endif
  #ifdef OTHER
    newst = IN.Tex2.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = tex2D(refMap, newst);
  #endif
#endif

#ifdef OPENGL
  #ifdef PROFILE_PS_1_1 
    float4 refrColor = offsettexRECT(refMap, IN.Tex2.xy, bumpColor, Matrix);
    
  #endif
  #ifdef OTHER
    float2 newst = IN.Tex2.xy / IN.Tex1.w;
    newst = newst + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = texRECT(refMap, newst);
  #endif    
#endif

  OUT.Color.xyz =2*refrColor*0.52;
  OUT.Color.w= maskColor.w; //*IN.Color.w;
}
// ===============================================================
// Fragment Program: water tank
// Description: water in "tank" effect
// Last Update: 24/06/2004
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

PS20Only

MainInput 
{ 
    uniform sampler2D baseMap : register(s0),
    uniform sampler2D refrMap : register(s1),
    uniform sampler2D envMap : register(s2),
    uniform float4 Matrix,
    uniform float4 Ambient,
    uniform float4 Diffuse
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
      OUT_T2
      OUT_T3
      OUT_T4
      OUT_C0
    };

    FOUT
}

CoreScript
{   
    float4 bumpColorA = tex2D(baseMap, IN.Tex0.xy);
    float4 bumpColorB = tex2D(baseMap, IN.Tex0.zw);
    float4 bumpColor = (bumpColorA*0.5+bumpColorB*0.5);

    const float2 vScale=float2(0.01, 0.01);
    float2 vNewUv= (IN.Tex1.xy/IN.Tex1.w) + vScale.xy*bumpColor.xy;
    float4 refrColor = tex2D(refrMap, vNewUv);
    
    // compute illumination
    float3 vAmbient=(Ambient.xyz+Ambient.xyz*saturate(dot(normalize(IN.Tex3.xyz), bumpColor.xyz)));    
    float3 vDiffuse=saturate(dot(normalize(IN.Tex4.xyz), bumpColor.xyz))*Diffuse.xyz*IN.Color.w;
    float3 vIllum=saturate(vAmbient*0.25+vDiffuse*0.75);

    float3 vView=normalize(IN.Tex3.xyz);
    float3 vNormal=normalize(IN.Tex4.xyz);

    // compute per-pixel reflection vector for enviromental bump mapping
    float fReflDot= dot(vView.xyz, vNormal.xyz);  
    float3 reflVector =(2.0*vNormal.xyz*fReflDot-vView.xyz);  
    float2 vEnvUV= (reflVector.xy+1.0)*0.5+ Matrix.xw * bumpColor.xy;

    float4 envColor = tex2D(envMap, vEnvUV.xy);
    envColor*=envColor;
//    envColor*=envColor;

    OUT.Color.xyz =(envColor+refrColor)*Diffuse.xyz; //float3(0.0, 0.8, 0.5);//envColor.xyz*vDiffuse.xyz+refrColor.xyz*Ambient.xyz; //*0.8+vIllum*0.2;
    OUT.Color.a = 1; 
}////////////////////////////////////////////////////////////////////////////
//
