#include "../CGVPMacro.csi"

PS20Only

MainInput 
{
  uniform samplerCUBE reflMap : texunit0,
  uniform sampler2D baseMap : texunit1
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
    OUT_C1
  };

  FOUT
}

CoreScript
{
  float3 vRefl = texCUBE(reflMap, IN.Tex0.xyz).xyz * IN.Color.xyz + IN.Color1.xyz;
  float4 vBase = tex2D(baseMap, IN.Tex1.xy);
  float4 vColor;
  vColor.xyz = HDREncodeAmb(vRefl.xyz + vBase.xyz - 0.5);
  vColor.a = vBase.a * IN.Color.a;

  OUT.Color = vColor;
}


#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0,
  uniform FLOAT4 vSampleOffsets[4]
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  FLOAT fResampleSum = 0.0f;
  
  for(int i=0; i<4; i++)
  {
    // Compute the sum of luminance throughout the sample points
    FLOAT4 vTex = tex2D(baseMap, IN.Tex0.xy+vSampleOffsets[i].xy);
    fResampleSum += vTex;
  }
  
  // Divide the sum to complete the average, and perform an exp() to complete
  // the average luminance calculation
  fResampleSum = exp(fResampleSum/4);
    

  OUT.Color = float4(fResampleSum, fResampleSum, fResampleSum, 1.0f);
}


