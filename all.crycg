      #include "../CGVPMacro.csi"

      DefaultPos

      VertAttributes { POSITION_3 TEXCOORD0_2 }
      
      MainInput { VIEWPROJ_MATRIX }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon
