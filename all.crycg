////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCDofFocalDistNoUV.crycg
//  Version:     v1.00
//  Created:     16/03/2004 by Tiago Sousa.
//  Compilers:   CG/HLSL
//  Description: for depth of field, outputs focal distance
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////

#include "../CGVPMacro.csi"

PS20Only
NoFog

MainInput 
{
    uniform sampler2D ScreenMap : texunit0,
    uniform float4    DofFocalParams
}

DeclarationsScript
{
    struct vertout
    {
      OUT_P
      OUT_T0      
    };

    FOUT
}

CoreScript
{	
	// get max scale
	const float fDistanceScale=1.0/2048.0;
	
	float fFocus=saturate(DofFocalParams.x*fDistanceScale);
	float fRange=1/(DofFocalParams.y*fDistanceScale);
		
	// compute pixel depth
	float fDepth=saturate(fDistanceScale*IN.Tex0.w);
	// compute pixel focal distance
	float fFocalDist=saturate(fRange*abs(fFocus-fDepth));	
	
    OUT.Color.xyz =fFocalDist;    
    OUT.Color.w = 1;
}
