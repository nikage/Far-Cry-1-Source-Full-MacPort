      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, uniform float4 Modifiers }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_C0
        };

      }
      PositionScript = PosFur

      CoreScript
      {
        OUT.Tex0 = IN.TexCoord0;

        // Simple light calculations (L dot N)
        // Diffuse color
        float3 cDiffuse = float3(1, 1, 1);
        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);
        float fDiffuse = dot(vLightDir, IN.Normal.xyz);
        OUT.Color.xyz = cDiffuse * fDiffuse;

        // Here we set the diffuse alpha component
        OUT.Color.w = Modifiers.y;
      }
    
#include "../CGVPMacro.csi"

VertAttributes 
{ 
  POSITION_3 
  TEXCOORD0_2 
  TANG_3X3 
}

MainInput 
{ 
  VIEWPROJ_MATRIX, 
  CAMERA_POS 
}

DeclarationsScript
{
  struct appin
  {
    IN_P
    IN_T0
    IN_TANG
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_T1_2
    OUT_T2
  };

}

PositionScript = PosCommon

CoreScript
{
  OUT.Tex0.xy = IN.TexCoord0.xy;
  OUT.Tex1.xy = IN.TexCoord0.xy;

  TANG_MATR

  float3 lightVec = CameraPos.xyz - vPos.xyz;
  OUT.Tex2.xyz = mul(objToTangentSpace, lightVec.xyz);
}
