        // normalize view vector
        half3 dif = (decalColor.xyz * fDif * Diffuse.xyz) * 2;
        half3 amb = Ambient.xyz * decalColor.xyz;
        half3 spec = (fSpec * Specular.xyz * glossColor.xyz) * 2;

