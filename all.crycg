      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE envMap : texunit1 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);

        float3 col = (envColor.xyz * decalColor.a + decalColor.xyz) * IN.Color.xyz + IN.Color1.xyz;
        col = HDREncodeAmb(col.xyz);

        // finally add them all together
        OUT.Color.xyz = col;
        OUT.Color.w = IN.Color.a;
      }

////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCReflCMDecal_ReflAmountOpacity.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D opacityMap : texunit1,
                  uniform samplerCUBE envMap : texunit2 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 envColor = texCUBE(envMap, IN.Tex2.xyz);
        float4 opColor = tex2D(opacityMap, IN.Tex1.xy);

        float3 col = (envColor.xyz * opColor.xyz + decalColor.xyz) * IN.Color.xyz + IN.Color1.xyz;
        col = HDREncodeAmb(col.xyz);

        // finally add them all together
        OUT.Color.xyz = col;
        OUT.Color.w = IN.Color.a;
      }

      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE envMap : texunit1,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);

        float3 col = (envColor.xyz * (1-Diffuse.xyz)) + (decalColor.xyz * Diffuse.xyz);
        col = HDREncodeAmb(col.xyz);

        // finally add them all together
        OUT.Color.xyz = HDRFogBlend(col.xyz, IN.Color.w, GlobalFogColor.xyz);
        OUT.Color.w = decalColor.a * Diffuse.a;
      }

// ===============================================================
// Fragment Program: refractive
// Description: used for general refractive geometry 
// Last Update: 2/10/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit1, 
            //uniform sampler2D refMap : texunit1,
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit1,
#endif  
            uniform float4 Matrix,
            uniform float4 Amount,
            uniform float4 RefrColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
  };

  FOUT
}

CoreScript
{
  // load the decal  
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
                
// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...
#ifdef D3D
  # ifdef _PS_1_1
    float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);                 // get env bump map   
  # else
        float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
        float4 refrColor = tex2D(refMap, newst);
  # endif                
#endif

#ifdef OPENGL
      //float4 refrColor = tex2D(refMap, IN.Tex1.xy);
  # ifdef _PS_1_1
      float4 refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);                 // get env bump map   
  # else
    float2 newst = IN.Tex1.xy / IN.Tex1.w;
    newst = newst + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = texRECT(refMap, newst);
  # endif
#endif           
              
  OUT.Color.xyz = refrColor.xyz*RefrColor.xyz;
  OUT.Color.w= Amount.w;  
}// ===============================================================
// Fragment Program: refractive overlay
// Description: used for general refractive geometry 
// Last Update: 2/10/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D decalMap : texunit0,
            uniform sampler2D bumpMap : texunit1,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit2, 
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit2,
#endif              
            uniform float4 Matrix,
            uniform float4 Amount,
            uniform float4 RefrColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
  };

  FOUT
}

CoreScript
{
  // load the decal  
  float4 decalColor = tex2D(decalMap, IN.Tex0.xy); 
  float4 bumpColor = tex2D(bumpMap, IN.Tex1.xy);
                
// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...
#ifdef D3D
  #ifdef PROFILE_PS_1_1 
    float4 refrColor = offsettex2D(refMap, IN.Tex2.xy, bumpColor, Matrix);                 // get env bump map   
  #endif
  #ifdef OTHER
        float2 newst = IN.Tex2.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
        float4 refrColor = tex2D(refMap, newst);
  #endif                
#endif

#ifdef OPENGL
  #ifdef PROFILE_PS_1_1 
      float4 refrColor = offsettexRECT(refMap, IN.Tex2.xy, bumpColor, Matrix);                 // get env bump map   
  #endif
  #ifdef OTHER
    float2 newst = IN.Tex2.xy / IN.Tex2.w;
    newst = newst + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = texRECT(refMap, newst);
  #endif
#endif           
              
  OUT.Color.xyz = RefrColor.xyz*lerp(decalColor.xyz, refrColor.xyz, RefrColor.w);  
  OUT.Color.w= Amount.w;  
}// ===============================================================
// Fragment Program: Advanced post processing
// Description: image post processing
// Last Update: 27/05/2004
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

PS20Only
NoFog

MainInput 
{ 
#ifdef OPENGL
    uniform samplerRECT ScreenTex : texunit0,
    uniform samplerRECT GlareTex : texunit1,
    uniform samplerRECT ScreenBluredTex : texunit2,
#endif
#ifdef D3D
    uniform sampler2D ScreenTex : register(s0),
    uniform sampler2D GlareTex : register(s1),
    uniform sampler2D ScreenBluredTex : register(s2),
#endif
    uniform float4    vParams01,
    uniform float4    vParams02,
    uniform float4    vCMYKParams
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
  };

  FOUT
}

SubrScript
{
    // Convert from a RGB color space to CMYK color space
    float4 RGBToCMKY(float3 vColor)
    {
        float4 vCMYK;
        vCMYK.xyz=saturate(1-vColor.xyz);                         // Convert 1st to CMY= 1-RGB
        vCMYK.w=min(vCMYK.x, min(vCMYK.y, vCMYK.z));    // Compute K = min(C, M, Y) 
        vCMYK.xyz=saturate(vCMYK.xyz-vCMYK.www);                  // Compute final CMYK= CMY-K        
        
        return vCMYK;    
    }

    // Convert from a CMYK color space to RGB color space
    float3 CMKYToRGB(float4 vColor)
    {
        return saturate(1-(vColor.xyz+vColor.www));
    }
}
      
CoreScript
{         
#ifdef OPENGL
    // get screen
    float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);
    // get glare map
    float4 fGlareColor  = texRECT(GlareTex, IN.Tex1.xy);
    // get blured screen
    float4 fBluredScreenColor = texRECT(ScreenBluredTex, IN.Tex2.xy);
#endif
#ifdef D3D
    // get screen
    float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);
    // get glare map
    float4 fGlareColor  = tex2D(GlareTex, IN.Tex1.xy);
    // get blured screen
    float4 fBluredScreenColor = tex2D(ScreenBluredTex, IN.Tex2.xy);
#endif

    //const float4 vParams01=float4(1.2, 1.2, 0.1, 1.0); // x= contrast, y= saturation, z= brightness, w= glare intensity
    //const float4 vParams02=float4(0.0, 0.0, 1.5, 1.0); // xy= not used, z= sharpness amount, w= gamma adjust
    //const float4 vCMYKParams=float4(0.0, 0.0, 0.0, 0.0); // x= cyan, y= magenta, z= yellow, w= luminance
            
    fGlareColor*=vParams01.w;   // Adjust glare intensity
    fScreenColor.xyz=fScreenColor.xyz*vParams02.z+fBluredScreenColor.xyz*(1-vParams02.z); // Adjust image sharpeness
    
    // Add glare to scene
    float3 vLum=dot(fScreenColor.xyz, float3(0.3, 0.59, 0.11));                
    float3 vFinalComposing=saturate(fScreenColor.xyz + fGlareColor.xyz - fScreenColor.xyz*fGlareColor.xyz);
    
    // Convert color to CMYK model.
    // Tests: Incresing RED, decreases red component, decreasing red, increases red component..
    float4 vCMYK=RGBToCMKY(vFinalComposing.xyz);
    vCMYK=saturate(vCMYK+vCMYKParams); // adjust Cyans/Magentas/Yellows/Luminance                    
    vFinalComposing.xyz=CMKYToRGB(vCMYK);
    
    float3 vSaturationFinal=saturate(vFinalComposing.xyz*vParams01.y+vLum.xxx*(1-vParams01.y)); // Ajust image saturation
    float3 vContrastFinal=saturate(vSaturationFinal.xyz*vParams01.x+0.5*(1-vParams01.x)); // Ajust image contrast
    float3 vBrightnessFinal=saturate(vContrastFinal.xyz+vParams01.zzz); // Ajust image brightness
    float3 vGammaFinal=saturate(pow(vBrightnessFinal.xyz, vParams02.w)); // Ajust image gamma                                    
               
    OUT.Color.xyz =vGammaFinal.xyz; //vGammaFinal.xyz;  
    OUT.Color.w=1;
}

// ==================================================================
// Fragment Program: Cold render mode
// Description: glare/contrast/saturation + unsharp filter adjustment
// Last Update: 04/01/2004
// Coder: Tiago Sousa
// ==================================================================

#include "../CGVPMacro.csi"

MainInput 
{ 
#ifdef OPENGL
    uniform samplerRECT ScreenTex : texunit0,
    uniform samplerRECT ScreenBluredTex : texunit1
#endif
#ifdef D3D
    uniform sampler2D ScreenTex : texunit0,
    uniform sampler2D ScreenBluredTex : texunit1
#endif
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
    };

    FOUT
}

CoreScript
{     
#ifdef OPENGL
    // get screen
    float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);
    // get screen blured map
    float4 fScreenColorBlured = texRECT(ScreenBluredTex, IN.Tex1.xy);
#endif    
#ifdef D3D
    // get screen
    float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);
    // get screen blured map
    float4 fScreenColorBlured = tex2D(ScreenBluredTex, IN.Tex1.xy);
#endif
         
    // ## unsharp and add contrast to image a bit ##
    float3 vUnsharpMask=2*saturate(fScreenColor.xyz*0.75-fScreenColorBlured.xyz*0.3);     
                                    
    OUT.Color.xyz = vUnsharpMask.xyz;  
    OUT.Color.a   = 1;
}////////////////////////////////////////////////////////////////////////////
