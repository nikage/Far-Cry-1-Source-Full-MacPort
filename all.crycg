      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D sunMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Sun }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the decal
        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);
        float3 colorS = sunColor.xyz * IN.Color.a * Ambient.xyz * Sun.a;
        color.xyz = colorS;
        color.a = decalColor.a * Ambient.a;
        OUT.Color = color;
      }
      
////////////////////////////////////////////////////////////////////////////
//
//  Crytek Engine Source File.
//  Fragment Program
//  Copyright (C), Crytek Studios, 2001-2004.
// -------------------------------------------------------------------------
//  File name:   CGRCPlants_SunRabbits.crycg
//  Version:     v1.00
//  Created:     11/2/2004 by Andrey Honich.
//  Compilers:   CG/HLSL
//  Description: 
// -------------------------------------------------------------------------
//  History:
//
////////////////////////////////////////////////////////////////////////////


      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D sunMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the decal
        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);
        
        float4 color = decalColor * Ambient;
        color.xyz = HDREncode(color.xyz * IN.Color.xyz);
        float3 colorSun = HDREncodeAmb(sunColor.xyz) * IN.Color.a * Ambient.xyz * Diffuse.a;
        color.xyz = HDRFogBlend(color.xyz + colorSun.xyz, IN.Color.w, GlobalFogColor.xyz);
        
        OUT.Color = color;
      }
      

