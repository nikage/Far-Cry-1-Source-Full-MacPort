command script import /tmp/farcry_mouse_diag.py

# Confirm CMacOSMouse::Update runs and produces non-zero virtual coordinates
breakpoint set --name "CMacOSMouse::Update" --shlib libCryInput.dylib --one-shot true
breakpoint command add --python-function farcry_mouse_diag.diag_mouse_update 1

# Confirm CUISystem::Update sees the real cursor position
breakpoint set --name "CUISystem::Update" --shlib libCryGame.dylib --one-shot true
breakpoint command add --python-function farcry_mouse_diag.diag_ui_update 2

process launch
