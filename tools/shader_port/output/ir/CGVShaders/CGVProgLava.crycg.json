    {
      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n  uniform float4   CameraPos,  \r\n  uniform float4   Constants,\r\n  uniform float4   NoisePos,\r\n  uniform float4   TexGenRipple0,\r\n  uniform float4   TexGenRipple1,\r\n  uniform float4   TexShiftRipple,\r\n  uniform float4   TexDetailScale,\r\n  uniform float4   BumpMatrix,\r\n  uniform float4   DetailTexParams,\r\n  uniform float4 pg[66] : register(c30)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2_2\r\n    OUT_C0\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": " \r\n\r\n  float2 vTex;\r\n  vTex.x = dot(vPos, TexGenRipple0);\r\n  vTex.y = dot(vPos, TexGenRipple1);\r\n  vTex.xy= (vTex.xy+(TexShiftRipple.zw*TexShiftRipple.xy))*TexDetailScale.xy;\r\n\r\n  // output texture coordinates  \r\n  OUT.Tex1.xy = vTex.xy;\r\n  \r\n  vTex.x = dot(vPos, TexGenRipple0);\r\n  vTex.y = dot(vPos, TexGenRipple1);\r\n  vTex.xy= (vTex.xy-(TexShiftRipple.zw*TexShiftRipple.xy*5))*TexDetailScale.xy;\r\n  OUT.Tex2.xy = vTex.xy;\r\n  OUT.Tex0.xy = (IN.TexCoord0.xy+DetailTexParams.zw*TexShiftRipple.zw)*DetailTexParams.xy;\r\n\r\n# ifdef _HDR\r\n  float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n  OUT.Color.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif          \r\n     \r\n  return OUT;"
    }
  ],
