    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, uniform float4x4 ObjMatrix"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_T5\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n        TANG_MATR\r\n\r\n        // store light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex2.xyz = mul(objToTangentSpace, lightVec.xyz);\r\n\r\n        // store view vector\r\n        float4 viewVec;\r\n        viewVec.xyz = CameraPos.xyz - vPos.xyz;\r\n        viewVec.w = vPos.w;\r\n        // transform view vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex3.xyz = mul(objToTangentSpace, viewVec.xyz);\r\n        \r\n        OUT.Tex4.xyz = vPos.xyz;\r\n        OUT.Tex5 = mul(ObjMatrix, viewVec);"
    }
  ],
