      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n  // texture size in xy\r\n  uniform float4   TexSize,\r\n  // textures scales for each stage, in components\r\n  uniform float4   TexScale"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2_2\r\n    OUT_T3_2\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "  \r\n\r\n//  OUT.Tex0.xy = IN.TexCoord0.xy;\r\n//  OUT.Tex1.xy = IN.TexCoord0.xy;\r\n//  OUT.Tex2.xy = IN.TexCoord0.xy;\r\n//  OUT.Tex3.xy = IN.TexCoord0.xy;\r\n\r\n  // output texture coordinates  \r\n  OUT.Tex0.xy = (IN.TexCoord0.xy*TexSize.xy - 0.5*TexSize.xy)*TexScale.x + 0.5*TexSize.xy;\r\n  OUT.Tex1.xy = (IN.TexCoord0.xy*TexSize.xy - 0.5*TexSize.xy)*TexScale.y + 0.5*TexSize.xy;\r\n  OUT.Tex2.xy = (IN.TexCoord0.xy*TexSize.xy - 0.5*TexSize.xy)*TexScale.z + 0.5*TexSize.xy;\r\n  OUT.Tex3.xy =(IN.TexCoord0.xy*TexSize.xy - 0.5*TexSize.xy)*TexScale.w + 0.5*TexSize.xy;\r\n\r\n  return OUT;"
    }
  ],
