  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " uniform float4x4 ModelViewProj, uniform float4 LightPos, uniform float4 CameraPos, uniform float4 AttenInfo"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "SubrScript",
      "content": "\r\n        // returns light distance\r\n        float ComputeLightVectors(\r\n            out float3 lightDir, \r\n            out float3 viewDir, \r\n            out float3 halfVec, \r\n            float3 vertPos, float3 lightPos, float3 camPos) \r\n        {\r\n\t        // find the light distance and normalized light direction\r\n\t        lightDir = lightPos-vertPos;\r\n\t        float lightDist = length(lightDir);\r\n\t        lightDir /= lightDist; // normalize\r\n\r\n\t        // find the view distance and normalized view direction\r\n\t        viewDir = normalize(camPos-vertPos);\r\n\r\n\t        // find the half-angle vector\r\n\t        halfVec = normalize(viewDir+lightDir);\r\n\r\n          return lightDist;\r\n        }"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        TANG_MATR\r\n\r\n        // compute lighting vectors\r\n        float3 LightDirection, ViewDirection, HalfVector;\r\n        float LightDistance = ComputeLightVectors(LightDirection, ViewDirection, HalfVector, vPos.xyz, LightPos.xyz, CameraPos.xyz);\r\n    \r\n        // transform the light direction to tangent space\r\n        OUT.Tex2.xyz = normalize(mul(objToTangentSpace, LightDirection)).xyzz;\r\n\r\n        // transform the half vector to tangent space\r\n        float3 halfVecTangent = normalize(mul(objToTangentSpace, HalfVector)).xyz;\r\n\r\n\t      // compute light attenuation\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        float fiSqDist = rsqrt(dot(lightVec, lightVec));        \r\n        OUT.Color.w = (AttenInfo.x - 1/fiSqDist) * AttenInfo.y;\r\n\r\n\t      // copy the texcoord over (duplicate for the bump map, also).\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n        // Set up texcoords for texm3x2tex to get specular\r\n        OUT.Tex3.xyz = halfVecTangent.xyzz;"
    }
  ],
