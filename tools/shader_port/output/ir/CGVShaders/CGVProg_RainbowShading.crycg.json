    {
      "name": "CoreScript",
      "content": "\r\n        float3 vEyeDir = normalize(CameraPos.xyz - vPos.xyz);\r\n        float3 vHalf = normalize(vEyeDir.xyz + IN.Normal.xyz);\r\n        OUT.Tex0.x = dot(IN.Normal.xyz, vEyeDir);\r\n        OUT.Tex0.y = dot(IN.Normal.xyz, vHalf);\r\n\r\n        OUT.Tex1.x = vEyeDir.x;\r\n        OUT.Tex1.y = vHalf.y;"
    }
