    },
    {
      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n  uniform float4   CameraPos,  \r\n  uniform float4   TexGenRipple0,\r\n  uniform float4   TexGenRipple1,\r\n  uniform float4   TexShiftRipple,\r\n  uniform float4   TexDetailScale,\r\n  uniform float4   TexMovSpeed,\r\n  uniform float4   ScreenSize"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_C0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2_2\r\n    OUT_C0\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  float4 vHPos = mul(ModelViewProj, vPos);                                    \r\n\r\n  // output texture coordinates       \r\n#ifdef OPENGL  \r\n\tOUT.Tex2.xy = (vHPos.xy/vHPos.w  + 1)*0.5*ScreenSize.xy;    \t    \r\n#endif\r\n\r\n#ifdef D3D \r\n\tOUT.Tex2.x = (vHPos.x/vHPos.w  + 1)*0.5;    \t    \r\n\tOUT.Tex2.y = (-vHPos.y/vHPos.w  + 1)*0.5;    \t  \r\n#endif\r\n    \r\n  OUT.Tex0.xy =IN.TexCoord0.xy;\r\n  OUT.Tex1.xy =(IN.TexCoord0.xy+TexShiftRipple.xy*TexMovSpeed.xy)*TexDetailScale.xy;\r\n\r\n  // output particle transparency\r\n  OUT.Color.w = IN.Color.w;  \r\n  \r\n  return OUT;"
    }
  ],
