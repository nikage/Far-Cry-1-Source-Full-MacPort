    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_T1\r\n          IN_TN\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2_2\r\n          OUT_T3_2\r\n          OUT_T4\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n        OUT.Tex2.xy = IN.TexCoord1.xy;\r\n        OUT.Tex3.xy = IN.TexCoord1.xy;\r\n\r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n        float3 tCamVec = normalize(vVec);\r\n        float3 tNormal = IN.TNormal.xyz;\r\n        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;\r\n        float4 tRM;\r\n        tRM.xyz = tRef.xyz;\r\n        tRM.w = vPos.w;\r\n        OUT.Tex4 = mul(tRM, TexMatrix);"
    }
  ],
