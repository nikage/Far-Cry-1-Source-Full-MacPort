      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4x4 ShadowTexGen, uniform float4 ObjPos, uniform float4 ObjColor"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 vtex = mul(ShadowTexGen, vPos);\r\n        OUT.Tex1 = vtex;\r\n        OUT.Tex0.x = dot(BaseTexGen0, vPos);          \r\n        OUT.Tex0.y = dot(BaseTexGen1, vPos);          \r\n        float fBright = min(1, length(vPos.xyz - ObjPos.xyz) * ObjColor.w);\r\n        float3 vCol = ObjColor.xyz*(vPos.w-fBright) + fBright;\r\n        OUT.Color.xyz = IN.Color.www * vCol;\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
