      "name": "VertAttributes",
      "content": " POSITION_3 TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS, LIGHT_MATRIX, ATTEN"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        TANG_MATR\r\n\r\n        OUT.Tex0 = mul(LightMatrix, vPos);\r\n\r\n        // store normalized light vector\r\n        float3 lVec = LightPos.xyz - vPos.xyz;\r\n        float3 lightVec = mul(objToTangentSpace, lVec.xyz);\r\n        \r\n        float3 vDist = PROC_ATTENPIX;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex1.xyz = vDist;\r\n        OUT.Color.xyz = vDist;\r\n\r\n        float fiSqDist = rsqrt(dot(lVec, lVec));\r\n        float fAtten = sign(dot(lVec, IN.TNormal.xyz));\r\n        OUT.Color.a = max(0, fAtten);"
    }
  ],
