      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 vNormal = normalize(IN.Normal);\r\n        OUT.Tex0.xy = mul(TexGen, vPos);\r\n\r\n        float4 camVec = normalize(CameraPos - vPos);\r\n        float4 color = Color;\r\n        color.y = Color.y - dot(camVec, vNormal) * color.w;\r\n        OUT.Color.xyz = color.xyz * IN.Color.xyz;"
    }
