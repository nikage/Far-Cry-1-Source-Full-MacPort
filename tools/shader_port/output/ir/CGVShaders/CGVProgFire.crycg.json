  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  uniform float4x4 ModelViewProj,\r\n  uniform float4   CameraPos,  \r\n  uniform float4   Constants,\r\n  uniform float4   TexGenRipple0,\r\n  uniform float4   TexGenRipple1,\r\n  uniform float4   TexShiftRipple,\r\n  uniform float4   TexDetailScale,\r\n  uniform float4   BumpMatrix,\r\n  uniform float4   DetailTexParams"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_C0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_C0\r\n    OUT_C1\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": " \r\n  float2 vTranslation=DetailTexParams.zw*TexShiftRipple.zw;\r\n  // bump texture coordinates  \r\n  float3 vTex;\r\n  vTex.xy=(IN.TexCoord0.xy+vTranslation.xy)-0.5; \r\n  vTex.z=1;\r\n  \r\n  float fCos=cos(TexShiftRipple.z*100);\r\n  float fSin=sin(TexShiftRipple.z*100);\r\n  \r\n  float3x3 mRot;\r\n  mRot[0]=float3(fCos, -fSin, 0);\r\n  mRot[1]=float3(fSin,  fCos, 0);\r\n  mRot[2]=float3(   0,     0, 1);\r\n      \r\n  // rotate coordinates\r\n  vTex=mul(mRot, vTex);  \r\n  OUT.Tex0.xy = (vTex.xy+0.5)*DetailTexParams.xy;\r\n    \r\n  // output environment map texture coordinates  \r\n  OUT.Tex1.xy = IN.TexCoord0.xy;  \r\n  // output particle transparency\r\n  OUT.Color.w = IN.Color.w;                 \r\n\r\n# ifdef _HDR\r\n  float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n  OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif        \r\n\r\n  return OUT;"
    }
  ],
