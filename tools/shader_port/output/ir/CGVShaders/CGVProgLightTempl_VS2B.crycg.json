{
  "name": "CGVProgLightTempl_VS2B",
  "extension": "crycg",
  "path": "CGVShaders/CGVProgLightTempl_VS2B.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": "\r\n        POSITION_3\r\n        TANG_3X3\r\n        TEXCOORD0_2\r\n#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP\r\n        TEXCOORD1_2\r\n#endif"
    },
    {
      "name": "MainInput",
      "content": "\r\n        VIEWPROJ_MATRIX,\r\n    # ifdef _LIGHT0_TYPE\r\n        uniform float4 LightsPos[ _NUM_LIGHTS ] : register(c4),\r\n        uniform float4x4 LightMatrix : register(c10),\r\n    # endif\r\n\r\n#if %TEMP_AMBIENT\r\n  #if %ENVCMAMB\r\n        uniform float4x4 TexMatrix : register(c14),\r\n  #elif %TEMP_ENVLIGHT\r\n        uniform float4 EnvColors[6] : register(c14),\r\n        uniform float4x4 TexMatrix : register(c20),\r\n  #elif %ENVCMSPEC\r\n        uniform float4x4 ModelMatrix : register(c14),\r\n  #endif\r\n#endif  \r\n        uniform float4 CameraPos : register(c8),"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          float4 Position  : POSITION;\r\n          float4 baseTC    : TEXCOORD0;\r\n#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP\r\n          float4 lmTC      : TEXCOORD1;\r\n#endif\r\n          IN_TANGVECS\r\n        };\r\n        \r\n        struct vertout\r\n        {\r\n          float4 HPosition  : POSITION;\r\n          float2 baseTC     : TEXCOORDN;\r\n#if %BUMP_MAP          \r\n  #if !%TEMP_AMBIENT || !%ENVCMSPEC\r\n          float2 bumpTC     : TEXCOORDN;\r\n  #endif\r\n#endif\r\n            \r\n#if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA            \r\n  #if !%ENVCMSPEC && !%ENVCMAMB\r\n          float2 glossTC    : TEXCOORDN;\r\n  #endif\r\n#endif          \r\n\r\n#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP || %BUMP_ZCORRECT\r\n          float4 lmTC_ZW    : TEXCOORDN;\r\n#endif\r\n          float4 viewVec    : TEXCOORDN;\r\n\r\n#if %TEMP_AMBIENT\r\n  #if %ENVCMAMB\r\n          float4 envTC      : TEXCOORDN;\r\n  #elif %ENVCMSPEC\r\n          float4 tangVec    : TEXCOORDN;\r\n          float4 binormVec  : TEXCOORDN;\r\n          float4 normVec    : TEXCOORDN;\r\n  #endif\r\n#endif\r\n\r\n    # ifdef _LIGHT0_TYPE\r\n          float4 projTC      : TEXCOORDN;\r\n          float4 lightVec[ _NUM_LIGHTS ] : TEXCOORDN;          \r\n    # endif\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.baseTC.xy = IN.baseTC.xy;\r\n#if %BUMP_MAP\r\n  #if !%TEMP_AMBIENT || !%ENVCMSPEC\r\n        OUT.bumpTC.xy = IN.baseTC.xy;\r\n  #endif\r\n#endif\r\n  \r\n#if %TEMP_LM || %TEMP_DOT3LM || %TEMP_SPECULAR_OCCLUSIONMAP\r\n        OUT.lmTC_ZW.xy = IN.lmTC.xy;\r\n#endif\r\n#if %BUMP_ZCORRECT\r\n        OUT.lmTC_ZW.z = dot(ModelViewProj[2], vPos);\r\n        OUT.lmTC_ZW.w = dot(ModelViewProj[3], vPos);\r\n#endif\r\n\r\n#if %GLOSS_MAP || %SPECULARPOW_GLOSSALPHA            \r\n  #if !%ENVCMSPEC && !%ENVCMAMB\r\n        OUT.glossTC.xy = IN.baseTC.xy;\r\n  #endif\r\n#endif\r\n\r\n        TANG_MATR\r\n        \r\n        // 0 type = directional light source (no attenuation)\r\n        // 1 type = omni light source\r\n        // 2 type = projected light source\r\n    # ifdef _LIGHT0_TYPE\r\n        int aLType[ _NUM_LIGHTS ];\r\n        aLType[0] = _LIGHT0_TYPE;\r\n      # ifdef _LIGHT1_TYPE\r\n        aLType[1] = _LIGHT1_TYPE;\r\n      # endif\r\n      # ifdef _LIGHT2_TYPE\r\n        aLType[2] = _LIGHT2_TYPE;\r\n      # endif\r\n      # ifdef _LIGHT3_TYPE\r\n        aLType[3] = _LIGHT3_TYPE;\r\n      # endif\r\n        for (int i=0; i<_NUM_LIGHTS; i++)\r\n        {\r\n          float3 lVec = LightsPos[i].xyz - vPos.xyz;\r\n          float3 lightVec = mul(objToTangentSpace, lVec);          \r\n          float3 lVecO = lightVec.xyz;\r\n#ifdef RADEON\r\n#endif\r\n#ifdef OTHER\r\n          if (!aLType[i])\r\n            lVecO = lVecO * LightsPos[i].w;\r\n#endif          \r\n          OUT.lightVec[i].xyz = lVecO;\r\n          if (aLType[i] == 2)\r\n            OUT.projTC = mul(LightMatrix, vPos);\r\n        }\r\n    # endif\r\n          \r\n        // compute view vector\r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n        float3 viewVec = mul(objToTangentSpace, vVec.xyz);\r\n#ifdef RADEON\r\n#endif\r\n#ifdef OTHER\r\n        viewVec.xyz = viewVec.xyz * CameraPos.w;\r\n#endif        \r\n        OUT.viewVec.xyz = viewVec.xyz;\r\n\r\n#if %TEMP_AMBIENT\r\n  #if %TEMP_ENVLIGHT\r\n        // Calculate average radiosity color from 6 colors (Cube)\r\n        float3 tNormal;\r\n        tNormal = mul((float3x3)TexMatrix, IN.TNormal.xyz);\r\n        float3 Compare1 = step(tNormal, 0);\r\n        float3 Compare0 = 1 - Compare1;\r\n        float3 signN = sign(tNormal);\r\n        tNormal = tNormal * tNormal;\r\n        tNormal = tNormal * signN;\r\n        float4 ColorX = EnvColors[0]*tNormal.x*Compare0.x + EnvColors[1]*(-tNormal.x)*Compare1.x;\r\n        float4 ColorY = EnvColors[2]*tNormal.y*Compare0.y + EnvColors[3]*(-tNormal.y)*Compare1.y;\r\n        float4 ColorZ = EnvColors[4]*tNormal.z*Compare0.z + EnvColors[5]*(-tNormal.z)*Compare1.z;\r\n        OUT.Color1 = (ColorX + ColorY + ColorZ) * 2.0;\r\n  #elif %ENVCMAMB\r\n        float3 tCamVec = normalize(vVec);\r\n        float3 tNormal = IN.TNormal.xyz;\r\n        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;\r\n        float4 tRM;\r\n        tRM.xyz = tRef.xyz;\r\n        tRM.w = vPos.w;\r\n        OUT.envTC = mul(tRM, TexMatrix);\r\n  #elif %ENVCMSPEC    \r\n        float3 worldTangentS = mul((const float3x3)ModelMatrix, objToTangentSpace[0]);\r\n        float3 worldTangentT = mul((const float3x3)ModelMatrix, objToTangentSpace[1]);\r\n        float3 worldNormal   = mul((const float3x3)ModelMatrix, objToTangentSpace[2]);\r\n\r\n\t      OUT.tangVec.xyz = worldTangentS;\r\n\t      OUT.binormVec.xyz = worldTangentT;\r\n\t      OUT.normVec.xyz = worldNormal;\r\n  #endif\r\n#endif"
    }
  ],
