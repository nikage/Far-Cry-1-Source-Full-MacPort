    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": " \r\n        VIEWPROJ_MATRIX, \r\n        uniform float4 NoisePos, \r\n        CAMERA_POS, \r\n        LIGHT_POS,\r\n        ATTEN,\r\n        uniform float4 TexShiftRipple, \r\n        uniform float4 TexGenRipple0, \r\n        uniform float4 TexGenRipple1, \r\n        uniform float4 TexDetailScale, \r\n        uniform float4 WaterLevel, \r\n        uniform float4 BumpScale,\r\n        uniform float4x4 TexProjMatrix, \r\n        uniform float4 pg[66] : register(c30)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_T5\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // compute eye vector\r\n        float3 ViewVec=CameraPos.xyz-IN.Position.xyz;\r\n        float3 LightVec=LightPos.xyz-IN.Position.xyz;\r\n        \r\n        float fiSqDist = rsqrt(dot(ViewVec, ViewVec));\r\n        float fAtten = PROC_ATTENVERT;        \r\n        \r\n        float2 vAttenuation=float2(saturate(1-fAtten)*0.2+0.1, saturate(1-fAtten)*2);\r\n                        \r\n        // set the 3x3 tranform from tangent space to object space\r\n        float3x3 objToTangentSpace;\r\n        objToTangentSpace[0] = float3(0, -1, 0);\r\n        objToTangentSpace[1] = float3(1, 0, 0);\r\n        objToTangentSpace[2] = float3(0, 0, 1);              \r\n      \r\n        float2 vTex;\r\n        \r\n        float3 vEye=abs(vPos.xyz-CameraPos.xyz);\r\n        float fDist=sqrt(dot(vEye, vEye));\r\n        \r\n        // virtual map center...\r\n        float2 vMapCenter=float2(1024.0, 2048.0);\r\n        \r\n        // set translation to bump layers\r\n                \r\n                \r\n        float2 vTranslation=TexShiftRipple.xy%1;        \r\n        \r\n        vTex.xy= (vMapCenter.xy-vPos.xy)*0.0125;                \r\n        OUT.Tex0.xy = vTex.xy + vTranslation.xy*2.0;\r\n        \r\n        vTex.xy= (vMapCenter.xy-vPos.xy)*0.0085;        \r\n        OUT.Tex0.wz = vTex.xy - vTranslation.xy;                \r\n                                      \r\n        OUT.Tex4.xyz=mul(objToTangentSpace, ViewVec.xyz);                \r\n        OUT.Tex4.w=vAttenuation.x*1.5;        \r\n        \r\n        OUT.Tex5.xyz=mul(objToTangentSpace, LightVec.xyz);\r\n        OUT.Tex5.w=vAttenuation.y;        \r\n                \r\n        OUT.Tex3.xy = (vTex.xy + TexShiftRipple.xy) * TexDetailScale.xy;\r\n        \r\n       \r\n        //float4 vProjTex = mul(TexProjMatrix, vPos);\r\n        //vProjTex.xy = vProjTex.xy + fNoise * CameraPos.w;\r\n  \r\n        // optimized perspective correct projection\r\n        float4 vHPos = mul(ModelViewProj, vPos);\r\n        OUT.Tex1.x = (vHPos.x  + vHPos.w)*0.5;\r\n        OUT.Tex1.y = (vHPos.y  + vHPos.w)*0.5; // for reflection\r\n        OUT.Tex1.z = (-vHPos.y  + vHPos.w)*0.5; // for refraction\r\n        OUT.Tex1.w   = vHPos.w;  \r\n        \r\n        float3 eyeVec = normalize(CameraPos.xyz - vPos.xyz);\r\n                \r\n        OUT.Tex3.z=(eyeVec.z<0)?vHPos.w*0.1:vHPos.w*0.05;                \r\n        OUT.Tex2.xyz = (eyeVec.z<0)?1:TexProjMatrix[2]; //*0.5+0.5;\r\n        \r\n        OUT.Color = IN.Color;"
    }
  ],
