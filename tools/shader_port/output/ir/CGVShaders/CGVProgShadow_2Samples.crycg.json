    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2_2\r\n          OUT_T3\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 shadTC0 = mul(TexGen0, vPos);\r\n        OUT.Tex0 = shadTC0;\r\n        float4 shadTC1 = mul(TexGen1, vPos);\r\n        OUT.Tex1 = shadTC1;\r\n        OUT.Tex2.xy = IN.TexCoord0.xy;\r\n#ifdef D3D\r\n        float4 WTC = (float4)0;\r\n        WTC.w = 1;\r\n        WTC.z = shadTC0.w * 0.5 + 0.5;\r\n        WTC.y = shadTC1.w * 0.5 + 0.5;\r\n        OUT.Tex3 = WTC;\r\n#endif"
    }
  ],
