{
  "name": "CGVProgGlassDispersionCM",
  "extension": "crycg",
  "path": "CGVShaders/CGVProgGlassDispersionCM.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 NORMAL_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4x4 ObjMatrix, CAMERA_POS, uniform float4 Eta, uniform float4 Fresnel"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // transform normal\r\n        float3 normal;\r\n        normal.x = dot(IN.Normal.xyz, ObjMatrix._11_12_13);\r\n        normal.y = dot(IN.Normal.xyz, ObjMatrix._21_22_23);\r\n        normal.z = dot(IN.Normal.xyz, ObjMatrix._31_32_33);\r\n       \r\n        // calculate incident vector\r\n        float3 incidentVec = normalize(vPos.xyz - CameraPos.xyz);\r\n\r\n        // refraction function from Renderman spec\r\n        // I = incident direction, N = normal, eta = relative index of refraction\r\n        float IdotN = dot(incidentVec, normal);\r\n        float k = vPos.w - Eta.x*Eta.x*(vPos.w - IdotN*IdotN);\r\n        float3 result = Eta.x*incidentVec - (Eta.x*IdotN + sqrt(k))*normal;\r\n        OUT.Tex0.xyz = result.xyz;\r\n        OUT.Tex0.w = vPos.w;\r\n\r\n        k = vPos.w - Eta.y*Eta.y*(vPos.w - IdotN*IdotN);\r\n        result = Eta.y*incidentVec - (Eta.y*IdotN + sqrt(k))*normal;\r\n        OUT.Tex1.xyz = result.xyz;\r\n        OUT.Tex1.w = vPos.w;\r\n\r\n        k = vPos.w - Eta.z*Eta.z*(vPos.w - IdotN*IdotN);\r\n        result = Eta.z*incidentVec - (Eta.z*IdotN + sqrt(k))*normal;\r\n        OUT.Tex2.xyz = result.xyz;\r\n        OUT.Tex2.w = 0;\r\n\r\n        // calculate the fresnel reflection\r\n        OUT.Tex3.xyz = reflect(incidentVec, normal);\r\n        OUT.Tex3.w = vPos.w;\r\n\r\n        // fresnel approximation\r\n        float bias = Fresnel.z;\r\n        float scale = Fresnel.y;\r\n        float power = Fresnel.x;\r\n        OUT.Color.xyz = (bias + pow(vPos.w - dot(-incidentVec, normal), power) * scale).xxx;\r\n        OUT.Color.w = IN.Color.w;\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
