{
  "name": "CGVProgShadowTempl",
  "extension": "crycg",
  "path": "CGVShaders/CGVProgShadowTempl.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": "\r\n        POSITION_3\r\n        TEXCOORD0_2\r\n#if %ENVCMAMB || %TEMP_ENVLIGHT\r\n        TNORMAL_3\r\n#endif\r\n#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING\r\n        TANGENT_3\r\n        BINORMAL_3\r\n#endif"
    },
    {
      "name": "MainInput",
      "content": "\r\n        VIEWPROJ_MATRIX,\r\n        uniform float4x4 TexGen0,\r\n#if %TEMP_SHAD_SAMPLEMASK1\r\n        uniform float4x4 TexGen1,\r\n#endif\r\n#if %TEMP_SHAD_SAMPLEMASK2\r\n        uniform float4x4 TexGen2,\r\n#endif\r\n\r\n#if %TEMP_MIXED_MAP  \r\n        uniform float2x4 ShadowModelMatr0,\r\n  #if %TEMP_SHAD_SAMPLEMASK1\r\n        uniform float2x4 ShadowModelMatr1,\r\n  #endif\r\n  #if %TEMP_SHAD_SAMPLEMASK2\r\n        uniform float2x4 ShadowModelMatr2,\r\n  #endif\r\n        uniform float ShadowBias,\r\n        uniform float4 LightPos,\r\n#endif\r\n\r\n#if %TEMP_ENVLIGHT\r\n        uniform float4 EnvColors[6],\r\n        uniform float4x4 TexMatrix,\r\n#elif %ENVCMAMB\r\n        CAMERA_POS,\r\n        uniform float4x4 TexMatrix,\r\n#endif        \r\n\r\n#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING\r\n  #if !%ENVCMAMB\r\n        CAMERA_POS,\r\n  #endif\r\n#endif"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n#if %ENVCMAMB || %TEMP_ENVLIGHT || %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING\r\n          IN_TANG\r\n#endif\r\n        };\r\n\r\n        // define outputs from vertex shader\r\n        struct vertout\r\n        {\r\n          float4 HPosition  : POSITION;\r\n          float4 shadTC0     : TEXCOORDN;\r\n#if %TEMP_SHAD_SAMPLEMASK1\r\n          float4 shadTC1     : TEXCOORDN;\r\n#endif\r\n#if %TEMP_SHAD_SAMPLEMASK2\r\n          float4 shadTC2     : TEXCOORDN;\r\n#endif\r\n          float2 baseTC      : TEXCOORDN;\r\n\r\n#if %PERPIXEL_SHADOWMAP\r\n          float4 viewVec     : TEXCOORDN;\r\n          float4 Tangent     : TEXCOORDN;\r\n          float4 Binormal    : TEXCOORDN;\r\n#elif %OFFSETBUMPMAPPING\r\n          float4 viewVec     : TEXCOORDN;\r\n#endif\r\n\r\n#if %TEMP_MIXED_MAP\r\n          float4 depthTC0    : TEXCOORDN;\r\n  #if %TEMP_SHAD_SAMPLEMASK2\r\n          float4 depthTC1    : TEXCOORDN;\r\n  #endif\r\n          float4 lightVec    : TEXCOORDN;\r\n#endif\r\n\r\n#ifdef D3D\r\n  #if %TEMP_DEPTH_MAP || %TEMP_DEPTH_MAP_PS20\r\n          float4 WTC         : TEXCOORDN;\r\n  #endif\r\n#endif\r\n\r\n          float4 Color      : COLOR0;\r\n#if %ENVCMAMB\r\n          float4 envTC      : TEXCOORDN;\r\n#endif\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.baseTC.xy = IN.TexCoord0.xy;\r\n\r\n#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING\r\n        TANG_MATR\r\n\r\n        // compute view vector\r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n        float3 viewVec = mul(objToTangentSpace, vVec.xyz);\r\n        OUT.viewVec.xyz = viewVec.xyz;\r\n  #if %PERPIXEL_SHADOWMAP\r\n        OUT.Tangent.xyz = IN.Tangent.xyz;\r\n        OUT.Binormal.xyz = IN.Binormal.xyz;\r\n  #endif\r\n#endif\r\n\r\n        float4 shadTC0 = mul(TexGen0, vPos);          \r\n        OUT.shadTC0 = shadTC0;\r\n#if %TEMP_SHAD_SAMPLEMASK1\r\n        float4 shadTC1 = mul(TexGen1, vPos);\r\n        OUT.shadTC1 = shadTC1;\r\n#endif\r\n#if %TEMP_SHAD_SAMPLEMASK2\r\n        float4 shadTC2 = mul(TexGen2, vPos);\r\n        OUT.shadTC2 = shadTC2;\r\n#endif\r\n\r\n#ifdef D3D\r\n  #if %TEMP_DEPTH_MAP || %TEMP_DEPTH_MAP_PS20\r\n        float4 WTC = (float4)0;\r\n        WTC.w = 1;\r\n        WTC.z = shadTC0.w * 0.5 + 0.5;\r\n    #if %TEMP_SHAD_SAMPLEMASK1\r\n        WTC.y = shadTC1.w * 0.5 + 0.5;\r\n    #endif\r\n    #if %TEMP_SHAD_SAMPLEMASK2\r\n        WTC.x = shadTC2.w * 0.5 + 0.5;\r\n    #endif\r\n        OUT.WTC = WTC;\r\n  #endif\r\n#endif\r\n\r\n#if %TEMP_MIXED_MAP  \r\n        OUT.lightVec.xyz = LightPos.xyz - vPos.xyz;\r\n        \r\n        float fZ = dot(ShadowModelMatr0._11_12_13_14, vPos);\r\n        float fW = dot(ShadowModelMatr0._21_22_23_24, vPos);\r\n        OUT.depthTC0.x = fZ;\r\n        OUT.depthTC0.y = fW;\r\n\r\n    #if %TEMP_SHAD_SAMPLEMASK1\r\n        fZ = dot(ShadowModelMatr1._11_12_13_14, vPos);\r\n        fW = dot(ShadowModelMatr1._21_22_23_24, vPos);\r\n        OUT.depthTC0.z = fZ;\r\n        OUT.depthTC0.w = fW;\r\n    #endif\r\n\r\n    #if %TEMP_SHAD_SAMPLEMASK2\r\n        fZ = dot(ShadowModelMatr2._11_12_13_14, vPos);\r\n        fW = dot(ShadowModelMatr2._21_22_23_24, vPos);\r\n        OUT.depthTC1.x = fZ;\r\n        OUT.depthTC1.y = fW;\r\n    #endif\r\n#endif\r\n\r\n#if %TEMP_ENVLIGHT\r\n        // Calculate average radiosity color from 6 colors (Cube)\r\n        float3 tNormal;\r\n        tNormal = mul((float3x3)TexMatrix, IN.TNormal.xyz);        \r\n        float3 Compare1 = step(tNormal, 0);\r\n        float3 Compare0 = 1 - Compare1;\r\n        float3 signN = sign(tNormal);\r\n        tNormal = tNormal * tNormal;\r\n        tNormal = tNormal * signN;\r\n        float4 ColorX = EnvColors[0]*tNormal.x*Compare0.x + EnvColors[1]*(-tNormal.x)*Compare1.x;\r\n        float4 ColorY = EnvColors[2]*tNormal.y*Compare0.y + EnvColors[3]*(-tNormal.y)*Compare1.y;\r\n        float4 ColorZ = EnvColors[4]*tNormal.z*Compare0.z + EnvColors[5]*(-tNormal.z)*Compare1.z;\r\n        OUT.Color = (ColorX + ColorY + ColorZ) * 2.0;\r\n#elif %ENVCMAMB\r\n  #if !%PERPIXEL_SHADOWMAP && !%OFFSETBUMPMAPPING\r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n  #endif\r\n        float3 tCamVec = normalize(vVec);\r\n        float3 tNormal = IN.TNormal.xyz;\r\n        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;\r\n        float4 tRM;\r\n        tRM.xyz = tRef.xyz;\r\n        tRM.w = vPos.w;\r\n        OUT.envTC = mul(tRM, TexMatrix);\r\n #if %ENVCM_MASKED\r\n        OUT.baseTC.zw = IN.TexCoord0.xy;\r\n #endif  \r\n#endif\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
