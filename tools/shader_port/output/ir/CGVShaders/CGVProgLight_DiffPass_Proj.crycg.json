    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n\r\n        // store normalized light vector\r\n        float3 lVec = LightPos.xyz - vPos.xyz;\r\n        float fiSqDist = rsqrt(dot(lVec, lVec));        \r\n        OUT.Color.xyz = PROC_ATTENVERT;\r\n\r\n        TANG_MATR\r\n\r\n        float3 lightVec = mul(objToTangentSpace, lVec);\r\n        OUT.Tex1.xyz = lightVec.xyz;\r\n        \r\n        OUT.Tex2 = mul(LightMatrix, vPos);"
    }
  ],
