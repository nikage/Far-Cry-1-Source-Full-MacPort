      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n\r\n  // texture offsets\r\n  uniform float4 vTexCoordScale01,\r\n  uniform float4 vTexCoordScale02,\r\n  uniform float4 vTexCoordScale03,\r\n  uniform float4 vTexCoordScale04"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2_2\r\n    OUT_T3_2\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\r\n  // output texture coordinates\r\n  OUT.Tex0.xy = (IN.TexCoord0.xy+vTexCoordScale01.zw)*vTexCoordScale01.xy;\r\n  OUT.Tex1.xy = (IN.TexCoord0.xy+vTexCoordScale02.zw)*vTexCoordScale02.xy;\r\n  OUT.Tex2.xy = (IN.TexCoord0.xy+vTexCoordScale03.zw)*vTexCoordScale03.xy;\r\n  OUT.Tex3.xy = (IN.TexCoord0.xy+vTexCoordScale04.zw)*vTexCoordScale04.xy;\r\n    \r\n  return OUT;"
    }
  ],
