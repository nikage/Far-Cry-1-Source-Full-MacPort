      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 vNormal = normalize(IN.Normal);\r\n\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n\r\n        float3 camVec = normalize(CameraPos - vPos);\r\n        float4 color = Color;\r\n        float fDot = dot(camVec.xyz, vNormal.xyz);\r\n        color.w = fDot * Constants.x + color.w;\r\n        OUT.Color = color;"
    }
