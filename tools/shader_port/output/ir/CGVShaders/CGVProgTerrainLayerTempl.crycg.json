{
  "name": "CGVProgTerrainLayerTempl",
  "extension": "crycg",
  "path": "CGVShaders/CGVProgTerrainLayerTempl.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": "\r\n       POSITION_3\r\n       PRIM_COLOR\r\n       NORMAL_3"
    },
    {
      "name": "MainInput",
      "content": "\r\n        VIEWPROJ_MATRIX,\r\n#if %DIFFUSE || %SPECULAR || %ENVCMSPEC || %ENVCMAMB\r\n        LIGHT_POS,\r\n        uniform float3 Tangent, \r\n#endif\r\n        uniform float4 LayerTexGen0,\r\n        uniform float4 LayerTexGen1,\r\n        \r\n        uniform float4 FadingDist,\r\n        CAMERA_POS,\r\n#if %ENVCMAMB\r\n        uniform float4x4 TexMatrix,\r\n#elif %ENVCMSPEC\r\n        uniform float4x4 ModelMatrix,\r\n#endif"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          float4 Position  : POSITION;\r\n          float3 Normal    : NORMAL;\r\n          float4 Color     : COLOR0;\r\n        };\r\n        \r\n        // define outputs from vertex shader\r\n        struct vertout\r\n        {\r\n          float4 HPosition  : POSITION;\r\n          float2 baseTC     : TEXCOORDN;\r\n#if %BUMP_MAP\r\n          float2 bumpTC     : TEXCOORDN;\r\n#endif\r\n#if %SPECULAR && !%SPECULAR_PERPIXEL\r\n          float4 halfAngVec : TEXCOORDN;\r\n#endif   \r\n#if %GLOSS_MAP\r\n          float2 glossTC    : TEXCOORDN;\r\n#endif\r\n\r\n#if %DIFFUSE\r\n          float4 lightVec   : TEXCOORDN;\r\n#endif\r\n\r\n#if %ENVCMAMB\r\n          float4 envTC      : TEXCOORDN;\r\n#elif %ENVCMSPEC\r\n          float4 tangVec    : TEXCOORDN;\r\n          float4 binormVec  : TEXCOORDN;\r\n          float4 normVec    : TEXCOORDN;\r\n#endif          \r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC || %SPECULAR_PERPIXEL\r\n          float4 viewVec    : TEXCOORDN;\r\n#endif          \r\n          float4 Color      : COLOR0;\r\n          float4 Color1     : COLOR1;\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "      \r\n        float4 tcLayer;\r\n        tcLayer.x = dot(LayerTexGen0, vPos);\r\n        tcLayer.y = dot(LayerTexGen1, vPos);\r\n        tcLayer.z = 0;\r\n        tcLayer.w = vPos.w;\r\n        OUT.baseTC = tcLayer.xy;\r\n\r\n#if %DIFFUSE || %SPECULAR || %ENVCMSPEC || %ENVCMAMB\r\n        float3 tang = Tangent.xyz;\r\n        float3 binorm = normalize(cross(tang, normal));\r\n        tang   = cross(normal, binorm);\r\n\r\n        // compute the 3x3 tranform from tangent space to object space\r\n        float3x3 objToTangentSpace;\r\n        objToTangentSpace[0] = tang;\r\n        objToTangentSpace[1] = binorm;\r\n        objToTangentSpace[2] = normal;\r\n#endif\r\n\r\n#if %BUMP_MAP\r\n        OUT.bumpTC = tcLayer.xy;\r\n#endif\r\n#if %DIFFUSE || %SPECULAR\r\n        // store normalized light vector\r\n        float3 lightVec = normalize(mul(objToTangentSpace, LightPos.xyz));\r\n  #if %DIFFUSE\r\n        OUT.lightVec.xyz = lightVec;\r\n  #endif\r\n#endif\r\n\r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n\r\n#if %OFFSETBUMPMAPPING || %ENVCMAMB || %ENVCMSPEC || %SPECULAR\r\n        float3 vVec = mul(objToTangentSpace, viewVec.xyz);\r\n  #if %OFFSETBUMPMAPPING || %ENVCMSPEC || %SPECULAR_PERPIXEL\r\n        OUT.viewVec.xyz = vVec;\r\n  #endif        \r\n  #if %SPECULAR && !%SPECULAR_PERPIXEL\r\n        OUT.halfAngVec.xyz = normalize(normalize(lightVec.xyz) + normalize(vVec.xyz));  \r\n  #endif        \r\n#endif          \r\n\r\n#if %ENVCMAMB\r\n        float3 tCamVec = normalize(viewVec);\r\n        float3 tRef = dot(normal.xyz, tCamVec.xyz) * normal.xyz * 2 - tCamVec.xyz;\r\n        float4 tRM;\r\n        tRM.xyz = tRef.xyz;\r\n        tRM.w = vPos.w;\r\n        OUT.envTC = mul(tRM, TexMatrix);\r\n#elif %ENVCMSPEC\r\n        float3 worldTangentS = mul((const float3x3)ModelMatrix, objToTangentSpace[0]);\r\n        float3 worldTangentT = mul((const float3x3)ModelMatrix, objToTangentSpace[1]);\r\n        float3 worldNormal   = mul((const float3x3)ModelMatrix, objToTangentSpace[2]);\r\n\r\n\t      OUT.tangVec.xyz = worldTangentS;\r\n\t      OUT.binormVec.xyz = worldTangentT;\r\n\t      OUT.normVec.xyz = worldNormal;\r\n#endif\t      \r\n\r\n#if %GLOSS_MAP\r\n        OUT.glossTC = tcLayer.xy;\r\n#endif\r\n        OUT.Color.xyz = IN.Color.xyz;\r\n        float fDist = length(viewVec.xyz);\r\n        fDist = fDist / FadingDist.x;\r\n        fDist = min(fDist, 1);\r\n        fDist = fDist * fDist;\r\n        fDist = fDist * fDist;\r\n        OUT.Color.a = IN.Color.a * (1-fDist);\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
