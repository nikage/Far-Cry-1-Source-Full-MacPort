    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // Ambient color\r\n        float3 cAmbient = float3(0.2, 0.2, 0.2);\r\n        // Diffuse color\r\n        float3 cDiffuse = float3(1, 0.8, 0.2);\r\n        \r\n        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);\r\n        float fDiffuse = dot(vLightDir, IN.Normal);\r\n        OUT.Color.xyz = cDiffuse * fDiffuse + cAmbient;\r\n        OUT.Color.w = 1;\r\n        OUT.Tex0 = IN.TexCoord;"
    }
  ],
