  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 NORMAL_3"
    },
    {
      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n  LIGHT_POS,\r\n  CAMERA_POS,\r\n  ATTEN,\r\n  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_N\r\n  };\r\n  \r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2_2\r\n    OUT_C0\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "   \r\n  OUT.Tex0.xy =IN.TexCoord0.xy;\r\n  OUT.Tex1.xy =IN.TexCoord0.xy;      \r\n          \r\n  // Compute light vector\r\n  float3 LightVec=LightPos.xyz-IN.Position.xyz;\r\n  // Compute view vector\r\n  float3 ViewVec=CameraPos.xyz-IN.Position.xyz;  \r\n  \r\n  float3 OSLightVec=normalize(LightVec);\r\n  float3 OSViewVec=normalize(ViewVec);    \r\n  float3 NormalVec=IN.Normal.xyz;\r\n    \r\n  float fDot= dot(OSViewVec, NormalVec.xyz);  \r\n  float3 reflVector =(2*NormalVec.xyz*fDot-OSViewVec.xyz);  \r\n  OUT.Tex2.xy = (reflVector.xz+1.0)*0.5;\r\n\r\n  float fDiffuse = max(dot(OSLightVec, NormalVec), 0);\r\n  \r\n  float fiSqDist = rsqrt(dot(LightVec, LightVec));\r\n  float fAtten = PROC_ATTENVERT;\r\n  \r\n  OUT.Color.xyz=fDiffuse*fAtten*Diffuse.xyz;\r\n\r\n  return OUT;"
    }
  ],
