    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2_2\r\n          OUT_T3_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex2.xy = IN.TexCoord0.xy;\r\n\r\n        TANG_MATR\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = normalize(LightPos.xyz - vPos.xyz);\r\n        \r\n        // transform light vector from object space to tangent space and pass it as a color\r\n        float3 vLV = mul(objToTangentSpace, lightVec.xyz);\r\n        vLV = ((0.5).xxx * vLV) + (0.5).xxx;\r\n        \r\n        OUT.Tex1.xy = vLV.xy;\r\n        OUT.Tex3.xy = vLV.xy;\r\n        OUT.Color.xyz = vLV.zzz;"
    }
  ],
