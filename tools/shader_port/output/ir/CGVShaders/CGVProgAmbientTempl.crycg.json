{
  "name": "CGVProgAmbientTempl",
  "extension": "crycg",
  "path": "CGVShaders/CGVProgAmbientTempl.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": "\r\n        POSITION_3\r\n        TEXCOORD0_2\r\n#if %TEMP_DOT3LM || %TEMP_LM\r\n        TEXCOORD1_2\r\n#endif        \r\n#if %ENVCMAMB || %TEMP_ENVLIGHT\r\n        TNORMAL_3\r\n#endif\r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC\r\n        TANG_3X3\r\n#endif\r\n#if %VERTCOLORS\r\n        PRIM_COLOR\r\n#endif"
    },
    {
      "name": "MainInput",
      "content": "\r\n        VIEWPROJ_MATRIX,\r\n#if %ENVCMAMB\r\n        uniform float4x4 TexMatrix,\r\n#elif %TEMP_ENVLIGHT\r\n        uniform float4 EnvColors[6],\r\n        uniform float4x4 TexMatrix,\r\n#elif %ENVCMSPEC\r\n        uniform float4x4 ModelMatrix,\r\n#endif\r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC || %ENVCMAMB\r\n        CAMERA_POS,\r\n#endif"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          float4 Position  : POSITION;\r\n          float4 baseTC    : TEXCOORD0;\r\n#if %TEMP_DOT3LM || %TEMP_LM || %BUMP_ZCORRECT\r\n          float4 lmTC      : TEXCOORD1;\r\n#endif\r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC\r\n          IN_TANGVECS\r\n#elif %TEMP_ENVLIGHT || %ENVCMAMB\r\n          IN_TNORMVEC\r\n#endif\r\n#if %VERTCOLORS\r\n          IN_C0\r\n#endif\r\n        };\r\n        \r\n        // define outputs from vertex shader\r\n        struct vertout\r\n        {\r\n          float4 HPosition  : POSITION;\r\n          float4 baseTC     : TEXCOORDN;\r\n#if %BUMP_MAP\r\n  #if %TEMP_DOT3LM || %ENVCMSPEC || %OFFSETBUMPMAPPING\r\n          float4 bumpTC     : TEXCOORDN;\r\n  #endif\r\n#endif  \r\n#if %TEMP_LM || %TEMP_DOT3LM || %BUMP_ZCORRECT\r\n          float4 lmTC_ZW    : TEXCOORDN;\r\n#endif          \r\n#if %TEMP_DOT3LM\r\n          float4 lmdirTC    : TEXCOORDN;\r\n#endif\r\n\r\n          float4 Color      : COLOR0;\r\n          \r\n#if %ENVCMAMB\r\n          float4 envTC      : TEXCOORDN;\r\n#elif %ENVCMSPEC\r\n          float4 tangVec    : TEXCOORDN;\r\n          float4 binormVec  : TEXCOORDN;\r\n          float4 normVec    : TEXCOORDN;\r\n#endif          \r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC\r\n          float4 viewVec    : TEXCOORDN;\r\n#endif          \r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.baseTC.xy = IN.baseTC.xy;\r\n        // Gloss-map texture coordinate\r\n    #if %ENVCMSPEC && %GLOSS_MAP\r\n        OUT.baseTC.zw = IN.baseTC.xy;\r\n    #elif %ENVCM_MASKED\r\n        OUT.baseTC.zw = IN.baseTC.xy;\r\n    #endif\r\n\r\n#if %BUMP_MAP\r\n  #if %TEMP_DOT3LM || %ENVCMSPEC || %OFFSETBUMPMAPPING\r\n        OUT.bumpTC.xy  = IN.baseTC.xy;\r\n  #endif\r\n#endif\r\n\r\n#if %OFFSETBUMPMAPPING || %ENVCMSPEC\r\n        TANG_MATR\r\n        \r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n        OUT.viewVec.xyz = mul(objToTangentSpace, viewVec.xyz);\r\n#endif          \r\n      \r\n#if %TEMP_LM || %TEMP_DOT3LM || %BUMP_ZCORRECT\r\n        OUT.lmTC_ZW.xy = IN.lmTC.xy;\r\n#endif        \r\n#if %TEMP_DOT3LM\r\n        OUT.lmdirTC.xy = IN.lmTC.xy;\r\n#endif\r\n#if %BUMP_ZCORRECT\r\n        OUT.lmTC_ZW.z = dot(ModelViewProj[2], vPos);\r\n        OUT.lmTC_ZW.w = dot(ModelViewProj[3], vPos);\r\n#endif\r\n\r\n#if %ENVCMAMB\r\n  #if !%OFFSETBUMPMAPPING && !%ENVCMSPEC\r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n  #endif        \r\n        float3 tCamVec = normalize(viewVec);\r\n        float3 tNormal = IN.TNormal.xyz;\r\n        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;\r\n        float4 tRM;\r\n        tRM.xyz = tRef.xyz;\r\n        tRM.w = vPos.w;\r\n        OUT.envTC = mul(tRM, TexMatrix);\r\n#elif %TEMP_ENVLIGHT\r\n        // Calculate average radiosity color from 6 colors (Cube)\r\n        float3 tNormal;\r\n        tNormal = mul((float3x3)TexMatrix, IN.TNormal.xyz);        \r\n        float3 Compare1 = step(tNormal, 0);\r\n        float3 Compare0 = 1 - Compare1;\r\n        float3 signN = sign(tNormal);\r\n        tNormal = tNormal * tNormal;\r\n        tNormal = tNormal * signN;\r\n        float4 ColorX = EnvColors[0]*tNormal.x*Compare0.x + EnvColors[1]*(-tNormal.x)*Compare1.x;\r\n        float4 ColorY = EnvColors[2]*tNormal.y*Compare0.y + EnvColors[3]*(-tNormal.y)*Compare1.y;\r\n        float4 ColorZ = EnvColors[4]*tNormal.z*Compare0.z + EnvColors[5]*(-tNormal.z)*Compare1.z;\r\n        OUT.Color = (ColorX + ColorY + ColorZ) * 2.0;\r\n#elif %ENVCMSPEC\r\n        float3 worldTangentS = mul((const float3x3)ModelMatrix, objToTangentSpace[0]);\r\n        float3 worldTangentT = mul((const float3x3)ModelMatrix, objToTangentSpace[1]);\r\n        float3 worldNormal   = mul((const float3x3)ModelMatrix, objToTangentSpace[2]);\r\n\r\n\t      OUT.tangVec.xyz = worldTangentS;\r\n\t      OUT.binormVec.xyz = worldTangentT;\r\n\t      OUT.normVec.xyz = worldNormal;\r\n#endif\t      \r\n\r\n#if %VERTCOLORS\r\n        OUT.Color = IN.Color;\r\n#endif\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
