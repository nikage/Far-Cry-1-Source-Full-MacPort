  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE envMap : texunit1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);\r\n\r\n        float3 col = (envColor.xyz * decalColor.a + decalColor.xyz) * IN.Color.xyz + IN.Color1.xyz;\r\n        col = HDREncodeAmb(col.xyz);\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = col;\r\n        OUT.Color.w = IN.Color.a;"
    }
  ],
