  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n#ifdef OPENGL\r\n    uniform samplerRECT baseMap : texunit0,\r\n    uniform samplerRECT flashMap : texunit1,\r\n#endif    \r\n#ifdef D3D\r\n    uniform sampler2D baseMap : texunit0,\r\n    uniform sampler2D flashMap : texunit1,\r\n#endif    \r\n    uniform float4 FlashBang"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n    struct vertout\r\n    {\r\n      OUT_T0\r\n      OUT_T1\r\n    };\r\n\r\n    FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n    // load the decal\r\n#ifdef OPENGL\r\n    float4 screenColor = texRECT(baseMap, IN.Tex0.xy);\r\n    float4 flashColor = texRECT(flashMap, IN.Tex1.xy);\r\n#endif    \r\n#ifdef D3D\r\n    float4 screenColor = tex2D(baseMap, IN.Tex0.xy);\r\n    float4 flashColor = tex2D(flashMap, IN.Tex1.xy);\r\n#endif    \r\n\r\n    float3 color = (flashColor.xyz * 4) + FlashBang.w;\r\n    \r\n    //OUT.Color.xyz = lerp(screenColor.xyz, color.xyz, FlashBang.w);\r\n    OUT.Color.xyz = screenColor.xyz*(1-FlashBang.w)+ color.xyz*FlashBang.w;\r\n    \r\n    OUT.Color.a = 1; //saturate(1-FlashBang.w)*0.75;"
    }
  ],
