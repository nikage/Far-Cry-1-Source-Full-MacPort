{
  "name": "CGRCHeat_Alpha_SingleLight_Proj",
  "extension": "crycg",
  "path": "CGPShaders/CGRCHeat_Alpha_SingleLight_Proj.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform samplerCUBE projMap : texunit2,\r\n                  uniform float4 Heat"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n        float4 projColor = texCUBE(projMap, IN.Tex2.xyz);\r\n\r\n        // Light vector from input color\r\n        float3 lVec = 2 * (IN.Color1.xyz - 0.5);\r\n        float NdotL = saturate(dot(lVec, bumpNormal.xyz));\r\n        float3 dif = (NdotL * Heat.a * projColor.xyz * IN.Color.a) * 2;\r\n        float3 amb = Heat.xyz * IN.Color.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = Heat.xyz;//amb + dif;\r\n        OUT.Color.w = decalColor.w;"
    }
  ],
