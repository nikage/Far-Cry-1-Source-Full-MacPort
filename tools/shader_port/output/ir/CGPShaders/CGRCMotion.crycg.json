  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n#ifdef OPENGL\r\n  uniform samplerRECT baseMap0 : texunit0,\r\n  uniform samplerRECT baseMap1 : texunit1,\r\n  uniform samplerRECT baseMap2 : texunit2,\r\n  uniform samplerRECT baseMap3 : texunit3,\r\n#endif  \r\n#ifdef D3D\r\n  uniform sampler2D baseMap0 : texunit0,\r\n  uniform sampler2D baseMap1 : texunit1,\r\n  uniform sampler2D baseMap2 : texunit2,\r\n  uniform sampler2D baseMap3 : texunit3,\r\n#endif  \r\n  uniform float4 fMotionParams"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n    OUT_T3\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load the decal\r\n#ifdef OPENGL\r\n  float4 mColor0 = texRECT(baseMap0, IN.Tex0.xy);\r\n  float4 mColor1 = texRECT(baseMap1, IN.Tex1.xy);\r\n  float4 mColor2 = texRECT(baseMap2, IN.Tex2.xy);\r\n  float4 mColor3 = texRECT(baseMap3, IN.Tex3.xy);\r\n#endif\r\n#ifdef D3D\r\n  float4 mColor0 = tex2D(baseMap0, IN.Tex0.xy);\r\n  float4 mColor1 = tex2D(baseMap1, IN.Tex1.xy);\r\n  float4 mColor2 = tex2D(baseMap2, IN.Tex2.xy);\r\n  float4 mColor3 = tex2D(baseMap3, IN.Tex3.xy);\r\n#endif\r\n  \r\n  float4 col = mColor3*0.25;\r\n  col = mColor2*0.25+col;\r\n  col = mColor1*0.25+col;\r\n  col = mColor0*0.25+col;\r\n  \r\n  OUT.Color.xyz = col.xyz;\r\n  OUT.Color.w = fMotionParams.w;"
    }
  ],
