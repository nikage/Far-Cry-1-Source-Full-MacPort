{
  "name": "CGRCBump_DiffPass_Terrain_ProjSingleLight_VertAtten",
  "extension": "crycg",
  "path": "CGPShaders/CGRCBump_DiffPass_Terrain_ProjSingleLight_VertAtten.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform samplerCUBE normCubeMap : texunit2,\r\n                  uniform samplerCUBE projMap : texunit3,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n\r\n        float4 projColor = texCUBE(projMap, IN.Tex3.xyz);\r\n\r\n        // Light vector from normalization cube-map\r\n        float4 lVec = 2*(texCUBE(normCubeMap, IN.Tex2.xyz)-0.5);\r\n        \r\n        float NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));\r\n\r\n# ifdef _HDR\r\n        float3 dif = (decalColor.xyz * NdotL * projColor.xyz * Diffuse.xyz * IN.Color1.xyz);\r\n        dif.xyz = HDREncode(dif.xyz);\r\n# else        \r\n        float3 dif = ((decalColor.xyz*0.75+0.25) * NdotL * projColor.xyz * Diffuse.xyz * IN.Color1.xyz);\r\n# endif\t\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = HDRFogBlend(dif, IN.Color.w, GlobalFogColor.xyz);\r\n        OUT.Color.w = decalColor.w * Diffuse.w;"
    }
  ],
