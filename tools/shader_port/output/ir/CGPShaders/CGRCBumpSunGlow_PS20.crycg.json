{
  "name": "CGRCBumpSunGlow_PS20",
  "extension": "crycg",
  "path": "CGPShaders/CGRCBumpSunGlow_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n\t                uniform float4 Specular,\r\n\t                uniform float4 BumpAmount"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the bump normal\r\n        FLOAT4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex0.xy)-0.5);\r\n\r\n        // normalize post-filtered bump normals\r\n        bumpNormal.xyz *= BumpAmount.xyz;\r\n        bumpNormal.xyz = normalize(bumpNormal.xyz);\r\n        \r\n        // normalize light vector\r\n        FLOAT3 lightVec = normalize(IN.Tex1.xyz);\r\n\r\n        // normalize view vector\r\n        FLOAT3 viewVec = normalize(IN.Tex2.xyz);\r\n        FLOAT3 reflVec = (2*dot(lightVec.xyz, bumpNormal.xyz)*bumpNormal.xyz)-lightVec.xyz;\r\n        FLOAT NdotR = saturate(dot(reflVec.xyz, viewVec.xyz));\r\n        FLOAT fSpec = pow(NdotR, Specular.w);\r\n\r\n        FLOAT fFade = IN.Color.w;\r\n        FLOAT3 spec = HDREncode(fSpec * Specular.xyz * fFade) * 2;\r\n        \r\n        // finally add them all together\r\n        OUT.Color.xyz = spec.xyz;\r\n        OUT.Color.w = 1;"
    }
  ],
