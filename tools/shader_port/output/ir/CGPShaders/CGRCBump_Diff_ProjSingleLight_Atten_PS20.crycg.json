{
  "name": "CGRCBump_Diff_ProjSingleLight_Atten_PS20",
  "extension": "crycg",
  "path": "CGPShaders/CGRCBump_Diff_ProjSingleLight_Atten_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform samplerCUBE normCubeMap : texunit2,\r\n                  uniform samplerCUBE projMap : texunit3,\r\n                  uniform sampler2D attenMap : texunit4,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        half4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n\r\n        half4 projColor = texCUBE(projMap, IN.Tex3.xyz);\r\n        half atten = saturate((2*(IN.Color.b-0.5)) * -(2*(IN.Color.b-0.5)) + (1-tex2D(attenMap, IN.Tex4.xy).b));\r\n\r\n        // Light vector from input color\r\n        float4 lVec = 2*(texCUBE(normCubeMap, IN.Tex2.xyz)-0.5);\r\n        float NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));\r\n        half3 dif = (decalColor.xyz * NdotL * projColor.xyz * Diffuse.xyz * atten) * 2;\r\n        half3 amb = Ambient.xyz * decalColor.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb + dif;\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
