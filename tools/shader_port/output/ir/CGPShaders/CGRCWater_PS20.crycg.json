{
  "name": "CGRCWater_PS20",
  "extension": "crycg",
  "path": "CGPShaders/CGRCWater_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler3D noiseMap : register(s0),\r\n                  uniform sampler2D envMap   : register(s1),\r\n                  uniform sampler2D dirtyMap : register(s2),\r\n                  uniform float4 BumpScale,\r\n                  uniform float4 ReflectAmount,\r\n                  uniform float4 FadeParams,\r\n                  uniform float4 TimeParams"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_T5\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "        \r\n        float3 pos = IN.Tex0.xyz + TimeParams.xyz * TimeParams.w;\r\n        float4 noisy = tex3D(noiseMap, pos.xyz);\r\n\r\n        // Signed noise \r\n        float3 bump = 2*noisy.a-1;\r\n\r\n        // Make sure the normal always points upwards\r\n        //bump.z = 0.8 * abs(bump.z) + 0.2;\r\n\r\n        // fade bump normals on the distance (emulate mipmapping)\r\n        float fZ = (IN.Tex5.x / IN.Tex5.y);\r\n        fZ = pow(fZ, 16);\r\n        bump.xyz = lerp(bump.xyz, float3(0,0,1), fZ);\r\n\r\n        // environment\r\n        float2 newst = IN.Tex1.xy / IN.Tex1.w;\r\n        newst.xy = newst.xy + bump.xy*BumpScale.xy*16;\r\n        float4 refl = tex2D(envMap, newst.xy);\r\n\r\n        // result color\r\n        float4 baseColor = tex2D(dirtyMap, IN.Tex2.xy);\r\n\r\n        // Interpolate between the dirty color and reflection\r\n        float3 color = lerp(baseColor.xyz, refl.xyz, ReflectAmount.xyz);\r\n\r\n        // Fresnel term\r\n        float lrp = 1 - dot(-normalize(IN.Tex4.xyz), bump.xyz);\r\n        float fadeBias = FadeParams.x;\r\n        float fadeExp = FadeParams.y;\r\n        float fTransp = saturate(fadeBias + pow(lrp, fadeExp)); // + (baseColor.b-0.75);\r\n        \r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = IN.Color.a * ReflectAmount.a * fTransp;"
    }
  ],
