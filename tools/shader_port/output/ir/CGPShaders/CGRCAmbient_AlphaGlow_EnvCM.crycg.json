  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE envMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Reflect"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the environment map\r\n        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);\r\n        float3 amb = lerp(decalColor.xyz*Ambient.xyz, envColor.xyz, Reflect.x);\r\n        OUT.Color.xyz = amb.xyz + decalColor.w * decalColor.xyz;\r\n        OUT.Color.w = Ambient.w;"
    }
  ],
