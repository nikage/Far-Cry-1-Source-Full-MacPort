  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n#ifdef OPENGL\r\n  uniform samplerRECT baseMap0 : texunit0,\r\n  uniform samplerRECT baseMap1 : texunit1,\r\n  uniform samplerRECT baseMap2 : texunit2,\r\n  uniform samplerRECT baseMap3 : texunit3            \r\n#endif  \r\n#ifdef D3D\r\n  uniform sampler2D baseMap0 : texunit0,\r\n  uniform sampler2D baseMap1 : texunit1,\r\n  uniform sampler2D baseMap2 : texunit2,\r\n  uniform sampler2D baseMap3 : texunit3            \r\n#endif"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n    OUT_T3\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load the decal\r\n#ifdef OPENGL\r\n  float4 mColor0 = texRECT(baseMap0, IN.Tex0.xy);\r\n  float4 mColor1 = texRECT(baseMap1, IN.Tex1.xy);\r\n  float4 mColor2 = texRECT(baseMap2, IN.Tex2.xy);\r\n  float4 mColor3 = texRECT(baseMap3, IN.Tex3.xy);\r\n#endif  \r\n#ifdef D3D\r\n  float4 mColor0 = tex2D(baseMap0, IN.Tex0.xy);\r\n  float4 mColor1 = tex2D(baseMap1, IN.Tex1.xy);\r\n  float4 mColor2 = tex2D(baseMap2, IN.Tex2.xy);\r\n  float4 mColor3 = tex2D(baseMap3, IN.Tex3.xy);\r\n#endif  \r\n    \r\n  // get edges\r\n  float3 vCol01=2*saturate(mColor0.xyz-mColor1.xyz);\r\n  float3 vCol02=2*saturate(mColor2.xyz-mColor3.xyz);\r\n  \r\n  float3 s0=saturate(2*dot(vCol01.xyz, vCol01.xyz)); //*0.75;\r\n  float3 s1=saturate(2*dot(vCol02.xyz, vCol02.xyz)); //*0.75;\r\n  float3 vFinal=saturate(1-s0-s1);  \r\n  \r\n  OUT.Color.xyz =vFinal.xyz;  \r\n  OUT.Color.w = 1.0;"
    }
  ],
