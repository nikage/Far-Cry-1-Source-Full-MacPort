{
  "name": "CGRCWater_CM_PS20",
  "extension": "crycg",
  "path": "CGPShaders/CGRCWater_CM_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler3D noiseMap : texunit0,\r\n                  uniform samplerCUBE envMap : texunit1,\r\n                  uniform float4 FadeParams,\r\n                  uniform float4 TimeParams,\r\n                  uniform float4 WaterColor"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "        \r\n        float3 pos = IN.Tex0.xyz + TimeParams.yzw * TimeParams.x;\r\n        float4 noisy = tex3D(noiseMap, pos);\r\n\r\n        // Signed noise \r\n        float3 bump = 2 * noisy.a - 1;\r\n        bump.xy *= 0.15;\r\n        // Make sure the normal always points upwards\r\n        bump.z = 0.8 * abs(bump.z) + 0.2;\r\n        // Offset the surface normal with the bump\r\n        bump = normalize(IN.Tex1.xyz + bump);\r\n\r\n        // Find the reflection vector\r\n        float3 reflVec = reflect(IN.Tex2.xyz, bump.xyz);\r\n        float4 refl = texCUBE(envMap, reflVec.xyz);\r\n\r\n        float lrp = 1 - dot(-normalize(IN.Tex2.xyz), bump);\r\n\r\n        float fadeBias = FadeParams.x;\r\n        float fadeExp = FadeParams.y;\r\n\r\n        // Interpolate between the water color and reflection\r\n        OUT.Color.xyz = lerp(WaterColor.xyz, refl.xyz, saturate(fadeBias + pow(lrp, fadeExp)));\r\n        OUT.Color.a = IN.Color.a * WaterColor.a;"
    }
  ],
