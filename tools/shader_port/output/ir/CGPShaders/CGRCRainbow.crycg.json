  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D rainbMap : texunit1,\r\n                  uniform float4 Constants"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the decal\r\n        float4 rainbColor = tex2D(rainbMap, IN.Tex1.xy);\r\n        float3 color = (decalColor.xyz * decalColor.a) * 2;\r\n        color = color - Constants.xyz + rainbColor.xyz;\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = decalColor.a * Constants.a;"
    }
  ],
