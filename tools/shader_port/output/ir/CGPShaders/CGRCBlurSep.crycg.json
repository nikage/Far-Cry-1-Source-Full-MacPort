      "name": "MainInput",
      "content": "\r\n\tuniform sampler2D BlurSampler : texunit0,\r\n  uniform FLOAT4 BlurOffset,\r\n  uniform FLOAT4 vPixelWeights[8]"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\tstruct vertout\r\n\t{\r\n\t  OUT_T0\r\n\t};\r\n\r\n\tFOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\tFLOAT4 color = tex2D( BlurSampler, IN.Tex0.xy );\r\n\r\n\t// Sample pixels on either side\r\n\tfor(int i=0; i<8; i++)\r\n\t{\r\n\t\tcolor += tex2D( BlurSampler, IN.Tex0.xy + ( BlurOffset.xy * i ) ) * vPixelWeights[i];\r\n\t\tcolor += tex2D( BlurSampler, IN.Tex0.xy - ( BlurOffset.xy * i ) ) * vPixelWeights[i];\r\n\t}\r\n\r\n\tOUT.Color = color;"
    }
  ],
