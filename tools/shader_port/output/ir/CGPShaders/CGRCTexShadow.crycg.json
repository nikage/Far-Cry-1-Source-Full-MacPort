  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D basisMap0 : texunit0,\r\n                  uniform sampler2D horizonMap0 : texunit1,\r\n                  uniform sampler2D basisMap1 : texunit2,\r\n                  uniform sampler2D horizonMap1 : texunit3"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\t\t//fetch basis maps\r\n        float4 basis0 = 2*(tex2D(basisMap0, IN.Tex0.xy)-0.5);\r\n        float4 basis1 = 2*(tex2D(basisMap1, IN.Tex2.xy)-0.5);\r\n\r\n\t\t//fetch horizon maps\r\n        float4 horizon0 = 2*(tex2D(horizonMap0, IN.Tex1.xy)-0.5);\r\n        float4 horizon1 = 2*(tex2D(horizonMap1, IN.Tex3.xy)-0.5);\r\n        \r\n        float shad0 = saturate(dot(basis0.xyz, horizon0.xyz)) + saturate(basis0.w * horizon0.w);\r\n        float shad1 = saturate(dot(basis1.xyz, horizon1.xyz)) + saturate(basis1.w * horizon1.w);\r\n        \r\n        OUT.Color.xyz = 1;\r\n        OUT.Color.a = (shad0 + shad1 - (2*(IN.Color.b-0.5))) * 4;"
    }
  ],
