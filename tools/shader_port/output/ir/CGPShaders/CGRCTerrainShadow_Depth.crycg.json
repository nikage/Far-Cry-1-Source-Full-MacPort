  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : register(s0),\r\n                  uniform sampler2D shadMap : register(s1),\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        half4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the 1 shadow sample\r\n        half4 shadColor0 = tex2Dproj(shadMap, IN.Tex1.xyzw);\r\n        half shad = shadColor0.r/8 + shadColor0.g;\r\n        float fZ = IN.Tex2.x / IN.Tex2.y;\r\n        shad = shad - fZ;\r\n        half fCompare = step(shad, 0) * shadColor0.a;\r\n        \r\n        half3 color = (decalColor.xyz * IN.Color.xyz * Ambient.xyz);\r\n        color.xyz = HDREncode(color.xyz);\r\n        OUT.Color.xyz = color;\r\n        OUT.Color.a = fCompare;"
    }
  ],
