    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n            uniform sampler2D refMap : texunit1,\r\n            uniform float4 Matrix,\r\n            uniform float4 Ambient,\r\n            uniform float4 WaterColor"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "  \r\n  // load the decal\r\n  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);\r\n\r\n// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...\r\n  float4 refrColor;\r\n#ifdef D3D\r\n  # ifdef _PS_1_1\r\n    refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);\r\n  # else\r\n    float2 newst = IN.Tex1.xy / IN.Tex1.w;\r\n    float2 newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n    refrColor = tex2D(refMap, newst);\r\n  # endif\r\n#endif\r\n#ifdef OPENGL\r\n  # ifdef _PS_1_1\r\n    refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);\r\n  # else\r\n    float2 newst = IN.Tex1.xy / IN.Tex1.w;\r\n    float2 newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n    refrColor = texRECT(refMap, newst);\r\n  # endif\r\n#endif  \r\n  \r\n  float fFakeSpec=dot(refrColor.xyz, float3(0.33, 0.59, 0.11));                                 // get brightest color\r\n  fFakeSpec=saturate(0.75*fFakeSpec + fFakeSpec);                                   // bright it a bit\r\n  float3 fFakeSpecColor=refrColor.xyz*fFakeSpec;                                         // compute specular color\r\n  OUT.Color.xyz = Ambient.xyz*( saturate(fFakeSpecColor*WaterColor.w + WaterColor.xyz) );      // compute final surface color"
    }
  ],
