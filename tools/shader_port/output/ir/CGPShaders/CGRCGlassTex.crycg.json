  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D envMap : texunit1,\r\n                  uniform float4 ReflAmount"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n\r\n        // load the reflection map\r\n# ifdef _PS_1_1\r\n        float4 envColor = tex2D(envMap, IN.Tex1.xy);\r\n# else\r\n        float4 envColor = tex2Dproj(envMap, IN.Tex1.xyzw);\r\n# endif\r\n        \r\n        float3 env = envColor.xyz*ReflAmount.xyz + decalColor.xyz*(1-ReflAmount.xyz);\r\n        // finally add them all together\r\n        OUT.Color.xyz = env;\r\n        OUT.Color.w = ReflAmount.a * IN.Color.a * decalColor.a;"
    }
  ],
