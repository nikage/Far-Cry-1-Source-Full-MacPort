{
  "name": "CGRCOceanWater",
  "extension": "crycg",
  "path": "CGPShaders/CGRCOceanWater.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : register(s0),\r\n                  uniform sampler2D envMap : register(s1),\r\n                  uniform float4 Matrix,\r\n                  uniform float4 ReflectAmount,\r\n                  uniform float4 WaterColor,\r\n                  uniform float4 SpecularSun"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3 \r\n          OUT_T4\r\n          OUT_T5\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "                  \r\n        float2 vScale=saturate(Matrix.xw);//float2(IN.Tex4.w, IN.Tex4.w))*Matrix.xw;\r\n                        \r\n        // load the decal\r\n        float4 bumpColorA = tex2D(bumpMap, IN.Tex0.xy);\r\n        float4 bumpColorB = tex2D(bumpMap, IN.Tex0.zw);\r\n        float4 vNormal = 0.5*( (2*bumpColorA-1)+(2*bumpColorB-1) );\r\n                \r\n        float2 newst = (IN.Tex1.xy / IN.Tex1.w)+ vScale.xy * vNormal.xy;        \r\n        float4 reflColor = tex2D(envMap, newst.xy);                \r\n        \r\n        float3 vWaterColor=float3(0.0, 0.3, 0.5)*WaterColor.xyz;\r\n        reflColor.xyz=vWaterColor*(1.0-ReflectAmount.w)+reflColor.xyz*ReflectAmount.w;\r\n                                             \r\n        // load the decal\r\n        bumpColorA = tex2D(bumpMap, IN.Tex0.yx*2.0);\r\n        bumpColorB = tex2D(bumpMap, IN.Tex0.wz*2.0);\r\n        float4 vRefrNormal = 2*((bumpColorA*0.5+bumpColorB*0.5)-0.5);\r\n                                             \r\n        float3 vView=normalize(IN.Tex4.xyz);        \r\n        float3 vLight=normalize(IN.Tex5.xyz);\r\n                \r\n        float fDot=(dot(vNormal.xyz, vLight.xyz));\r\n        float3 vReflect=normalize(2.0*vNormal.xyz*fDot-vView.xyz);\r\n                                          \r\n        float fSunGlow=saturate(dot(vReflect.xyz, vLight.xyz));                \r\n                        \r\n        float fR0=0.5;\r\n        float fDist=saturate(IN.Tex3.z);\r\n        \r\n        float fFoam=saturate(saturate(fR0+(1-fR0)*pow((1-fDot), 5.0)));                \r\n        float fAtten=saturate( saturate(IN.Color.w*(1.0-IN.Tex2.z))+IN.Color.w );\r\n        float fFresnel=saturate(fFoam*fAtten + fAtten);\r\n                                \r\n        float3 vFinal=saturate(reflColor*fFresnel);                                \r\n                                                        \r\n        float3 vSunCol=float3(1.0, 0.8, 0.5);\r\n        fSunGlow=2.0*pow(fSunGlow, 64)*fFresnel; //*IN.Tex5.w;                        \r\n        float3 vSunGlow=fSunGlow*vFinal.xyz*vSunCol.xyz; //*reflColor*fFresnel;\r\n\r\n        fR0=0.0;        \r\n        float3 vFoam=saturate(saturate(fR0+(1-fR0)*pow((1-fDot), 5.0)))*vFinal*WaterColor*0.5;                \r\n        vFoam*=vFoam*4.0;\r\n                                                                                                                                 \r\n        OUT.Color.xyz = vFoam+vFinal+vSunGlow-vFinal.xyz*vSunGlow;                \r\n        OUT.Color.a = saturate(IN.Color.w*fSunGlow+IN.Color.w);"
    }
  ],
