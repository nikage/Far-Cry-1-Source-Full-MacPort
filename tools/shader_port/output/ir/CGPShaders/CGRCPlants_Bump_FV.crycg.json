{
  "name": "CGRCPlants_Bump_FV",
  "extension": "crycg",
  "path": "CGPShaders/CGRCPlants_Bump_FV.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform sampler2D fogMap : texunit2,\r\n                  uniform sampler2D fogEnterMap : texunit3,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 FogColor,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n        // load the fog\r\n        float4 fogColor = tex2D(fogMap, IN.Tex2.xy);\r\n        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex3.xy);\r\n\r\n        // light vector\r\n        float3 lightVec = EXPAND(IN.Color1.xyz);\r\n        float fDif = saturate(dot(bumpNormal.xyz, lightVec));\r\n        float3 dif = (fDif * Diffuse.xyz);\r\n        float3 color = Ambient.xyz * (IN.Color.xyz + dif.xyz) * decalColor.xyz;\r\n        color.xyz = HDREncode(color.xyz);\r\n\r\n        float fog = fogColor.a * fogEnterColor.a;\r\n        color.xyz = HDREncodeAmb(FogColor.xyz)*fog + color.xyz*(1-fog);\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = decalColor.a * Ambient.a * IN.Color.a;"
    }
  ],
