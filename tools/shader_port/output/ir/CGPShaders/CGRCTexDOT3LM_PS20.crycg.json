{
  "name": "CGRCTexDOT3LM_PS20",
  "extension": "crycg",
  "path": "CGPShaders/CGRCTexDOT3LM_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : register(s0),\r\n                  uniform sampler2D bumpMap : register(s1),\r\n                  uniform sampler2D lightMap : register(s2),\r\n                  uniform sampler2D lightDirMap : register(s3),\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        half4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        half4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n        // load the lm\r\n        half4 lmColor = tex2D(lightMap, IN.Tex2.xy);\r\n        // load the lm dir\r\n        float4 lmDat = tex2D(lightDirMap, IN.Tex3.xy);\r\n        float3 lmDir = 2*(lmDat.xyz-0.5);\r\n\r\n        // normalize post-filtered bump normals\r\n        bumpNormal.xyz = normalize(bumpNormal.xyz);\r\n\r\n        // normalize post-filtered light dirs\r\n        lmDir.xyz = normalize(lmDir.xyz);\r\n\r\n        float NdotL = saturate(dot(lmDir.xyz, bumpNormal.xyz));\r\n        half  lmIntens = NdotL * lmColor.a + (1-lmColor.a);\r\n        half3 dif = (decalColor.xyz * lmColor.xyz * lmDat.a * lmIntens) * 4;\r\n        half3 amb = decalColor.xyz * Ambient.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb + dif;\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
