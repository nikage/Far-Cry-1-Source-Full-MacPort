{
  "name": "CGRCBark_SunRabbits",
  "extension": "crycg",
  "path": "CGPShaders/CGRCBark_SunRabbits.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D sunMap : texunit1,\r\n                  AMBIENT"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the sun-rabbits color\r\n        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);\r\n\r\n        float4 color = decalColor * Ambient;\r\n        color.xyz = HDREncode(color.xyz * IN.Color.xyz);\r\n        float3 colorSun = HDREncodeAmb(sunColor.xyz) * IN.Color.a * Ambient.xyz * Diffuse.a;\r\n        color.xyz = HDRFogBlend(color.xyz + colorSun.xyz, IN.Color.w, GlobalFogColor.xyz);\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
