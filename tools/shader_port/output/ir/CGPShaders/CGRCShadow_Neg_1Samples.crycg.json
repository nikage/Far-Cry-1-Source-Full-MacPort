  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadowMap0 : texunit0,\r\n                  uniform sampler2D baseMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 shadowColor0 = tex2Dproj(shadowMap0, IN.Tex0.xyw);\r\n        float4 decalColor = tex2D(baseMap, IN.Tex1.xy);\r\n        float3 color = decalColor.xyz * Ambient.xyz;\r\n        color = HDREncodeAmb(color);\r\n        float shadow = shadowColor0.a * Fading.x;\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = shadow;"
    }
  ],
