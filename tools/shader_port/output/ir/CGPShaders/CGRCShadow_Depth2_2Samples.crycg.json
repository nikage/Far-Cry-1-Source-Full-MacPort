{
  "name": "CGRCShadow_Depth2_2Samples",
  "extension": "crycg",
  "path": "CGPShaders/CGRCShadow_Depth2_2Samples.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadMap0 : register(s0),\r\n                  uniform sampler2D shadMap1 : register(s1),\r\n                  uniform sampler2D baseMap : register(s2),\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex2.xy);\r\n        // load the 2 shadow samples\r\n        float4 shadColor0 = tex2Dproj(shadMap0, IN.Tex0.xyzw);\r\n        float4 shadColor1 = tex2Dproj(shadMap1, IN.Tex1.xyzw);\r\n        float3 shad = (float3)0;\r\n        shad.x = shadColor0.r/8 + shadColor0.g;\r\n        shad.y = shadColor1.r/8 + shadColor1.g;\r\n        float3 vZ = (float3)0;\r\n        vZ.x = IN.Tex3.x / IN.Tex3.y;\r\n        vZ.y = IN.Tex3.z / IN.Tex3.w;\r\n        shad = shad - vZ;\r\n        //float3 compare = step(shad, float3(0.0, 0.0, 0.0));\r\n        float3 compare = saturate(-shad*10);\r\n        compare.xyz = compare.xyz * Fading.xyz;\r\n        compare.x = compare.x * shadColor0.a;\r\n        compare.y = compare.y * shadColor1.a;\r\n        float fCompare = dot(compare, float3(1.0, 1.0, 0.0));\r\n        \r\n        float3 color = decalColor.xyz * Ambient.xyz;\r\n        color = HDREncodeAmb(color);\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = fCompare;"
    }
  ],
