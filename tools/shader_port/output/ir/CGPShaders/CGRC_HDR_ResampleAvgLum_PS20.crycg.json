  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n  uniform sampler2D baseMap : texunit0,\r\n  uniform FLOAT4 vSampleOffsets[16]"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  FLOAT fResampleSum = 0.0f; \r\n  \r\n  for(int i=0; i<16; i++)\r\n  {\r\n    // Compute the sum of luminance throughout the sample points\r\n    FLOAT4 vTex = tex2D(baseMap, IN.Tex0.xy+vSampleOffsets[i].xy);\r\n    fResampleSum += vTex;\r\n  }\r\n  \r\n  // Divide the sum to complete the average\r\n  fResampleSum /= 16;\r\n\r\n  OUT.Color = float4(fResampleSum, fResampleSum, fResampleSum, 1.0f);"
    }
  ],
