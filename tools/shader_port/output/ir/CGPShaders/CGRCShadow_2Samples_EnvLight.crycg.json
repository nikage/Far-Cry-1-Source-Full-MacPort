{
  "name": "CGRCShadow_2Samples_EnvLight",
  "extension": "crycg",
  "path": "CGPShaders/CGRCShadow_2Samples_EnvLight.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadowMap0 : texunit0,\r\n                  uniform sampler2D shadowMap1 : texunit1,\r\n                  uniform sampler2D baseMap : texunit2,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 shadowColor0 = tex2Dproj(shadowMap0, IN.Tex0.xyw);\r\n        float4 shadowColor1 = tex2Dproj(shadowMap1, IN.Tex1.xyw);\r\n        float4 decalColor = tex2D(baseMap, IN.Tex2.xy);\r\n        float3 color = decalColor.xyz * IN.Color.xyz;\r\n        float3 vShadow = (float3)0;\r\n        vShadow.x = shadowColor0.a;\r\n        vShadow.y = shadowColor1.a;\r\n        vShadow.xyz = vShadow.xyz * Fading.xyz;\r\n        float shadow = dot(vShadow.xyz, float3(1, 1, 0));\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = shadow;"
    }
  ],
