  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n                  uniform sampler2D envMap : texunit1,\r\n                  uniform sampler2D baseMap : texunit2,\r\n                  uniform float4 Matrix"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n# ifdef _PS_1_1\r\n        float4 env = offsettex2D(envMap, IN.Tex1.xy, bumpColor, Matrix);\r\n# else\r\n        float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n        float4 env = tex2D(envMap, newst);\r\n# endif\r\n       // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex2.xy);\r\n        OUT.Color = env + decalColor;"
    }
  ],
