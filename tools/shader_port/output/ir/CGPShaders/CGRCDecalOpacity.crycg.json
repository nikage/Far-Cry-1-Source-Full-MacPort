  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D opacityMap : texunit1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the opacity\r\n        float4 opColor = tex2D(opacityMap, IN.Tex1.xy);\r\n        float4 color = IN.Color * decalColor;\r\n        color.a = color.a * opColor.a;\r\n        OUT.Color = color;"
    }
  ],
