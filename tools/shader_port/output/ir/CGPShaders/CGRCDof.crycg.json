  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n#ifdef OPENGL\r\n    uniform samplerRECT ScreenMap : texunit0,\r\n    uniform samplerRECT FocalDistMap : texunit1,\r\n#endif    \r\n#ifdef D3D\r\n    uniform sampler2D ScreenMap : register(s0),\r\n    uniform sampler2D FocalDistMap : register(s1),\r\n#endif    \r\n    uniform float4 vFocalDistance,\r\n    uniform float4 vBlurAmount,\r\n    uniform float4 vPixelSize"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1 \r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n    // fetch textures\r\n#ifdef OPENGL\r\n    float4 vTapCenterColor = texRECT(ScreenMap, IN.Tex0.xy);\r\n    float4 vTapBluredColor = texRECT(FocalDistMap, IN.Tex1.xy);\r\n#endif    \r\n#ifdef D3D\r\n    float4 vTapCenterColor = tex2D(ScreenMap, IN.Tex0.xy);\r\n    float4 vTapBluredColor = tex2D(FocalDistMap, IN.Tex1.xy);\r\n#endif\t\r\n\r\n\tfloat4 tapCenter=vTapCenterColor;\r\n\tfloat4 tapBlured=vTapBluredColor;\r\n\t\r\n\t/*\r\n\tconst float2 vTaps[10]={\r\n        float2(0.0,0.0),\r\n        float2(0.527837, -0.085868),\r\n        float2(-0.040088, 0.536087),\r\n        float2(-0.670445, -0.179949),\r\n        float2(-0.419418, -0.616039),\r\n        float2(0.440453, -0.639399),\r\n        float2(-0.757088, 0.349334),\r\n        float2(0.574619, 0.685879),\r\n        float2(0.03851, -0.939059),\r\n        float2(-0.341977, 0.939091)\r\n    };\t                        \t                        \t                        \t                        \t                        \t                        \t                  \t\t\t\t\t\t\t\t\t\t\t\r\n    \r\n    float4 vFinalColor=0;    \r\n    for(int t=0;t<4;t++)\r\n    {        \r\n        float2 vLowUv=IN.Tex1.xy+vPixelSize.xy*(vTaps[t].xy);        \r\n        float4 tapLow= tex2D(FocalDistMap, vLowUv.xy);\r\n                \r\n        float2 vHighUv=IN.Tex0.xy+vPixelSize.zw*(vTaps[t].xy);                \r\n        float4 tapHigh= tex2D(ScreenMap, vHighUv.xy);\r\n                \r\n        float4 tap=(tapLow*tapHigh.w+tapHigh*(1.0-tapHigh.w));        \r\n        tap.w=(tapHigh.w-tapCenter.w>=0)? 1.0: tap.w;\r\n        \r\n        vFinalColor.xyz+=tap.xyz*tap.w;\r\n        vFinalColor.w+=tap.w;\r\n    }\r\n    // normalize color\r\n    vFinalColor/=vFinalColor.w;*/\r\n    \r\n    float tapLerp=tapCenter.w*0.5+tapBlured.w*0.5;        \r\n    float3 vFinalColor=tapBlured.xyz*tapCenter.w+tapCenter.xyz*(1-tapCenter.w);\r\n    \r\n    OUT.Color.xyz = vFinalColor.xyz*vBlurAmount.w+tapCenter.xyz*(1-vBlurAmount.w);\r\n    OUT.Color.a = 1;"
    }
  ],
