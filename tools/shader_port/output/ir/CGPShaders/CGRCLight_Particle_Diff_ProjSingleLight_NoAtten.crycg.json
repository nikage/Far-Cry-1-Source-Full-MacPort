{
  "name": "CGRCLight_Particle_Diff_ProjSingleLight_NoAtten",
  "extension": "crycg",
  "path": "CGPShaders/CGRCLight_Particle_Diff_ProjSingleLight_NoAtten.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE projMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n# ifdef _HDR_MRT\r\n        FOUT_2\r\n# else\r\n        FOUT\r\n# endif"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);\r\n\r\n        float3 dif = (decalColor.xyz * projColor.xyz * Diffuse.xyz * IN.Color.xyz);\r\n        dif.xyz = HDREncode(dif.xyz);\r\n  \r\n        float3 amb = HDREncodeAmb(decalColor.xyz * Ambient.xyz);\r\n\r\n        // finally add them all together\r\n        float fOutA = decalColor.w * Ambient.w * IN.Color.a;\r\n        HDROutput(OUT, FLOAT4 (amb + dif, fOutA), 1, GlobalFogColor.xyz, IN.Color1.w);"
    }
  ],
