  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D fadeMap : texunit1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the fade color\r\n        float4 fadeColor = tex2D(fadeMap, IN.Tex1.xy);\r\n        \r\n        float4 color = decalColor * IN.Color;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.w = color.w * fadeColor.b;"
    }
  ],
