  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n#ifdef OPENGL\r\n            uniform samplerRECT refMap : texunit1,             \r\n#endif\r\n#ifdef D3D\r\n            uniform sampler2D refMap : texunit1,\r\n#endif\r\n            uniform float4 Matrix,\r\n            uniform float4 Ambient,\r\n            uniform float4 WaterColor"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_C0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load the decal\r\n  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);\r\n  \r\n// must create 2 versions, since offsetRECT/samplerRECT must be used for gl version...\r\n#ifdef D3D\r\n  # ifdef _PS_1_1\r\n    float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);\r\n  # else\r\n    float2 newst = IN.Tex1.xy / IN.Tex1.w;\r\n    newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n    float4 refrColor = tex2D(refMap, newst);\r\n  # endif\r\n#endif\r\n#ifdef OPENGL\r\n  # ifdef _PS_1_1\r\n    float4 refrColor = offsettexRECT(refMap, IN.Tex1.xy, bumpColor, Matrix);\r\n  # else\r\n    float2 newst = IN.Tex1.xy / IN.Tex1.w;\r\n    newst = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n    float4 refrColor = texRECT(refMap, newst);\r\n  # endif\r\n#endif  \r\n\r\n# ifdef _HDR\r\n\trefrColor.xyz = refrColor.xyz * 2;\r\n# endif\t\r\n\r\n  OUT.Color.xyz = refrColor.xyz*WaterColor.xyz;                                   // compute final water refraction color\r\n  OUT.Color.w = 1; //IN.Color.w;                                                   // output fresnel term"
    }
  ],
