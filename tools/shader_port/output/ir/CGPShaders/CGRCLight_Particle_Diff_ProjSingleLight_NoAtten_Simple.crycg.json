{
  "name": "CGRCLight_Particle_Diff_ProjSingleLight_NoAtten_Simple",
  "extension": "crycg",
  "path": "CGPShaders/CGRCLight_Particle_Diff_ProjSingleLight_NoAtten_Simple.crycg",
