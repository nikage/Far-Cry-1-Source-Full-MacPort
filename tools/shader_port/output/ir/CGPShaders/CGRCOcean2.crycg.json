  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n                  uniform samplerCUBE envMap : texunit3,\r\n                  uniform float4 WaterColor0,\r\n                  uniform float4 WaterColor1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);\r\n        float4 env = texCUBE_reflect_dp3x3(envMap, IN.Tex3, IN.Tex1, IN.Tex2, bumpColor);\r\n        \r\n        float4 color = WaterColor1 - WaterColor0;\r\n        color.xyz = (WaterColor1.xyz + color.xyz * IN.Color.xyz) * env.xyz;\r\n        color.a = (WaterColor1.a + color.a * IN.Color.b) * IN.Color.a;\r\n\r\n        OUT.Color = color;"
    }
  ],
