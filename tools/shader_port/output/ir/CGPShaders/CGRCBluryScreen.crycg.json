  "blocks": [
    {
      "name": "MainInput",
      "content": " \r\n#ifdef OPENGL\r\n\tuniform samplerRECT baseMap0 : texunit0,    \r\n  uniform samplerRECT baseMap1 : texunit1,\r\n#endif  \r\n#ifdef D3D\r\n\tuniform sampler2D baseMap0 : texunit0,    \r\n  uniform sampler2D baseMap1 : texunit1,\r\n#endif  \r\n    uniform float4 fBluryParams"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\tstruct vertout\r\n\t{\r\n\t  OUT_T0\r\n\t  OUT_T1\r\n\t};\r\n\r\n\tFOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\t// load the decal\r\n#ifdef OPENGL\r\n\tfloat4 fColor0 = texRECT(baseMap0, IN.Tex0.xy);\r\n\tfloat4 fColor1 = texRECT(baseMap1, IN.Tex1.xy);\r\n#endif\r\n#ifdef D3D\r\n\tfloat4 fColor0 = tex2D(baseMap0, IN.Tex0.xy);\r\n\tfloat4 fColor1 = tex2D(baseMap1, IN.Tex1.xy);\r\n#endif\r\n\r\n\tfloat fTemp = dot(float3(0.33, 0.59, 0.11), fColor0.xyz);\r\n\tfloat3 fDesaturated= fTemp*fBluryParams.xyz; //lerp(fColor0.xyz, fTemp, 0.5)\r\n\r\n\t// finally add them all together\t\r\n\tOUT.Color.xyz = lerp(fColor1.xyz, fDesaturated*fDesaturated*4, fBluryParams.w);                \r\n\tOUT.Color.w = 1.0f;"
    }
  ],
