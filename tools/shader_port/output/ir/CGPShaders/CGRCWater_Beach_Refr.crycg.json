  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n                  uniform sampler2D baseMap : texunit1,\r\n                  uniform float4 Matrix,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the bump\r\n        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);\r\n        \r\n# ifdef _PS_1_1\r\n        float4 decalColor = offsettex2D(baseMap, IN.Tex1.xy, bumpColor, Matrix);                 // get env bump map       \r\n# else\r\n        float2 newst = IN.Tex1.xy;\r\n        newst.xy = newst.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n        float4 decalColor = tex2D(baseMap, newst.xy);\r\n# endif        \r\n        \r\n        float3 amb = decalColor.xyz * Ambient.xyz * IN.Color.xyz;\r\n        \r\n# ifdef _HDR\r\n\t      amb.xyz = amb.xyz * 4;\r\n# endif\t\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb.xyz;\r\n        OUT.Color.w = decalColor.w * Ambient.w *IN.Color.a;"
    }
  ],
