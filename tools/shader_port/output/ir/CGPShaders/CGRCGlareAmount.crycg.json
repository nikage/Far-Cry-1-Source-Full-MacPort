    {
      "name": "MainInput",
      "content": " \r\n#ifdef OPENGL\r\n  uniform samplerRECT texScreen01 : texunit0,\r\n\tuniform samplerRECT texScreen02 : texunit1,\r\n\tuniform samplerRECT texScreen03 : texunit2,\r\n\tuniform samplerRECT texScreen04 : texunit3,\t\t\r\n#endif\r\n#ifdef D3D\r\n  uniform sampler2D texScreen01 : texunit0,\r\n\tuniform sampler2D texScreen02 : texunit1,\r\n\tuniform sampler2D texScreen03 : texunit2,\r\n\tuniform sampler2D texScreen04 : texunit3,\t\t\r\n#endif\r\n\t\r\n\tuniform float4 Glare"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\tstruct vertout\r\n\t{\r\n\t  OUT_T0\r\n\t  OUT_T1\r\n\t  OUT_T2\r\n\t  OUT_T3\r\n\t};\r\n\r\n\tFOUT"
    },
    {
      "name": "CoreScript",
      "content": "\t\r\n#ifdef OPENGL\r\n\tfloat4 vColor01 = texRECT(texScreen01 , IN.Tex0.xy);\r\n\tfloat4 vColor02 = texRECT(texScreen02 , IN.Tex1.xy);\r\n\tfloat4 vColor03 = texRECT(texScreen03 , IN.Tex2.xy);\r\n\tfloat4 vColor04 = texRECT(texScreen04 , IN.Tex3.xy);\r\n#endif\r\n#ifdef D3D\r\n\tfloat4 vColor01 = tex2D(texScreen01 , IN.Tex0.xy);\r\n\tfloat4 vColor02 = tex2D(texScreen02 , IN.Tex1.xy);\r\n\tfloat4 vColor03 = tex2D(texScreen03 , IN.Tex2.xy);\r\n\tfloat4 vColor04 = tex2D(texScreen04 , IN.Tex3.xy);\r\n#endif\r\n\t\r\n\tfloat3 vAvgColor=saturate(saturate(vColor01.xyz*0.25+vColor02.xyz*0.25+vColor03.xyz*0.25+vColor04.xyz*0.25)); //*0.8+0.2);\r\n\tvAvgColor=saturate(4*vAvgColor*vAvgColor);\r\n\tfloat fAvgLum=dot(float3(0.3, 0.59, 0.11), vAvgColor.xyz);\r\n\t\t\r\n\t// only output luminosity\r\n\tOUT.Color.xyz = fAvgLum; //saturate(2*fAvgLum*fAvgLum);\r\n\tOUT.Color.w = Glare.w;"
    }
  ],
