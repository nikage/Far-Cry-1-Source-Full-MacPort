      "name": "MainInput",
      "content": "\r\n\tuniform sampler2D baseMap0 : texunit0,\r\n\tuniform sampler2D baseMap1 : texunit1,\r\n\tuniform sampler2D baseMap2 : texunit2,\r\n\tuniform sampler2D baseMap3 : texunit3"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\tstruct vertout\r\n\t{\r\n\t  OUT_T0\r\n\t  OUT_T1\r\n\t  OUT_T2\r\n\t  OUT_T3\r\n\t};\r\n\r\n\tFOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\t// load the decal\r\n\tfloat4 color0 = tex2D(baseMap0, IN.Tex0.xy);\r\n\tfloat4 color1 = tex2D(baseMap1, IN.Tex1.xy);\r\n\tfloat4 color2 = tex2D(baseMap2, IN.Tex2.xy);\r\n\tfloat4 color3 = tex2D(baseMap3, IN.Tex3.xy);\r\n\r\n  // safe/acurate version\r\n\t//float4 avg= float4(0.5, 0.5, 0.5, 0.5);\r\n\t//float4 colorA = saturate(color0*avg+color1*avg)*0.5;\r\n\t//float4 colorB = saturate(color2*avg+color3*avg)*0.5;\r\n\t\r\n\t// fast version\r\n\tfloat4 avg=saturate(color0*0.25+color2*0.25+color1*0.25+color3*0.25);\r\n\t\r\n\t// finally add them all together\r\n\tOUT.Color =avg;"
    }
  ],
