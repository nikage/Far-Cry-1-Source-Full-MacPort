  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D alphaMap : texunit1,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the alpha\r\n        float4 alphaColor = tex2D(alphaMap, IN.Tex1.xy);\r\n        \r\n        float3 color = (decalColor.xyz * alphaColor.xyz * Ambient.xyz);\r\n        color.xyz = HDREncode(color.xyz);\r\n\r\n        OUT.Color.xyz = HDRFogBlend(color.xyz, IN.Color.w, GlobalFogColor.xyz);\r\n        OUT.Color.a = decalColor.a * alphaColor.a * Ambient.a;"
    }
  ],
