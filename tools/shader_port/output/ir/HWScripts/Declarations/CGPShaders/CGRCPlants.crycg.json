      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n# ifdef _HDR_MRT\r\n        FOUT_2\r\n# else\r\n        FOUT\r\n# endif"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 color;\r\n        color = decalColor * IN.Color;\r\n        color.xyz = HDREncode(color.xyz);\r\n        HDROutput(OUT, color, 1, GlobalFogColor.xyz, IN.Color1.w);"
    }
  ],
