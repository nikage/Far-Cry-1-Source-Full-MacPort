  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " \r\n#ifdef OPENGL\r\n    uniform samplerRECT ScreenTex : texunit0,\r\n    uniform samplerRECT GlareTex : texunit1,\r\n#endif\r\n#ifdef D3D\r\n    uniform sampler2D ScreenTex : texunit0,\r\n    uniform sampler2D GlareTex : texunit1,\r\n#endif\r\n    uniform float4    vSaturationAmount,\r\n    uniform float4    vConstrastAmount,\r\n    uniform float4    vConstrastAmount02"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n    struct vertout\r\n    {\r\n      OUT_T0\r\n      OUT_T1\r\n    };\r\n\r\n    FOUT"
    },
    {
      "name": "CoreScript",
      "content": "         \r\n#ifdef OPENGL\r\n    // get screen\r\n    float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);\r\n    // get glare map\r\n    float4 fGlareColor  = texRECT(GlareTex, IN.Tex1.xy);\r\n#endif\r\n#ifdef D3D\r\n    // get screen\r\n    float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);\r\n    // get glare map\r\n    float4 fGlareColor  = tex2D(GlareTex, IN.Tex1.xy);\r\n#endif\r\n    \r\n    // ## Add glare to scene ##    \r\n    float3 vFinalGlareColor=saturate(fGlareColor.xyz+fScreenColor.xyz);\r\n    float3 vLum=dot(fScreenColor.xyz, float3(0.3, 0.59, 0.11));        \r\n    float3 vFinalComposing=saturate(fScreenColor.xyz*(1-vLum.z) + vFinalGlareColor.xyz*vLum.z );\r\n            \r\n    // ## adjust scene saturation ##\r\n    //float3 vSceneLuminosity = saturate(dot(float3(0.33, 0.59, 0.11), vFinalComposing.xyz));        \r\n    float3 vSaturationAdjust=saturate(vFinalComposing.xyz*(1-vSaturationAmount.w) + vLum.xyz*vSaturationAmount.w );\r\n                \r\n    // ## adjust scene contrast ##  Optimization: Not used anymore                    \r\n    //float  fContrastLerp=saturate(fGlareColor.w*vConstrastAmount.w+vConstrastAmount02.w);    \r\n    //float3 vConstrastAdjust=saturate(lerp( 2*(vSaturationAdjust.xyz-0.5), vSaturationAdjust.xyz, fContrastLerp));\r\n                                                \r\n    OUT.Color.xyz =vSaturationAdjust;\r\n    OUT.Color.w=1;"
    }
  ],
