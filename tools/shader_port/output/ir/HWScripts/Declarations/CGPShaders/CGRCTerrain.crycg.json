  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_C0\r\n        };\r\n\r\n# ifdef _HDR_MRT\r\n        FOUT_2\r\n# else\r\n        FOUT\r\n# endif"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float3 vColor;\r\n        vColor.xyz = (Ambient.xyz * decalColor.xyz * IN.Color.xyz);\r\n        vColor.xyz = HDREncode(vColor.xyz);\r\n        \r\n        HDROutput(OUT, FLOAT4 (vColor.xyz, Ambient.a * decalColor.a), 1, GlobalFogColor.xyz, IN.Color.w);"
    }
  ],
