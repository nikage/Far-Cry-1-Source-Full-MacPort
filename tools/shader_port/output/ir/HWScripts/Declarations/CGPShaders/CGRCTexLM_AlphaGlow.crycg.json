  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D lightMap : texunit1,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the lm\r\n        float4 lmColor = tex2D(lightMap, IN.Tex1.xy);\r\n        float3 dif = (decalColor.xyz * lmColor.xyz) * 4;\r\n        float3 amb = decalColor.xyz * decalColor.a + decalColor.xyz * Ambient.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb + dif;\r\n        OUT.Color.w = Ambient.w;"
    }
  ],
