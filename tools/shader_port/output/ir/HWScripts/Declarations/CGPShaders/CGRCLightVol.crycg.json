  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // IN.Tex1.xyz = fPos;\r\n        // IN.Tex2.xyz = lPos;\r\n        // IN.Tex3.xyz = lightVec;\r\n        // IN.Tex4.xyz = normal;\r\n\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n\r\n        float v1 = dot(IN.Tex1.xyz, IN.Tex1.xyz);\r\n        float v2 = dot(IN.Tex1.xyz, IN.Tex2.xyz);\r\n        float3 p = saturate(v2 / v1) * IN.Tex1.xyz - IN.Tex2.xyz;\r\n        float fP = dot(p, p) * 0.02 + 1.2;\r\n        float fT = dot(IN.Tex3.xyz, IN.Tex3.xyz) * 0.004 + 1;\r\n        float fDiffuse = saturate(dot(IN.Tex3.xyz, IN.Tex4.xyz));\r\n        fT = fDiffuse / fT + 0.1;\r\n        float3 color = decalColor.xyz * fT + 1 / fP;\r\n\r\n        OUT.Color.xyz = color.xyz*Diffuse.xyz;\r\n        OUT.Color.w = decalColor.w * Diffuse.w;"
    }
  ],
