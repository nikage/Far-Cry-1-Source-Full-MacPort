    {
      "name": "MainInput",
      "content": "\r\n#ifdef OPENGL\r\n  uniform samplerRECT baseMap0 : texunit0\r\n#endif  \r\n#ifdef D3D\r\n  uniform sampler2D baseMap0 : texunit0\r\n#endif"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load the decal\r\n#ifdef OPENGL\r\n  float4 mColor0 = texRECT(baseMap0, IN.Tex0.xy);\r\n#endif  \r\n#ifdef D3D\r\n  float4 mColor0 = tex2D(baseMap0, IN.Tex0.xy);\r\n#endif  \r\n  \r\n    \r\n  float s0=saturate(dot(float3(0.30, 0.59, 0.11), mColor0.xyz))*0.9;        \r\n  float3 v0=mColor0.xyz*0.75+ s0.xxx*0.25;        \r\n  mColor0.xyz=saturate(v0+v0*float3(0.25, 0.24, 0.2));\r\n  \r\n                       \r\n  OUT.Color.xyz =  mColor0.xyz; //mColor0.xyz;\r\n  OUT.Color.w   = 1.0;"
    }
  ],
