  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D detMap0 : texunit0,\r\n                  uniform sampler2D detMap1 : texunit1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the detail\r\n        float4 detColor0 = tex2D(detMap0, IN.Tex0.xy);\r\n        float4 detColor1 = tex2D(detMap1, IN.Tex1.xy);\r\n        \r\n        detColor0.xyz = detColor0.xyz*IN.Color.b + 0.5*(1-IN.Color.b);\r\n        detColor1.xyz = detColor1.xyz*IN.Color1.b + 0.5*(1-IN.Color1.b);\r\n        float3 color = detColor0.xyz * detColor1.xyz * 2;\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = 1;"
    }
  ],
