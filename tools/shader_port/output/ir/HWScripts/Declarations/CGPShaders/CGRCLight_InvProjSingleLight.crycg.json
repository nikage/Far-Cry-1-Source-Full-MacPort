  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform samplerCUBE projMap : texunit0,\r\n                  uniform sampler2D attenMap : texunit1,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 projColor = texCUBE(projMap, IN.Tex0.xyz);\r\n        float atten = saturate((2*(IN.Color.b-0.5)) * -(2*(IN.Color.b-0.5)) + (1-tex2D(attenMap, IN.Tex1.xy).b));\r\n        atten = atten * IN.Color.a;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = Ambient.xyz*atten + projColor.xyz*(1-atten);\r\n        OUT.Color.w = Ambient.w;"
    }
  ],
