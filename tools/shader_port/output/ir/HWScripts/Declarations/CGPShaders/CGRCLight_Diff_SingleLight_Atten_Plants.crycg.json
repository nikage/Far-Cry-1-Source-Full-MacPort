{
  "name": "CGRCLight_Diff_SingleLight_Atten_Plants",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCLight_Diff_SingleLight_Atten_Plants.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D attenMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float atten = saturate((2*(IN.Color.a-0.5)) * -(2*(IN.Color.a-0.5)) + (1-tex2D(attenMap, IN.Tex1.xy).b));\r\n\r\n        // Light vector from normalization cube-map\r\n        float3 dif = HDREncode(decalColor.xyz * atten * Diffuse.xyz);\r\n        float3 amb = HDREncode(Ambient.xyz * decalColor.xyz * IN.Color.xyz);\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = HDRFogBlend(amb + dif, IN.Color1.w, GlobalFogColor.xyz);\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
