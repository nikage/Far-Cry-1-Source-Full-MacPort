  "blocks": [
    {
      "name": "MainInput",
      "content": " \r\n#ifdef OPENGL\r\n\tuniform samplerRECT baseMap : texunit0,\r\n\tuniform samplerRECT glareAmountMap : texunit1,\r\n#endif\r\n#ifdef D3D\r\n\tuniform sampler2D baseMap : texunit0,\r\n\tuniform sampler2D glareAmountMap : texunit1,\r\n#endif\r\n\tuniform float4 vGlare,\r\n\tuniform float4 vGlareAmount"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n\tstruct vertout\r\n\t{\r\n\t  OUT_T0\r\n\t  OUT_T1\r\n\t};\r\n\r\n\tFOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n#ifdef OPENGL\r\n\t// load the decal\r\n\tfloat4 glareColor = texRECT(baseMap, IN.Tex0.xy);\r\n\tfloat4 glareAmount= texRECT(glareAmountMap, IN.Tex1.xy);\r\n#endif\r\n#ifdef D3D\r\n\t// load the decal\r\n\tfloat4 glareColor = tex2D(baseMap, IN.Tex0.xy);\r\n\tfloat4 glareAmount= tex2D(glareAmountMap, IN.Tex1.xy);\r\n#endif\r\n\r\n\t     \r\n\t// remove dark pixels, leave brightest ones (color-threshold)*MaxAmount\r\n\t// BTW: i've add to negate vGlare.xyz values from CPP code, since CG generates really wrong instruction on this..\r\n  float3 fGlareMap=saturate(glareColor.xyz+vGlare.xyz)*vGlare.w;\r\n  fGlareMap*=2*fGlareMap;  \r\n    \r\n\t\r\n\tOUT.Color.xyz = fGlareMap*saturate((1-glareAmount.xyz)+vGlareAmount.xyz); \r\n\tOUT.Color.a = glareAmount.z;"
    }
  ],
