{
  "name": "CGRCBump_Spec_MultipleLights_HP_NoAtten",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCBump_Spec_MultipleLights_HP_NoAtten.crycg",
  "includes": [
