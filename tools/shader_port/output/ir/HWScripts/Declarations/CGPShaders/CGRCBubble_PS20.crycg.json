  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : register(s0),\r\n                  uniform samplerCUBE envMap : register(s1),\r\n                  uniform float4 AlphaScaleBias : register(c0)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 baseColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the env cube\r\n        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);\r\n        \r\n        float3 color = saturate(baseColor.xyz * envColor.xyz * 2);\r\n        float fresnel = (1-abs(IN.Tex2.r)) * AlphaScaleBias.x + AlphaScaleBias.y;\r\n        float glow = saturate((envColor.a*envColor.a-0.75)*4);\r\n        \r\n        color = lerp(color.xyz, envColor.xyz, glow);\r\n        float alpha = fresnel + glow;\r\n\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = alpha;"
    }
  ],
