  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : register(s0),\r\n                  uniform samplerCUBE envMap : register(s3),\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 bumpNormal = tex2D(bumpMap, IN.Tex0.xy);\r\n# ifdef _PS_1_1\r\n        float4 env = texCUBE_reflect_dp3x3(envMap, IN.Tex3, IN.Tex1, IN.Tex2, bumpNormal);\r\n# else\r\n        float3 E = float3(IN.Tex1.w, IN.Tex2.w, IN.Tex3.w);\r\n        float3 N = float3(dot(IN.Tex1.xyz, bumpNormal.xyz),\r\n                          dot(IN.Tex2.xyz, bumpNormal.xyz),\r\n                          dot(IN.Tex3.xyz, bumpNormal.xyz));\r\n        float4 env = texCUBE(envMap, 2*(dot(N, E)/dot(N, N))*N - E);\r\n# endif        \r\n        float3 vColor = HDREncodeAmb(env.xyz * IN.Color.xyz);\r\n        OUT.Color.xyz = HDRFogBlend(vColor.xyz, IN.Color1.w, GlobalFogColor.xyz);\r\n        OUT.Color.a = IN.Color.a * Ambient.a;"
    }
  ],
