  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\n                  uniform FLOAT4 Ambient,\n                  uniform FLOAT4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\n        struct vertout\n        {\n          OUT_T0\n          OUT_C0\n          OUT_C1\n        };\n\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\n        FLOAT4 decalColor = tex2D(baseMap, IN.Tex0.xy);\n\n        FLOAT3 dif = (decalColor.xyz * Diffuse.xyz * IN.Color1.xyz * IN.Color.xyz);\n        dif = HDREncode(dif);\n\n        FLOAT3 amb = HDREncodeAmb(decalColor.xyz * Ambient.xyz);\n\n        float fOutA = decalColor.w * Ambient.w * IN.Color.a;\n        HDROutput(OUT, FLOAT4 (amb + dif, fOutA), 1, GlobalFogColor.xyz, IN.Color1.w);"
    }
  ],
