{
  "name": "CGRCRenderModeAdv",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCRenderModeAdv.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " \r\n#ifdef OPENGL\r\n    uniform samplerRECT ScreenTex : texunit0,\r\n    uniform samplerRECT GlareTex : texunit1,\r\n    uniform samplerRECT ScreenBluredTex : texunit2,\r\n#endif\r\n#ifdef D3D\r\n    uniform sampler2D ScreenTex : register(s0),\r\n    uniform sampler2D GlareTex : register(s1),\r\n    uniform sampler2D ScreenBluredTex : register(s2),\r\n#endif\r\n    uniform float4    vParams01,\r\n    uniform float4    vParams02,\r\n    uniform float4    vCMYKParams"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "SubrScript",
      "content": "\r\n    // Convert from a RGB color space to CMYK color space\r\n    float4 RGBToCMKY(float3 vColor)\r\n    {\r\n        float4 vCMYK;\r\n        vCMYK.xyz=saturate(1-vColor.xyz);                         // Convert 1st to CMY= 1-RGB\r\n        vCMYK.w=min(vCMYK.x, min(vCMYK.y, vCMYK.z));    // Compute K = min(C, M, Y) \r\n        vCMYK.xyz=saturate(vCMYK.xyz-vCMYK.www);                  // Compute final CMYK= CMY-K        \r\n        \r\n        return vCMYK;    \r\n    }\r\n\r\n    // Convert from a CMYK color space to RGB color space\r\n    float3 CMKYToRGB(float4 vColor)\r\n    {\r\n        return saturate(1-(vColor.xyz+vColor.www));\r\n    }"
    },
    {
      "name": "CoreScript",
      "content": "         \r\n#ifdef OPENGL\r\n    // get screen\r\n    float4 fScreenColor = texRECT(ScreenTex, IN.Tex0.xy);\r\n    // get glare map\r\n    float4 fGlareColor  = texRECT(GlareTex, IN.Tex1.xy);\r\n    // get blured screen\r\n    float4 fBluredScreenColor = texRECT(ScreenBluredTex, IN.Tex2.xy);\r\n#endif\r\n#ifdef D3D\r\n    // get screen\r\n    float4 fScreenColor = tex2D(ScreenTex, IN.Tex0.xy);\r\n    // get glare map\r\n    float4 fGlareColor  = tex2D(GlareTex, IN.Tex1.xy);\r\n    // get blured screen\r\n    float4 fBluredScreenColor = tex2D(ScreenBluredTex, IN.Tex2.xy);\r\n#endif\r\n\r\n    //const float4 vParams01=float4(1.2, 1.2, 0.1, 1.0); // x= contrast, y= saturation, z= brightness, w= glare intensity\r\n    //const float4 vParams02=float4(0.0, 0.0, 1.5, 1.0); // xy= not used, z= sharpness amount, w= gamma adjust\r\n    //const float4 vCMYKParams=float4(0.0, 0.0, 0.0, 0.0); // x= cyan, y= magenta, z= yellow, w= luminance\r\n            \r\n    fGlareColor*=vParams01.w;   // Adjust glare intensity\r\n    fScreenColor.xyz=fScreenColor.xyz*vParams02.z+fBluredScreenColor.xyz*(1-vParams02.z); // Adjust image sharpeness\r\n    \r\n    // Add glare to scene\r\n    float3 vLum=dot(fScreenColor.xyz, float3(0.3, 0.59, 0.11));                \r\n    float3 vFinalComposing=saturate(fScreenColor.xyz + fGlareColor.xyz - fScreenColor.xyz*fGlareColor.xyz);\r\n    \r\n    // Convert color to CMYK model.\r\n    // Tests: Incresing RED, decreases red component, decreasing red, increases red component..\r\n    float4 vCMYK=RGBToCMKY(vFinalComposing.xyz);\r\n    vCMYK=saturate(vCMYK+vCMYKParams); // adjust Cyans/Magentas/Yellows/Luminance                    \r\n    vFinalComposing.xyz=CMKYToRGB(vCMYK);\r\n    \r\n    float3 vSaturationFinal=saturate(vFinalComposing.xyz*vParams01.y+vLum.xxx*(1-vParams01.y)); // Ajust image saturation\r\n    float3 vContrastFinal=saturate(vSaturationFinal.xyz*vParams01.x+0.5*(1-vParams01.x)); // Ajust image contrast\r\n    float3 vBrightnessFinal=saturate(vContrastFinal.xyz+vParams01.zzz); // Ajust image brightness\r\n    float3 vGammaFinal=saturate(pow(vBrightnessFinal.xyz, vParams02.w)); // Ajust image gamma                                    \r\n               \r\n    OUT.Color.xyz =vGammaFinal.xyz; //vGammaFinal.xyz;  \r\n    OUT.Color.w=1;"
    }
  ],
