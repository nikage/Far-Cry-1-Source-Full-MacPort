  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D detMap0 : texunit0,\r\n                  uniform sampler2D detMap1 : texunit1,\r\n                  uniform sampler2D detMap2 : texunit2,\r\n                  uniform sampler2D detMap3 : texunit3"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the detail\r\n        float4 detColor0 = tex2D(detMap0, IN.Tex0.xy);\r\n        float4 detColor1 = tex2D(detMap1, IN.Tex1.xy);\r\n        float4 detColor2 = tex2D(detMap2, IN.Tex2.xy);\r\n        float4 detColor3 = tex2D(detMap2, IN.Tex3.xy);\r\n        \r\n        detColor0.xyz = detColor0.xyz*IN.Color.b + 0.5*(1-IN.Color.b);\r\n        detColor1.xyz = detColor1.xyz*IN.Color1.b + 0.5*(1-IN.Color1.b);\r\n        detColor2.xyz = detColor2.xyz*IN.Color1.g + 0.5*(1-IN.Color1.g);\r\n        detColor3.xyz = detColor3.xyz*IN.Color.a + 0.5*(1-IN.Color.a);\r\n        float3 color = detColor0.xyz * detColor1.xyz * 2;\r\n        color.xyz = color * detColor2.xyz * 2;\r\n        color.xyz = color * detColor3.xyz * 2;\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = 1;"
    }
  ],
