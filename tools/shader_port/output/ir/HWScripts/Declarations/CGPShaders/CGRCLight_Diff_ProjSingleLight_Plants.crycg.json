{
  "name": "CGRCLight_Diff_ProjSingleLight_Plants",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCLight_Diff_ProjSingleLight_Plants.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE projMap : texunit1,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n\r\n        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);\r\n\r\n        float3 dif = (decalColor.xyz * IN.Color.a * projColor.xyz * Diffuse.xyz);\r\n        dif.xyz = HDREncode(dif.xyz);\r\n        float3 amb = Ambient.xyz * decalColor.xyz * IN.Color.xyz;\r\n        amb.xyz = HDREncode(amb.xyz);\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = HDRFogBlend(amb + dif, IN.Color1.w, GlobalFogColor.xyz);\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
