{
  "name": "CGRCShadow_PartPoint_Depth_1Samples",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCShadow_PartPoint_Depth_1Samples.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadMap0 : register(s0),\r\n                  uniform sampler2D baseMap : register(s1),\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        FLOAT4 decalColor = tex2D(baseMap, IN.Tex1.xy);\r\n\r\n        FLOAT3 dif = (decalColor.xyz * Diffuse.xyz * IN.Color1.xyz * IN.Color.xyz);\r\n        FLOAT3 amb = decalColor.xyz * Ambient.xyz;\r\n        dif = HDREncode(dif);\r\n        amb = HDREncodeAmb(amb);\r\n\r\n        // load the 1 shadow sample\r\n        FLOAT4 shadColor0 = tex2Dproj(shadMap0, IN.Tex0.xyzw);\r\n        FLOAT fShadow = (1-shadColor0.b) * Fading.x;\r\n                \r\n        OUT.Color.xyz = amb + dif * (1-fShadow);\r\n        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;"
    }
  ],
