      "name": "MainInput",
      "content": " \r\n  uniform sampler2D baseMap : texunit0,\r\n  uniform sampler2D opacityMap : texunit1,\r\n  uniform sampler2D reflMap : texunit2,\r\n  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n    OUT_C0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load the decal\r\n  float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n  float4 opColor = tex2D(opacityMap, IN.Tex1.xy);\r\n  float4 reflColor = tex2D(reflMap, IN.Tex2.xy);\r\n  \r\n  float3 vFinalRefl=reflColor.xyz*opColor.xyz;\r\n//  vFinalRefl*=vFinalRefl;\r\n  float3 vFinalDecal=saturate(decalColor.xyz+vFinalRefl.xyz);//-decalColor.xyz*vFinalRefl.xyz);\r\n  //vFinalDecal*=vFinalDecal;\r\n    \r\n  float3 vFinal=2*vFinalDecal.xyz*IN.Color.xyz+vFinalDecal.xyz*Ambient.xyz;\r\n \r\n  OUT.Color.xyz = vFinal;\r\n  OUT.Color.w = 1.0;"
    }
  ],
