{
  "name": "CGRCWaterTank",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCWaterTank.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " \r\n    uniform sampler2D baseMap : register(s0),\r\n    uniform sampler2D refrMap : register(s1),\r\n    uniform sampler2D envMap : register(s2),\r\n    uniform float4 Matrix,\r\n    uniform float4 Ambient,\r\n    uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n    struct vertout\r\n    {\r\n      OUT_T0\r\n      OUT_T1\r\n      OUT_T2\r\n      OUT_T3\r\n      OUT_T4\r\n      OUT_C0\r\n    };\r\n\r\n    FOUT"
    },
    {
      "name": "CoreScript",
      "content": "   \r\n    float4 bumpColorA = tex2D(baseMap, IN.Tex0.xy);\r\n    float4 bumpColorB = tex2D(baseMap, IN.Tex0.zw);\r\n    float4 bumpColor = (bumpColorA*0.5+bumpColorB*0.5);\r\n\r\n    const float2 vScale=float2(0.01, 0.01);\r\n    float2 vNewUv= (IN.Tex1.xy/IN.Tex1.w) + vScale.xy*bumpColor.xy;\r\n    float4 refrColor = tex2D(refrMap, vNewUv);\r\n    \r\n    // compute illumination\r\n    float3 vAmbient=(Ambient.xyz+Ambient.xyz*saturate(dot(normalize(IN.Tex3.xyz), bumpColor.xyz)));    \r\n    float3 vDiffuse=saturate(dot(normalize(IN.Tex4.xyz), bumpColor.xyz))*Diffuse.xyz*IN.Color.w;\r\n    float3 vIllum=saturate(vAmbient*0.25+vDiffuse*0.75);\r\n\r\n    float3 vView=normalize(IN.Tex3.xyz);\r\n    float3 vNormal=normalize(IN.Tex4.xyz);\r\n\r\n    // compute per-pixel reflection vector for enviromental bump mapping\r\n    float fReflDot= dot(vView.xyz, vNormal.xyz);  \r\n    float3 reflVector =(2.0*vNormal.xyz*fReflDot-vView.xyz);  \r\n    float2 vEnvUV= (reflVector.xy+1.0)*0.5+ Matrix.xw * bumpColor.xy;\r\n\r\n    float4 envColor = tex2D(envMap, vEnvUV.xy);\r\n    envColor*=envColor;\r\n//    envColor*=envColor;\r\n\r\n    OUT.Color.xyz =(envColor+refrColor)*Diffuse.xyz; //float3(0.0, 0.8, 0.5);//envColor.xyz*vDiffuse.xyz+refrColor.xyz*Ambient.xyz; //*0.8+vIllum*0.2;\r\n    OUT.Color.a = 1;"
    }
  ],
