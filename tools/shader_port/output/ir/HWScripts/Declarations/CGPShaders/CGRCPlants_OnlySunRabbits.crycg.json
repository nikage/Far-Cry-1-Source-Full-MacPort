      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D sunMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Sun"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the decal\r\n        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);\r\n        float3 colorS = sunColor.xyz * IN.Color.a * Ambient.xyz * Sun.a;\r\n        color.xyz = colorS;\r\n        color.a = decalColor.a * Ambient.a;\r\n        OUT.Color = color;"
    }
  ],
