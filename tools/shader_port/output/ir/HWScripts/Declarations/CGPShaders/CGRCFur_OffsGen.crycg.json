  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D offsMap : register(s0),\r\n                  uniform sampler2D clampMap : register(s1)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the offset\r\n        float4 vOffs = tex2D(offsMap, IN.Tex0.xy);\r\n        \r\n        float2 vForce = IN.Tex1.xy*0.5+0.5;\r\n        float2 offs = IN.Tex2.x*vForce.xy + (1-IN.Tex2.x)*vOffs.xy;\r\n\r\n        float4 vClamp = tex2D(clampMap, offs.xy);\r\n        \r\n        OUT.Color = vClamp;"
    }
  ],
