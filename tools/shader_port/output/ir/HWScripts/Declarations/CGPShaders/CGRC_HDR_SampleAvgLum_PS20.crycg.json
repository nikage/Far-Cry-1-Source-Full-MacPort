  "blocks": [
    {
      "name": "MainInput",
      "content": "\r\n  uniform sampler2D baseMap : texunit0,\r\n  uniform FLOAT4 vSampleOffsets[9]"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  FLOAT3 vSample = 0.0f;\r\n  FLOAT  fLogLumSum = 0.0f;\r\n  FLOAT3 LUMINANCE_VECTOR  = FLOAT3 (0.2125f, 0.7154f, 0.0721f);\r\n\r\n  for(int i=0; i<9; i++)\r\n  {\r\n    // Compute the sum of log(luminance) throughout the sample points\r\n    vSample = tex2D(baseMap, IN.Tex0.xy+vSampleOffsets[i].xy);\r\n    fLogLumSum += log(dot(vSample, LUMINANCE_VECTOR)+0.0001);\r\n  }\r\n  \r\n  // Divide the sum to complete the average\r\n  fLogLumSum /= 9;\r\n\r\n  OUT.Color = float4(fLogLumSum, fLogLumSum, fLogLumSum, 1.0f);"
    }
  ],
