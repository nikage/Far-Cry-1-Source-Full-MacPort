  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadMap0 : register(s0),\r\n                  uniform sampler2D baseMap : register(s1),\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex1.xy);\r\n\r\n        float3 dif = (decalColor.xyz * Diffuse.xyz * IN.Color1.xyz * IN.Color.xyz) * 2;\r\n        float3 amb = decalColor.xyz * Ambient.xyz;\r\n\r\n        // load the 1 shadow sample\r\n        float4 shadColor0 = tex2Dproj(shadMap0, IN.Tex0.xyzw);\r\n        float shad = shadColor0.r/8 + shadColor0.g;\r\n        float fZ = IN.Tex2.x / IN.Tex2.y;\r\n        shad = shad - fZ;\r\n        //float fCompare = step(shad, 0.0);\r\n        float fCompare = saturate(-shad*10);\r\n        fCompare = fCompare * shadColor0.a * Fading.x;\r\n                \r\n        OUT.Color.xyz = amb + dif * (1-fCompare);\r\n        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;"
    }
  ],
