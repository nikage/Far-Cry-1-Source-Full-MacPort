  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform samplerCUBE envMap : texunit3,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Specular"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n        bumpNormal.xyz = normalize(bumpNormal.xyz);\r\n        float3 lightVec = normalize(IN.Tex2.xyz);\r\n        float NdotL = saturate(dot(bumpNormal.xyz, lightVec));\r\n        float3 reflVec = (2*NdotL*bumpNormal.xyz)-lightVec.xyz;\r\n        float4 envSpec = texCUBE(envMap, reflVec);\r\n        float3 lit = IN.Color.xyz * Diffuse.xyz * decalColor.xyz * 2;\r\n        float3 spec = envSpec.xyz * Specular.xyz * 2;\r\n        OUT.Color.xyz = lit + spec;\r\n        OUT.Color.w = decalColor.w * Diffuse.w;"
    }
  ],
