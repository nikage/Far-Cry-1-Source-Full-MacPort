{
  "name": "CGRCLava",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCLava.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D difMap : texunit0,\r\n            uniform sampler2D bumpMap : texunit1,\r\n            uniform sampler2D refMap : texunit2,            \r\n            uniform float4 Matrix,\r\n            uniform float4 Ambient,\r\n            uniform float4 LavaColor"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n    OUT_C0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "  \r\n  // load the decal\r\n  float4 difColor  = tex2D(difMap,  IN.Tex0.xy);\r\n  float4 bumpColor = tex2D(bumpMap, IN.Tex1.xy);      \r\n\r\n# ifdef _PS_1_1\r\n  float4 refrColor = offsettex2D(refMap, IN.Tex2.xy, bumpColor, Matrix);          // get env bump map surface\r\n# else\r\n        float2 newst = IN.Tex2.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n        float4 refrColor = tex2D(refMap, newst);\r\n# endif                \r\n  \r\n  float fLum=2*(dot(refrColor.xyz, float3(0.0, 1.0, 0.0))-0.5);    \r\n  fLum=(fLum-0.75)*4;\r\n  float3 fNewColor=LavaColor.xyz*0.5;\r\n  float3 fFinal=saturate(fLum*LavaColor.xyz + fNewColor);                                       \r\n  fFinal = saturate(fFinal*fFinal + fNewColor); \r\n  \r\n  float3 fColorOverlay=difColor*fFinal.xyz;  \t\t\r\n  fColorOverlay=lerp(fFinal, fColorOverlay*fColorOverlay*4, LavaColor.w);\r\n  fColorOverlay = HDREncode(fColorOverlay.xyz);\r\n  OUT.Color.xyz = HDRFogBlend(fColorOverlay.xyz, IN.Color.w, GlobalFogColor.xyz);\r\n  OUT.Color.w = 1.0;"
    }
  ],
