      "name": "MainInput",
      "content": "\r\n  uniform sampler2D baseMap : texunit0,\r\n  uniform FLOAT4 vSampleOffsets[8],\r\n  uniform FLOAT4 vSampleWeights[8]"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  FLOAT4 vSample = 0.0f;\r\n  FLOAT4 vColor = 0.0f;\r\n      \r\n  FLOAT2 vSamplePosition;\r\n  \r\n  // Sample from eight points along the star line\r\n  for(int i=0; i<8; i++)\r\n  {\r\n    vSamplePosition = IN.Tex0.xy + vSampleOffsets[i].xy;\r\n    vSample = tex2D(baseMap, vSamplePosition);\r\n    vColor += vSampleWeights[i] * vSample;\r\n  }\r\n    \r\n  OUT.Color = vColor;"
    }
  ],
