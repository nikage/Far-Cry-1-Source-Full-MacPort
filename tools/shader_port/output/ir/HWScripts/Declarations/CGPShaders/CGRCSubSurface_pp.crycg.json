      "name": "MainInput",
      "content": " uniform sampler2D decalMap : register(s0),\r\n            uniform sampler2D bumpMap : register(s1),\r\n            uniform samplerCUBE normCubeMap : register(s2)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2    \r\n    OUT_T3\r\n    OUT_C0    \r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // load colors  \r\n  float4 vSubSurfaceColor = tex2D(decalMap, IN.Tex0.xy);                  \r\n  float3 vBumpColor = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5); //normalize(IN.Tex3.xyz);    \r\n  float4 vNCMColor = 2*(texCUBE(normCubeMap, IN.Tex2.xyz)-0.5);    \r\n                            \r\n  OUT.Color.xyz = saturate(dot(vNCMColor.xyz, vBumpColor.xyz)*0.5+0.5)*IN.Color.xyz*vSubSurfaceColor;\r\n  OUT.Color.w= 1;"
    }
  ],
