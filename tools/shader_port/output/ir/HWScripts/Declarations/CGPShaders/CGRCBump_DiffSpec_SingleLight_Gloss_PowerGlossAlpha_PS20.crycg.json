{
  "name": "CGRCBump_DiffSpec_SingleLight_Gloss_PowerGlossAlpha_PS20",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCBump_DiffSpec_SingleLight_Gloss_PowerGlossAlpha_PS20.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D bumpMap : texunit1,\r\n                  uniform sampler2D glossMap : texunit2,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Specular,\r\n                  uniform float4 Ambient"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        half4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        // load the bump normal\r\n        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);\r\n        // load the gloss\r\n        half4 glossColor = tex2D(glossMap, IN.Tex2.xy);\r\n        \r\n        // normalize post-filtered bump normals\r\n        bumpNormal.xyz = normalize(bumpNormal.xyz);\r\n\r\n        // normalize light vector\r\n        float3 lightVec = normalize(IN.Tex3.xyz);\r\n        float fDif = saturate(dot(lightVec.xyz, bumpNormal.xyz));\r\n        \r\n        // normalize view vector\r\n        float3 viewVec = normalize(IN.Tex4.xyz);\r\n        float3 reflVec = (2*dot(lightVec.xyz, bumpNormal.xyz)*bumpNormal.xyz)-lightVec.xyz;\r\n        float NdotR = saturate(dot(reflVec.xyz, viewVec.xyz));\r\n        half fSpec = pow(NdotR, Specular.w*glossColor.w);\r\n        \r\n        half3 dif = (decalColor.xyz * fDif * Diffuse.xyz) * 2;\r\n        half3 spec = (fSpec * Specular.xyz * glossColor.xyz) * 2;\r\n        half3 amb = Ambient.xyz * decalColor.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb + dif + spec;\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
