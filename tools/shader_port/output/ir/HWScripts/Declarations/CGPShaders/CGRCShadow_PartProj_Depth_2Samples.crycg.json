{
  "name": "CGRCShadow_PartProj_Depth_2Samples",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCShadow_PartProj_Depth_2Samples.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadMap0 : register(s0),\r\n                  uniform sampler2D shadMap1 : register(s1),\r\n                  uniform sampler2D baseMap : register(s2),\r\n                  uniform samplerCUBE projMap : register(s3),\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        FLOAT4 decalColor = tex2D(baseMap, IN.Tex2.xy);\r\n        FLOAT4 projColor = texCUBE(projMap, IN.Tex3.xyz);\r\n\r\n        FLOAT3 dif = (decalColor.xyz * projColor.xyz * Diffuse.xyz * IN.Color.xyz) * 2;\r\n        FLOAT3 amb = decalColor.xyz * Ambient.xyz;\r\n        \r\n        // load the 2 shadow samples\r\n        FLOAT4 shadColor0 = tex2Dproj(shadMap0, IN.Tex0.xyzw);\r\n        FLOAT4 shadColor1 = tex2Dproj(shadMap1, IN.Tex1.xyzw);\r\n        FLOAT3 vShad = (float3)0;\r\n        vShad.x = 1-shadColor0.b;\r\n        vShad.y = 1-shadColor1.b;\r\n        vShad.xyz = vShad.xyz * Fading.xyz;\r\n        FLOAT fCompare = dot(vShad, float3(1.0, 1.0, 0.0));\r\n                \r\n        OUT.Color.xyz = amb + dif * (1-fCompare);\r\n        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;"
    }
  ],
