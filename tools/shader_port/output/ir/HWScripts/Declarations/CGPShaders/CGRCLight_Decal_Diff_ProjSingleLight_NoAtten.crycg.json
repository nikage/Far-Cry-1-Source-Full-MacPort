{
  "name": "CGRCLight_Decal_Diff_ProjSingleLight_NoAtten",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCLight_Decal_Diff_ProjSingleLight_NoAtten.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE projMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);\r\n\r\n        float3 dif = (decalColor.xyz * projColor.xyz * Diffuse.xyz * IN.Color.xyz) * 2;\r\n        float3 amb = decalColor.xyz * Ambient.xyz;\r\n\r\n        // finally add them all together\r\n        OUT.Color.xyz = amb + dif;\r\n        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;"
    }
  ],
