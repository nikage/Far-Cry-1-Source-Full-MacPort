{
  "name": "CGRCBump_Diff_ProjSingleLight_VertLight_Plants_Bump",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGPShaders/CGRCBump_Diff_ProjSingleLight_VertLight_Plants_Bump.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform samplerCUBE projMap : texunit1,\r\n                  uniform sampler2D bumpMap : texunit2,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Diffuse,\r\n                  uniform float4 DiffuseSun"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);\r\n        // load the bump normal\r\n        float4 bumpNormal = EXPAND(tex2D(bumpMap, IN.Tex2.xy));\r\n\r\n        float3 dif = IN.Color.a * projColor.xyz * Diffuse.xyz;\r\n\r\n        // light vector from static sun light\r\n        float3 lightVecSun = EXPAND(IN.Color1.xyz);\r\n        float fDifSun = saturate(dot(bumpNormal.xyz, lightVecSun));\r\n        float3 difSun = (fDifSun * DiffuseSun.xyz);\r\n        float3 amb = Ambient.xyz * (IN.Color.xyz + difSun.xyz);\r\n\r\n        // finally add them all together\r\n        float3 color = HDREncode((amb + dif) * decalColor.xyz);\r\n        OUT.Color.xyz = HDRFogBlend(color, IN.Color1.w, GlobalFogColor.xyz);\r\n        OUT.Color.w = decalColor.w * Ambient.w;"
    }
  ],
