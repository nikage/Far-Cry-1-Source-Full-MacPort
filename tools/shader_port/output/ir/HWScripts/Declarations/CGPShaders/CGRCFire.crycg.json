      "name": "MainInput",
      "content": " uniform sampler2D bumpMap : texunit0,\r\n            uniform sampler2D refMap : texunit1,                        \r\n            uniform float4 Matrix"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  struct vertout\r\n  {\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_C0\r\n  };\r\n\r\n  FOUT"
    },
    {
      "name": "CoreScript",
      "content": "  \r\n  // load the decal  \r\n  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);      \r\n\r\n# ifdef _PS_1_1\r\n  float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);          // get env bump map surface\r\n# else\r\n        float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;\r\n        float4 refrColor = tex2D(refMap, newst);\r\n# endif                \r\n    \r\n  //float3 fColorSquare=refrColor.xyz*refrColor.xyz; \r\n  //float fColorLum=dot(refrColor.xyz, float3(0.33, 0.59, 0.11)); \r\n\r\n  OUT.Color.xyz =refrColor.xyz*refrColor.w*IN.Color.w;\r\n  OUT.Color.w = 1;"
    }
  ],
