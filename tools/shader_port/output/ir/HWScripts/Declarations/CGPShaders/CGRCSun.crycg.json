      "name": "MainInput",
      "content": " uniform sampler2D baseMap : texunit0,\r\n                  uniform sampler2D modMap : texunit1"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 sunColor = tex2D(baseMap, IN.Tex0.xy);\r\n        float4 modColor = tex2D(modMap, IN.Tex1.xy);\r\n        float3 color = sunColor.xyz * modColor.a * IN.Color.xyz;\r\n# ifdef _HDR        \r\n        color.xyz = color.xyz * 2;\r\n# endif        \r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.w = sunColor.a * IN.Color.a;"
    }
  ],
