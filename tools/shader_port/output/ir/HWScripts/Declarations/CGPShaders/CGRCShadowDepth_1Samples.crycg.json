  "blocks": [
    {
      "name": "MainInput",
      "content": " uniform sampler2D shadowMap0 : texunit0,\r\n                  uniform sampler2D baseMap : texunit1,\r\n                  uniform float4 Ambient,\r\n                  uniform float4 Fading"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct vertout\r\n        {\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n        };\r\n\r\n        FOUT"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // load the decal\r\n        float4 shadowColor0 = tex2Dproj(shadowMap0, IN.Tex0.xyzw);\r\n        float4 decalColor = tex2D(baseMap, IN.Tex1.xy);\r\n        float3 color = decalColor.xyz * Ambient.xyz;\r\n        color = HDREncodeAmb(color);\r\n#ifdef D3D\r\n        float shadow = (IN.Tex2.z>0.5)?1-shadowColor0.b:0;\r\n#endif\r\n#ifdef OTHER        \r\n        float shadow = 1-shadowColor0.b;\r\n#endif\r\n        shadow *= Fading.x;\r\n        OUT.Color.xyz = color.xyz;\r\n        OUT.Color.a = shadow;"
    }
  ],
