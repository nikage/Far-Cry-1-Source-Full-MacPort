      "content": " VIEWPROJ_MATRIX, uniform float4x4 ObjMatrix, uniform float4 CaustTexGen0, uniform float4 CaustTexGen1, uniform float3 WaterLevel, CAMERA_POS"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float4 P = mul(ObjMatrix, vPos);\r\n        OUT.Tex0.x = dot(CaustTexGen0, P);\r\n        OUT.Tex0.y = dot(CaustTexGen1, P);\r\n\r\n        float fDistBlendFactor = vPos.w - length(P.xyz - CameraPos.xyz) * CameraPos.w;\r\n        OUT.Color.w = fDistBlendFactor * (float)((WaterLevel.x - P.z) >= vPos.w) * 0.75;\r\n        OUT.Color.xyz = vPos.www;"
    }
  ],
