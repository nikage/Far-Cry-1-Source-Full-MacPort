{
  "name": "CGVProgDecal_Atten",
  "extension": "crycg",
  "path": "HWScripts/Declarations/CGVShaders/CGVProgDecal_Atten.crycg",
  "includes": [
    "../CGVPMacro.csi"
  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 DecalAtten"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        TANG_MATR\r\n\r\n        float3 vVec = DecalAtten.xyz - vPos.xyz;\r\n        float3 vtVec = mul(objToTangentSpace, vVec);          \r\n        \r\n        float fDot = (dot(normalize(vVec), IN.TNormal.xyz) + 0.15)*6.6666;\r\n        \r\n        float fiRad = 1/DecalAtten.w;\r\n        float3 vDist = vtVec * (fiRad * 0.5) + 0.5;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex0.xyz = vDist;\r\n        OUT.Color.xyz = max(min(fDot, 1), 0);\r\n        OUT.Color.w = vDist.z;"
    }
  ],
