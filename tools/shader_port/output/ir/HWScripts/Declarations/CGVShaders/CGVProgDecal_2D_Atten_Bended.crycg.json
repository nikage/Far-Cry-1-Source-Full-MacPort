  "blocks": [
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 DecalAtten, BEND"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.x = dot(BaseTexGen0, IN.Position);\r\n        OUT.Tex0.y = dot(BaseTexGen1, IN.Position);\r\n\r\n        float3 binorm = BaseTexGen0;\r\n        float3 tang = BaseTexGen1;\r\n        float3 norm = cross(binorm, tang);\r\n        binorm = cross(norm, tang);\r\n\r\n        float3x3 objToTangentSpace;\r\n        objToTangentSpace[0] = normalize(tang);\r\n        objToTangentSpace[1] = normalize(binorm);\r\n        objToTangentSpace[2] = normalize(norm);\r\n        \r\n        float3 vVec = DecalAtten.xyz - IN.Position.xyz;\r\n        float3 vtVec = mul(objToTangentSpace, vVec);          \r\n        float3 vDist = vtVec * ((1/DecalAtten.w) * 0.5) + 0.5;\r\n        OUT.Tex1.xyz = vDist;\r\n        OUT.Color.xyz = vDist;"
    }
  ],
