      "content": " uniform float4x4 ModelViewProj, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix, uniform float4 CaustTexGen0, uniform float4 CaustTexGen1, uniform float3 WaterLevel, uniform float4 CameraPos"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy  = mul(FogEnterMatrix, vPos);\r\n        OUT.Tex1.xy  = mul(FogMatrix, vPos);\r\n        OUT.Tex2.x = dot(CaustTexGen0, vPos);\r\n        OUT.Tex2.y = dot(CaustTexGen1, vPos);\r\n\r\n        float fDistBlendFactor = vPos.w - length(vPos.xyz - CameraPos.xyz) * CameraPos.w;\r\n        OUT.Color.w = fDistBlendFactor * (float)((WaterLevel.x - vPos.z) >= vPos.w);\r\n        OUT.Color.xyz = IN.Color.xyz;"
    }
  ],
