  "blocks": [
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float3 CameraPos, uniform float4 Constants, uniform float3 Source0, uniform float4 Dist"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_C0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "PositionScript",
      "content": "\r\n        float4 vNormal = normalize(IN.Normal);\r\n        float4 vPos;\r\n        float fFactor = length(IN.Position.xyz - Source0.xyz) * Dist.x;\r\n        fFactor = (1 / fFactor) / 8;\r\n        //fFactor = 1.5 - clamp(fFactor, 0, 1.5);\r\n        vPos.xyz = IN.Position.xyz + vNormal.xyz * Constants.x * clamp(fFactor, 0, 2);\r\n        vPos.w = IN.Position.w;\r\n        OUT.HPosition = mul(ModelViewProj, vPos);"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float3 camVec = normalize(CameraPos.xyz - vPos.xyz);\r\n        float4 color = IN.Color;\r\n        float fDot = dot(camVec, vNormal.xyz) * fFactor;\r\n        color.w = fDot * Constants.y;\r\n        color.x = color.x * (fFactor * Constants.z);\r\n        OUT.Color = color;\r\n        OUT.Tex0.x = length(vPos.xyz - Source0.xyz) * Dist.x;\r\n        OUT.Tex0.y = 1.0f;"
    }
  ],
