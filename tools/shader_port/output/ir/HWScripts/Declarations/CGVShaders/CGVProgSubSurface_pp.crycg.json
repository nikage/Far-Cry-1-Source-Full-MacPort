      "name": "VertAttributes",
      "content": "\r\n  POSITION_3\r\n  TEXCOORD0_2\r\n  TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": "\r\n  VIEWPROJ_MATRIX,\r\n  LIGHT_POS,\r\n  CAMERA_POS,\r\n  ATTEN"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_TANG\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0\r\n    OUT_T1\r\n    OUT_T2\r\n    OUT_T3\r\n    OUT_C0    \r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  TANG_MATR\r\n  \r\n  // output texture coordinates\r\n  OUT.Tex0.xy = IN.TexCoord0.xy;\r\n  OUT.Tex1.xy = IN.TexCoord0.xy;\r\n  \r\n  // store normalized light vector\r\n  float3 lVec = LightPos.xyz - vPos.xyz;\r\n  float3 lightVec = mul(objToTangentSpace, lVec.xyz);\r\n\r\n  OUT.Tex2.xyz = lightVec;\r\n  \r\n  float fiSqDist = rsqrt(dot(lVec, lVec));\r\n  float fAtten = PROC_ATTENVERT;                        \r\n  // output attenuation\r\n  OUT.Color.xyz=fAtten;\r\n  OUT.Tex3.xyz=mul(objToTangentSpace,IN.TNormal.xyz);\r\n  \r\n  return OUT;"
    }
  ],
