    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 NORMAL_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4x4 ObjMatrix, CAMERA_POS, uniform float4 Eta"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0 = IN.TexCoord0;\r\n        \r\n        // transform normal\r\n        float3 normal;;\r\n        normal.x = dot(IN.Normal.xyz, ObjMatrix._11_12_13);\r\n        normal.y = dot(IN.Normal.xyz, ObjMatrix._21_22_23);\r\n        normal.z = dot(IN.Normal.xyz, ObjMatrix._31_32_33);\r\n       \r\n        // calculate incident vector\r\n        float3 incidentVec = normalize(vPos.xyz - CameraPos.xyz);\r\n\r\n        // refraction function from Renderman spec\r\n        // I = incident direction, N = normal, eta = relative index of refraction\r\n        float IdotN = dot(incidentVec, normal);\r\n        float k = 1 - Eta.x*Eta.x*(1 - IdotN*IdotN);\r\n        float3 result = Eta.x*incidentVec - (Eta.x*IdotN + sqrt(k))*normal;\r\n        OUT.Tex1.xyz = result.xyz;\r\n        OUT.Tex1.w = vPos.w;\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
