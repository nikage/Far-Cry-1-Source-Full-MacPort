      "name": "VertAttributes",
      "content": "\r\n    POSITION_3\r\n    TEXCOORD0_2\r\n    TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": "\r\n    VIEWPROJ_MATRIX,\r\n    LIGHT_POS,\r\n    CAMERA_POS"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n    IN_T0_TANG\r\n    OUT_T0_T1_C0"
    },
    {
      "name": "CoreScript",
      "content": "\r\n\r\n    OUT.Tex0.xy = IN.TexCoord0.xy;\r\n    OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n    // get 3x3 tangent space tranformation matrix\r\n    float3x3 MatrixTS;\r\n    MatrixTS[0] = IN.Tangent;\r\n    MatrixTS[1] = IN.Binormal;\r\n    MatrixTS[2] = IN.TNormal;\r\n\r\n    //  compute light vector\r\n    float3 vLightOS = normalize(LightPos.xyz - IN.Position.xyz);\r\n\r\n    // xform to tangent space\r\n    vLightOS= mul(MatrixTS, vLightOS);\r\n    OUT.Color.xyz=normalize(vLightOS);\r\n\r\n    return OUT;"
    }
  ],
