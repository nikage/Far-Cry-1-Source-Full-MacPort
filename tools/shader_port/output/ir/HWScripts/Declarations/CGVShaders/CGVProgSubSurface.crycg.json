    {
      "name": "VertAttributes",
      "content": "\r\n  POSITION_3\r\n  TEXCOORD0_2\r\n  TNORMAL_3"
    },
    {
      "name": "MainInput",
      "content": "\r\n  VIEWPROJ_MATRIX,\r\n  LIGHT_POS,\r\n  CAMERA_POS,\r\n  ATTEN"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n  // vertex input\r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_TN\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_C0\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  // output texture coordinates\r\n  OUT.Tex0.xy = IN.TexCoord0.xy;\r\n\r\n  // compute light vector\r\n  float3 LightVec=LightPos.xyz-IN.Position.xyz;\r\n  // compute view vector\r\n  float3 ViewVec=CameraPos.xyz-IN.Position.xyz;\r\n\r\n  // compute vectors\r\n  float3 OSLightVec=normalize(LightVec);\r\n  float3 OSViewVec=normalize(ViewVec);\r\n\r\n  // compute fake sub-surface scatering term\r\n  float3 SubSurfaceScatTerm=dot(OSLightVec.xyz, IN.TNormal.xyz); \r\n  float3 SubSurfaceScatFinal=max(0, ((SubSurfaceScatTerm+1)*0.5));\r\n\r\n  // compute fresnel term  (NOTE: fresnel coeficient (fresnelK) should be tweakable)\r\n // float FresnelK=0.4;\r\n//  float3 Reflection=-OSViewVec+2*IN.TNormal.xyz*(max(dot( OSViewVec.xyz, IN.TNormal.xyz), 0));\r\n//  float3 Fresnel=max(pow(1-max(dot(Reflection.xyz, IN.TNormal.xyz), 0), 5), 0);\r\n  \r\n  float fiSqDist = rsqrt(dot(LightVec, LightVec));\r\n  float fAtten = PROC_ATTENVERT;\r\n                        \r\n  // output final color..\r\n  OUT.Color.xyz=SubSurfaceScatFinal*fAtten; //*2*float3(1, 0.25, 0.2);\r\n\r\n  return OUT;"
    }
  ],
