  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 PRIM_COLOR TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float3x3 ObjToCubeSpace, uniform float3 LightPos, uniform float3 CameraPos, uniform float3 Up, uniform float BumpScale"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // pass texture coordinates for fetching the normal map\r\n        OUT.Tex0 = IN.TexCoord0;\r\n\r\n        // compute the 3x3 tranform from tangent space to object space\r\n        float3x3 objToTangentSpace;\r\n        // first rows are the tangent and binormal scaled by the bump scale\r\n        objToTangentSpace[0] = BumpScale * IN.Tangent;\r\n        objToTangentSpace[1] = BumpScale * IN.Binormal;\r\n        objToTangentSpace[2] = IN.TNormal;\r\n        \r\n        float3x3 lightSpace;\r\n        lightSpace[2] = normalize(LightPos.xyz - vPos.xyz);\r\n        OUT.Color.xyz = dot(lightSpace[2], IN.TNormal);\r\n        lightSpace[1] = normalize(cross(lightSpace[2], Up));\r\n        lightSpace[0] = cross(lightSpace[1], lightSpace[2]);\r\n        \r\n        float3x3 vTemp;\r\n        vTemp[0] = mul(ObjToCubeSpace, lightSpace[0].xyz);\r\n        vTemp[1] = mul(ObjToCubeSpace, lightSpace[1].xyz);\r\n        vTemp[2] = mul(ObjToCubeSpace, lightSpace[2].xyz);\r\n\r\n        OUT.Tex1.xyz = mul(objToTangentSpace, vTemp[0].xyz);\r\n        OUT.Tex2.xyz = mul(objToTangentSpace, vTemp[1].xyz);\r\n        OUT.Tex3.xyz = mul(objToTangentSpace, vTemp[2].xyz);\r\n\r\n        // compute the eye vector (going from shaded point to eye) in cube space\r\n        //OUT.Tex1.w = -dot(lightSpace[0], vPos.xyz);\r\n        //OUT.Tex2.w = -dot(lightSpace[1], vPos.xyz);\r\n        //OUT.Tex3.w = -dot(lightSpace[2], vPos.xyz);\r\n        // compute the eye vector (going from shaded point to eye) in cube space\r\n        float3 eyeVector = CameraPos - mul(ObjToCubeSpace, vPos.xyz);\r\n        OUT.Tex1.w = eyeVector.x;\r\n        OUT.Tex2.w = eyeVector.y;\r\n        OUT.Tex3.w = eyeVector.z;\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
