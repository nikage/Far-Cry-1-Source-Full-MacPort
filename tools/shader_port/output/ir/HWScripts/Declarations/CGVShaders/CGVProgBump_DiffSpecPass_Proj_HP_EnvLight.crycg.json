  ],
  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, LIGHT_MATRIX, ATTEN, uniform float4x4 TexMatrix, uniform float4 EnvColors[6]"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n        TANG_MATR\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        float fiSqDist = rsqrt(dot(lightVec, lightVec));\r\n        float4 vLPos;\r\n        \r\n        vLPos.a = PROC_ATTENVERT;\r\n        lightVec = lightVec*fiSqDist;\r\n        lightVec = mul(objToTangentSpace, lightVec);\r\n\r\n        // transform light vector from object space to tangent space and pass it as a color\r\n        vLPos.xyz = 0.5 * lightVec + 0.5.xxx;\r\n        OUT.Color = vLPos;\r\n\r\n        // compute view vector\r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n        float3 viewVec = mul(objToTangentSpace, vVec);\r\n        // compute half angle vector\r\n        float3 halfAngleVector = normalize(viewVec) + lightVec;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex3.xyz = halfAngleVector;\r\n\r\n        OUT.Tex2 = mul(LightMatrix, vPos);\r\n\r\n        // Calculate average radiosity color from 6 colors (Cube)\r\n        float3 tNormal;\r\n        tNormal = mul((float3x3)TexMatrix, IN.TNormal.xyz);\r\n        float3 Compare1 = step(tNormal, 0);\r\n        float3 Compare0 = 1 - Compare1;\r\n        float3 signN = sign(tNormal);\r\n        tNormal = tNormal * tNormal;\r\n        tNormal = tNormal * signN;\r\n        float4 ColorX = EnvColors[0]*tNormal.x*Compare0.x + EnvColors[1]*(-tNormal.x)*Compare1.x;\r\n        float4 ColorY = EnvColors[2]*tNormal.y*Compare0.y + EnvColors[3]*(-tNormal.y)*Compare1.y;\r\n        float4 ColorZ = EnvColors[4]*tNormal.z*Compare0.z + EnvColors[5]*(-tNormal.z)*Compare1.z;\r\n        OUT.Color1 = (ColorX + ColorY + ColorZ) * 2.0;"
    }
  ],
