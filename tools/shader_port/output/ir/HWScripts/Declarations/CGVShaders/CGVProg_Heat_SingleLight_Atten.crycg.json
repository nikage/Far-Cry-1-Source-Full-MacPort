    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float3 LightPos, ATTEN"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_C0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n        TANG_MATR\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = mul(objToTangentSpace, LightPos.xyz - vPos.xyz);\r\n        \r\n        float3 vDist = PROC_ATTENPIX;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex2.xyz = vDist;\r\n        OUT.Color.xyz = IN.Color.xyz * 0.1;\r\n        OUT.Color.w = vDist.z;\r\n        \r\n        float fDirect = (AttenInfo.z - AttenInfo.y) * AttenInfo.w;\r\n        lightVec = lightVec * fDirect.x;\r\n        OUT.Color1.xyz = AttenInfo.y * normalize(lightVec) + AttenInfo.y;"
    }
  ],
