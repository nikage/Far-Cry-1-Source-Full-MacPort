  "blocks": [
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 Layer0TexGen0, uniform float4 Layer0TexGen1, uniform float4 Layer1TexGen0, uniform float4 Layer1TexGen1, uniform float4 Layer2TexGen0, uniform float4 Layer2TexGen1, uniform float4 Layer3TexGen0, uniform float4 Layer3TexGen1, CAMERA_POS, uniform float4 FadingDist"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C1\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2_2\r\n          OUT_T3_2\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.x = dot(Layer0TexGen0, vPos);          \r\n        OUT.Tex0.y = dot(Layer0TexGen1, vPos);          \r\n        OUT.Tex1.x = dot(Layer1TexGen0, vPos);          \r\n        OUT.Tex1.y = dot(Layer1TexGen1, vPos);          \r\n        OUT.Tex2.x = dot(Layer2TexGen0, vPos);          \r\n        OUT.Tex2.y = dot(Layer2TexGen1, vPos);          \r\n        OUT.Tex3.x = dot(Layer3TexGen0, vPos);          \r\n        OUT.Tex3.y = dot(Layer3TexGen1, vPos);          \r\n        \r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n        float fDist = length(viewVec.xyz);\r\n        float fFade = max(0.001, FadingDist.x);\r\n        fDist = fDist / fFade;\r\n        fDist = min(fDist, 1);\r\n        fDist = fDist * fDist;\r\n        fDist = fDist * fDist;\r\n        \r\n        OUT.Color.a = IN.Color1.a * fDist;\r\n        OUT.Color.b = IN.Color1.r * fDist;\r\n        OUT.Color1.b = IN.Color1.g * fDist;\r\n        OUT.Color1.g = IN.Color1.b * fDist;"
    }
  ],
