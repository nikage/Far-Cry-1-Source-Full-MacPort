  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS, uniform float3 Tangent, uniform float3 ScaleBumpTex, uniform float2x4 TexGen"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float2 vTex = mul(TexGen, vPos);\r\n        OUT.Tex0.xy = vTex * ScaleBumpTex.xy;\r\n        OUT.Tex1.xy = vTex;\r\n        \r\n        float3 Binormal = cross(Tangent, IN.Normal.xyz);\r\n\r\n        // compute the 3x3 tranform from tangent space to object space\r\n        float3x3 objToTangentSpace;\r\n        objToTangentSpace[0] = Tangent;\r\n        objToTangentSpace[1] = Binormal;\r\n        objToTangentSpace[2] = IN.Normal.xyz;\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex2.xyz = mul(objToTangentSpace, lightVec.xyz);"
    }
  ],
