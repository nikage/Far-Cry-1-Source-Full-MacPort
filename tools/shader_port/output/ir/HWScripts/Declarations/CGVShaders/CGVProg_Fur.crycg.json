    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0 = IN.TexCoord0;\r\n\r\n        // Simple light calculations (L dot N)\r\n        // Diffuse color\r\n        float3 cDiffuse = float3(1, 1, 1);\r\n        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);\r\n        float fDiffuse = dot(vLightDir, IN.Normal.xyz);\r\n        OUT.Color.xyz = cDiffuse * fDiffuse;\r\n\r\n        // Here we set the diffuse alpha component\r\n        OUT.Color.w = Modifiers.y;"
    }
  ],
