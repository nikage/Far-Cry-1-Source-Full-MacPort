  "blocks": [
    {
      "name": "VertAttributes",
      "content": " POSITION_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": "\r\n        VIEWPROJ_MATRIX,\r\n        uniform float4 NoisePos,\r\n        CAMERA_POS,\r\n        LIGHT_POS,\r\n        uniform float4 TexShiftRipple,\r\n        uniform float4 TexGenRipple0,\r\n        uniform float4 TexGenRipple1,\r\n        uniform float3 Normal,\r\n        uniform float3 Tangent,\r\n        uniform float4 WaterLevel,\r\n        uniform float4 pg[66] : register(c30)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_C0\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float2 vTex;\r\n        vTex.x = dot(vPos, TexGenRipple0);\r\n        vTex.y = dot(vPos, TexGenRipple1);\r\n        OUT.Tex0.xy = vTex.xy + TexShiftRipple.xy;\r\n        float3 Binormal = cross(Tangent, Normal);\r\n\r\n        // compute the 3x3 tranform from tangent space to object space\r\n        float3x3 objToTangentSpace;\r\n        objToTangentSpace[0] = Tangent;\r\n        objToTangentSpace[1] = Binormal;\r\n        objToTangentSpace[2] = Normal;\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex1.xyz = mul(objToTangentSpace, lightVec.xyz) * LightPos.w;\r\n\r\n        // compute view vector\r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n\r\n        // transform half angle vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex2.xyz = mul(objToTangentSpace, viewVec) * CameraPos.w;\r\n        float fFade = 1-saturate(abs(CameraPos.z - vPos.z) / 12);\r\n\r\n        OUT.Color.xyz = IN.Color.xyz;\r\n        OUT.Color.w = (IN.Color.w+0.25) * fFade;"
    }
  ],
