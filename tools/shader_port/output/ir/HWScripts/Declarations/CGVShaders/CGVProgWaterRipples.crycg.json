    {
      "name": "MainInput",
      "content": "\r\n  // common model view matrix\r\n  VIEWPROJ_MATRIX,\r\n  uniform float4   CameraPos,  \r\n  uniform float4   ScreenSize"
    },
    {
      "name": "DeclarationsScript",
      "content": " \r\n  struct appin\r\n  {\r\n    IN_P\r\n    IN_T0\r\n    IN_C0\r\n  };\r\n  struct vertout\r\n  {\r\n    OUT_P\r\n    OUT_T0_2\r\n    OUT_T1_2\r\n    OUT_T2\r\n    OUT_C0\r\n  };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n  float4 vHPos = mul(ModelViewProj, vPos);                                    \r\n\r\n  // output texture coordinates       \r\n#ifdef OPENGL  \r\n\tOUT.Tex2.xy = (vHPos.xy/vHPos.w  + 1)*0.5*ScreenSize.xy;    \t    \r\n#endif\r\n\r\n#ifdef D3D \r\n\t#ifdef PROJECTEDENVBUMP\r\n\t\tOUT.Tex2.xz = (vHPos.xz  + vHPos.w)*0.5;    \r\n\t\tOUT.Tex2.y =  (-vHPos.y  + vHPos.w)*0.5;      \r\n\t\tOUT.Tex2.w   = vHPos.w;  \t\r\n\t#endif\r\n\t#ifdef OTHER\r\n\t\tOUT.Tex2.x = (vHPos.x / vHPos.w + 1)*0.5;  \r\n\t\tOUT.Tex2.y = (-vHPos.y / vHPos.w + 1)*0.5;\r\n    OUT.Tex2.zw = vPos.ww;\r\n\t#endif\r\n#endif\r\n    \r\n  OUT.Tex0.xy =IN.TexCoord0.xy;\r\n  OUT.Tex1.xy =IN.TexCoord0.xy;  \r\n  OUT.Color.w = IN.Color.w;  \r\n  \r\n  return OUT;"
    }
  ],
