  "blocks": [
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, uniform float4 Color"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_N\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // 1. Calculate L dot N and pass result to ToonLookup texture\r\n        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);\r\n        float LdotN = dot(vLightDir.xyz, IN.Normal.xyz);\r\n        OUT.Tex0.x = LdotN;\r\n\r\n        // 2. Calculate E dot N and pass result to EdgeLookup texture\r\n        float3 vEyeDir = normalize(CameraPos.xyz - vPos.xyz);\r\n        float EdotN = dot(vEyeDir.xyz, IN.Normal.xyz);          \r\n        OUT.Tex1.x = EdotN;\r\n        \r\n        // Use custom color\r\n        OUT.Color = Color;"
    }
  ],
