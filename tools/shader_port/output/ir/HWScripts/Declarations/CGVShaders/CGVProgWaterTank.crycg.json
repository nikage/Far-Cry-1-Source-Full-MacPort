  "blocks": [
    {
      "name": "VertAttributes",
      "content": " \r\n    POSITION_3 \r\n    TEXCOORD0_2\r\n    TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " \r\n    VIEWPROJ_MATRIX, \r\n    LIGHT_POS,\r\n    CAMERA_POS,\r\n    ATTEN,\r\n    uniform float4 Constants"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n    struct appin\r\n    {\r\n      IN_P\r\n      IN_T0\r\n      IN_TANG\r\n    };\r\n    \r\n    struct vertout\r\n    {\r\n      OUT_P\r\n      OUT_T0\r\n      OUT_T1\r\n      OUT_T2_2\r\n      OUT_T3\r\n      OUT_T4      \r\n      OUT_C0\r\n    };"
    },
    {
      "name": "CoreScript",
      "content": "  \r\n    float4 vHPos = mul(ModelViewProj, vPos);\r\n    if(vHPos.w<0.5) vHPos.w=0.5;\r\n\r\n    float2 vTranslation=Constants.yy%1;\r\n    OUT.Tex0.xy =IN.TexCoord0.xy*0.005+vTranslation.xy;\r\n    OUT.Tex0.zw=IN.TexCoord0.xy*0.005-vTranslation.yy;\r\n    \r\n    // optimized perspective correct projection\r\n    OUT.Tex1.xz = (vHPos.xz  + vHPos.w)*0.5;\r\n    OUT.Tex1.y =  (-vHPos.y  + vHPos.w)*0.5;\r\n    OUT.Tex1.w   = vHPos.w;  \r\n\r\n    float3 ViewVec=CameraPos.xyz-IN.Position.xyz;\r\n    float3 LightVec=LightPos.xyz-IN.Position.xyz;\r\n    \r\n    float3 OSViewVec=normalize(ViewVec);\r\n    float3 OSLightVec=normalize(LightVec);\r\n    float fReflDot= dot(OSViewVec, IN.TNormal.xyz);  \r\n    float3 reflVector =(2*IN.TNormal.xyz*fReflDot-OSViewVec.xyz);  \r\n    OUT.Tex2.xy = (reflVector.xz+1.0)*0.5;\r\n\r\n    TANG_MATR\r\n    OUT.Tex3.xyz = mul(objToTangentSpace, ViewVec.xyz);\r\n\r\n    OUT.Tex4.xyz = mul(objToTangentSpace,IN.TNormal.xyz);\r\n    OUT.Color.w=1; \r\n\r\n    return OUT;"
    }
  ],
