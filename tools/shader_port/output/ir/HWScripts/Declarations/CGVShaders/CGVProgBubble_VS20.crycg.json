    {
      "name": "VertAttributes",
      "content": " POSITION_3 TEXCOORD0_2 TANG_3X3"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 NoisePos, CAMERA_POS, uniform float4x4 ObjMatrix, uniform float4 pg[66] : register(c30)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_T2\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;  // diffuse\r\n\r\n        TANG_MATR\r\n        \r\n        float4 vNoise = fNoise * float4(0.5, 0.5, 0.25, 0.25);\r\n        float fX = dot(-vNoise, float4(0.0, 2.0, 0.0, 4.0));\r\n        float fY = dot(-vNoise, float4(2.0, 0.0, 4.0, 0.0));\r\n        float3 normal = IN.TNormal.xyz + (IN.Binormal.xyz*fX + IN.Tangent.xyz*fY)*0.04;\r\n\r\n        normal.x = dot(IN.TNormal.xyz, ObjMatrix._11_12_13);\r\n        normal.y = dot(IN.TNormal.xyz, ObjMatrix._21_22_23);\r\n        normal.z = dot(IN.TNormal.xyz, ObjMatrix._31_32_33);\r\n        normal = normalize(normal);\r\n\r\n        // calculate incident vector\r\n        float3 incidentVec = normalize(vPos.xyz - CameraPos.xyz);\r\n        OUT.Tex1.xyz = reflect(incidentVec, normal);\r\n        OUT.Tex1.w = vPos.w;\r\n\r\n        float VdotN = dot(incidentVec, IN.TNormal.xyz);\r\n        OUT.Tex2.xyz = VdotN;"
    }
  ],
