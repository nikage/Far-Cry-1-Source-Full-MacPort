      "name": "VertAttributes",
      "content": " POSITION_3 PRIM_COLOR"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 NoisePos, CAMERA_POS, uniform float4 TexShiftRipple, uniform float4 TexGenRipple0, uniform float4 TexGenRipple1, uniform float4 TexDetailScale, uniform float4 WaterLevel, uniform float4x4 TexProjMatrix, uniform float4 pg[66] : register(c30)"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_C0\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3_2\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        float2 vTex;\r\n        vTex.x = dot(vPos, TexGenRipple0);\r\n        vTex.y = dot(vPos, TexGenRipple1);\r\n        OUT.Tex0.xy = vTex.xy + TexShiftRipple.xy;\r\n        OUT.Tex3.xy = (vTex.xy + TexShiftRipple.xy) * TexDetailScale.xy;\r\n        \r\n        float4 vProjTex = mul(TexProjMatrix, vPos);\r\n        //vProjTex.xy = vProjTex.xy + fNoise * CameraPos.w;\r\n  #ifdef PROJECTEDENVBUMP\r\n        OUT.Tex1 = vProjTex;\r\n  #endif        \r\n  #ifdef OTHER\r\n        OUT.Tex1.xy = vProjTex.xy / vProjTex.w;\r\n        OUT.Tex1.zw = vPos.ww;\r\n  #endif        \r\n        \r\n        float3 eyeVec = normalize(CameraPos.xyz - vPos.xyz);\r\n        float fFresnel = abs(eyeVec.z);\r\n        OUT.Tex2.xy = fFresnel;\r\n\r\n        OUT.Color = IN.Color;\r\n\r\n# ifdef _HDR\r\n        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);\r\n        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);\r\n# endif"
    }
  ],
