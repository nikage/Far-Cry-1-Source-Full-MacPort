      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_T5\r\n          OUT_C0\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;  // diffuse and bump\r\n        OUT.Tex1.xy = IN.TexCoord0.xy * CameraPos.w;\r\n\r\n        TANG_MATR\r\n       \r\n        float3 vVec = CameraPos.xyz - vPos.xyz;\r\n        float3 tangviewVec = mul(objToTangentSpace, vVec.xyz);\r\n        OUT.Color.xyz = normalize(tangviewVec.xyz);\r\n        OUT.Tex5.xyz = tangviewVec.xyz;\r\n\r\n        float3 worldTangentS = mul((const float3x3)ObjMatrix, objToTangentSpace[0]);\r\n        float3 worldTangentT = mul((const float3x3)ObjMatrix, objToTangentSpace[1]);\r\n        float3 worldNormal   = mul((const float3x3)ObjMatrix, objToTangentSpace[2]);\r\n\r\n\t      OUT.Tex2.xyz = worldTangentS;\r\n\t      OUT.Tex3.xyz = worldTangentT;\r\n\t      OUT.Tex4.xyz = worldNormal;"
    }
  ],
