      "content": " uniform float4x4 ModelViewProj, uniform float4 EyePos, uniform float4x4 ModelMatrix"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0\r\n          OUT_T1\r\n          OUT_T2\r\n          OUT_T3\r\n          OUT_T4\r\n          OUT_T5\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n\r\n        TANG_MATR\r\n\r\n      \tfloat4 worldPos = mul(ModelMatrix, vPos);\r\n\r\n        // compute view vector\r\n        OUT.Tex2.xyz = EyePos.xyz - worldPos.xyz;\r\n\r\n        float3 worldTangentS = mul(objToTangentSpace[0], (const float3x3)ModelMatrix);\r\n        float3 worldTangentT = mul(objToTangentSpace[1], (const float3x3)ModelMatrix);\r\n        float3 worldNormal = mul(objToTangentSpace[2], (float3x3)ModelMatrix);\r\n\r\n\t      OUT.Tex3.xyz = worldTangentS;\r\n\t      OUT.Tex4.xyz = worldTangentT;\r\n\t      OUT.Tex5.xyz = worldNormal;\r\n\r\n        // store light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        // transform light vector from object space to tangent space and pass it as a tex coords\r\n        OUT.Tex2.xyz = mul(objToTangentSpace, lightVec.xyz);"
    }
  ],
