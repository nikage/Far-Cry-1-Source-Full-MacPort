      "name": "VertAttributes",
      "content": " POSITION_3 TANG_3X3 TEXCOORD0_2"
    },
    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float4 Modifiers, uniform float4 FurParams, LIGHT_POS, CAMERA_POS, uniform float4 ScaleBiasTC"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          float4 Position  : POSITION;\r\n          IN_TANGVECS\r\n          float4 TexCoord0 : TEXCOORD0;\r\n        };\r\n        \r\n        // define outputs from vertex shader\r\n        struct vertout\r\n        {\r\n          float4 HPosition  : POSITION;\r\n          float2 Tex0       : TEXCOORDN;\r\n          float4 Tex1       : TEXCOORDN;\r\n          float4 Tex2       : TEXCOORDN;\r\n          float2 Tex3       : TEXCOORDN;\r\n          float2 Tex4       : TEXCOORDN;\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        // FurParams.x = FurScaleX\r\n        // FurParams.y = FurScaleY\r\n        \r\n        // Modifiers.x = FurLength\r\n        // Modifiers.w = FurOffsetScale\r\n        OUT.Tex0.xy = (IN.TexCoord0.xy+ScaleBiasTC.zw)*ScaleBiasTC.xy;\r\n        OUT.Tex3.xy = IN.TexCoord0.xy * FurParams.xy;\r\n\r\n        TANG_MATR\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = normalize(LightPos.xyz - vPos.xyz);\r\n        OUT.Tex1.xyz  = mul(objToTangentSpace, lightVec);\r\n\r\n        // compute view vector\r\n        float3 viewVec = CameraPos.xyz - vPos.xyz;\r\n\r\n        // compute half angle vector\r\n        float3 halfAngleVector = lightVec.xyz + normalize(viewVec);\r\n        OUT.Tex2.xyz = normalize(mul(objToTangentSpace, halfAngleVector));\r\n        \r\n        float2 vRadius = float2(1, 1); //IN.TexCoord0.xy;\r\n        float2 vScale = float2(0.5, 0.5); //IN.TexCoord0.xy;\r\n        vRadius.xy = vRadius.xy / (vRadius.xy + Modifiers.xx);\r\n        OUT.Tex4.xy = vRadius.xy * vScale.xy * Modifiers.ww;"
    }
  ],
