    {
      "name": "MainInput",
      "content": " VIEWPROJ_MATRIX, uniform float3 LightPos, LIGHT_MATRIX, ATTEN"
    },
    {
      "name": "DeclarationsScript",
      "content": "\r\n        struct appin\r\n        {\r\n          IN_P\r\n          IN_T0\r\n          IN_C0\r\n          IN_TANG\r\n        };\r\n        struct vertout\r\n        {\r\n          OUT_P\r\n          OUT_T0_2\r\n          OUT_T1_2\r\n          OUT_T2\r\n          OUT_C0\r\n          OUT_C1\r\n        };"
    },
    {
      "name": "CoreScript",
      "content": "\r\n        OUT.Tex0.xy = IN.TexCoord0.xy;\r\n        OUT.Tex1.xy = IN.TexCoord0.xy;\r\n        OUT.Tex2 = mul(LightMatrix, vPos);\r\n\r\n        TANG_MATR\r\n\r\n        // store normalized light vector\r\n        float3 lightVec = LightPos.xyz - vPos.xyz;\r\n        float fiSqDist = rsqrt(dot(lightVec, lightVec));\r\n        lightVec = lightVec * fiSqDist;\r\n        \r\n        OUT.Color.a = PROC_ATTENVERT;\r\n        OUT.Color1.xyz = 0.5 * mul(objToTangentSpace, lightVec.xyz) + 0.5.xxx;\r\n        OUT.Color.xyz = IN.Color.xyz * 0.1;"
    }
  ],
