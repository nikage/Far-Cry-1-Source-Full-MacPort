	cd /Users/mykola/projects/FarCry/build_game && $(MAKE) $(MAKESILENT) -f CryAnimation/CMakeFiles/CryAnimation.dir/build.make CryAnimation/CMakeFiles/CryAnimation.dir/splitpath.cpp.s
.PHONY : splitpath.cpp.s

stdafx.o: stdafx.cpp.o
.PHONY : stdafx.o

# target to build an object file
