	cd /Users/mykola/projects/FarCry/build_game && $(MAKE) $(MAKESILENT) -f CryAnimation/CMakeFiles/CryAnimation.dir/build.make CryAnimation/CMakeFiles/CryAnimation.dir/stdafx.cpp.o
.PHONY : stdafx.cpp.o

stdafx.i: stdafx.cpp.i
