      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 TEXCOORD1_2 TNORMAL_3 }
      
      VS20Only
      
      MainInput { VIEWPROJ_MATRIX, CAMERA_POS, uniform float4x4 TexMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_T1
          IN_TN
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_T3_2
          OUT_T4
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;
        OUT.Tex2.xy = IN.TexCoord1.xy;
        OUT.Tex3.xy = IN.TexCoord1.xy;

        float3 vVec = CameraPos.xyz - vPos.xyz;
        float3 tCamVec = normalize(vVec);
        float3 tNormal = IN.TNormal.xyz;
        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;
        float4 tRM;
        tRM.xyz = tRef.xyz;
        tRM.w = vPos.w;
        OUT.Tex4 = mul(tRM, TexMatrix);
      }
    