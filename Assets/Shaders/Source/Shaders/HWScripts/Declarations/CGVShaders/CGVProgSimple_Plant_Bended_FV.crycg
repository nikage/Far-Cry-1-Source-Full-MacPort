      #include "../CGVPMacro.csi"

      NoFog

      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, BEND, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1  = mul(FogEnterMatrix, vPos);
        OUT.Tex2  = mul(FogMatrix, vPos);
        OUT.Color   = IN.Color;
      }
    