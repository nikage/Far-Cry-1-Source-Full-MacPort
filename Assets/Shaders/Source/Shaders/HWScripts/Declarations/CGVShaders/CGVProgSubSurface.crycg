// ===============================================
// Vertex Program: Sub surface scatering
// Description: compute fake subsurface coeficient
// Last Update: 7/04/2003
// Coder: Tiago Sousa
//
// Notes: could be better if scatering was dependent
// also of surface distance to light source
// ===============================================

#include "../CGVPMacro.csi"

Param4f (Name = LightPos Comp 'OSLightPos[0]' Comp 'OSLightPos[1]' Comp 'OSLightPos[2]' Comp = 1)
Param4f (Name = CameraPos Comp 'OSCameraPos[0]' Comp 'OSCameraPos[1]' Comp 'OSCameraPos[2]' Comp=1)
Param4f (Name = AttenInfo Comp 'LightIntens' Comp 'InvLightIntens' Comp=0.5)

// setup vertex components
VertAttributes
{
  POSITION_3
  TEXCOORD0_2
  TNORMAL_3
}

// setup vertex components
MainInput
{
  VIEWPROJ_MATRIX,
  LIGHT_POS,
  CAMERA_POS,
  ATTEN
}

DeclarationsScript
{
  // vertex input
  struct appin
  {
    IN_P
    IN_T0
    IN_TN
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_C0
  };

}

// output vertex position..
PositionScript = PosCommon

CoreScript
{
  // output texture coordinates
  OUT.Tex0.xy = IN.TexCoord0.xy;

  // compute light vector
  float3 LightVec=LightPos.xyz-IN.Position.xyz;
  // compute view vector
  float3 ViewVec=CameraPos.xyz-IN.Position.xyz;

  // compute vectors
  float3 OSLightVec=normalize(LightVec);
  float3 OSViewVec=normalize(ViewVec);

  // compute fake sub-surface scatering term
  float3 SubSurfaceScatTerm=dot(OSLightVec.xyz, IN.TNormal.xyz); 
  float3 SubSurfaceScatFinal=max(0, ((SubSurfaceScatTerm+1)*0.5));

  // compute fresnel term  (NOTE: fresnel coeficient (fresnelK) should be tweakable)
 // float FresnelK=0.4;
//  float3 Reflection=-OSViewVec+2*IN.TNormal.xyz*(max(dot( OSViewVec.xyz, IN.TNormal.xyz), 0));
//  float3 Fresnel=max(pow(1-max(dot(Reflection.xyz, IN.TNormal.xyz), 0), 5), 0);
  
  float fiSqDist = rsqrt(dot(LightVec, LightVec));
  float fAtten = PROC_ATTENVERT;
                        
  // output final color..
  OUT.Color.xyz=SubSurfaceScatFinal*fAtten; //*2*float3(1, 0.25, 0.2);

  return OUT;
}
