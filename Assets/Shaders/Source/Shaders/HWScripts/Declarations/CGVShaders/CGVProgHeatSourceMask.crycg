#include "../CGVPMacro.csi"

NoFog

VertAttributes 
{ 
  POSITION_3 
  TEXCOORD0_2 
  TANG_3X3 
}

MainInput 
{ 
  VIEWPROJ_MATRIX  
}

DeclarationsScript
{
  struct appin
  {
    IN_P
    IN_T0
    IN_TANG
  };
  struct vertout
  {
    OUT_P
    OUT_C0
  };

}

PositionScript = PosCommon

CoreScript
{
  OUT.Color=0;
}
