      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 SunDirect }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        float3 vNormal = IN.Color.xyz * (2).xxx - vPos.www;
        float fDot = dot(SunDirect.xyz, vNormal);
        OUT.Tex0.xy = (fDot * 0.2).xx;
        OUT.Color.xyz = fDot.xxx;
      }
    