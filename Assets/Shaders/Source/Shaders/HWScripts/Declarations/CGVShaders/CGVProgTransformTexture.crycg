      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 TEXCOORD0_2 }
      MainInput { VIEWPROJ_MATRIX, uniform float4 MatrixRow0, uniform float4 MatrixRow1, uniform float4 MatrixRow2, uniform float4 MatrixRow3 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.x = dot(IN.TexCoord0, MatrixRow0);
        OUT.Tex0.y = dot(IN.TexCoord0, MatrixRow1);
        OUT.Tex0.z = dot(IN.TexCoord0, MatrixRow2);
        OUT.Tex0.w = dot(IN.TexCoord0, MatrixRow3);
        OUT.Color   = IN.Color;
      }
    