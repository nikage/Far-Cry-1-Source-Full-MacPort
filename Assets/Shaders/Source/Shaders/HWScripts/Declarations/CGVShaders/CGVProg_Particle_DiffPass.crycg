      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 }
      
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, ATTEN }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Color1.xyz = AttenInfo.x-length(LightPos.xyz - vPos.xyz)*AttenInfo.y;
        OUT.Color = IN.Color;
# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color1.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif          
      }
    