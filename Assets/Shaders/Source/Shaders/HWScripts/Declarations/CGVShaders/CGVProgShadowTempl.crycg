      #include "../CGVPMacro.csi"

      AutoEnumTC

      VertAttributes
      {
        POSITION_3
        TEXCOORD0_2
#if %ENVCMAMB || %TEMP_ENVLIGHT
        TNORMAL_3
#endif
#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING
        TANGENT_3
        BINORMAL_3
#endif
      }

      MainInput
      {
        VIEWPROJ_MATRIX,
        uniform float4x4 TexGen0,
#if %TEMP_SHAD_SAMPLEMASK1
        uniform float4x4 TexGen1,
#endif
#if %TEMP_SHAD_SAMPLEMASK2
        uniform float4x4 TexGen2,
#endif

#if %TEMP_MIXED_MAP  
        uniform float2x4 ShadowModelMatr0,
  #if %TEMP_SHAD_SAMPLEMASK1
        uniform float2x4 ShadowModelMatr1,
  #endif
  #if %TEMP_SHAD_SAMPLEMASK2
        uniform float2x4 ShadowModelMatr2,
  #endif
        uniform float ShadowBias,
        uniform float4 LightPos,
#endif

#if %TEMP_ENVLIGHT
        uniform float4 EnvColors[6],
        uniform float4x4 TexMatrix,
#elif %ENVCMAMB
        CAMERA_POS,
        uniform float4x4 TexMatrix,
#endif        

#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING
  #if !%ENVCMAMB
        CAMERA_POS,
  #endif
#endif

      }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
#if %ENVCMAMB || %TEMP_ENVLIGHT || %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING
          IN_TANG
#endif
        };

        // define outputs from vertex shader
        struct vertout
        {
          float4 HPosition  : POSITION;
          float4 shadTC0     : TEXCOORDN;
#if %TEMP_SHAD_SAMPLEMASK1
          float4 shadTC1     : TEXCOORDN;
#endif
#if %TEMP_SHAD_SAMPLEMASK2
          float4 shadTC2     : TEXCOORDN;
#endif
          float2 baseTC      : TEXCOORDN;

#if %PERPIXEL_SHADOWMAP
          float4 viewVec     : TEXCOORDN;
          float4 Tangent     : TEXCOORDN;
          float4 Binormal    : TEXCOORDN;
#elif %OFFSETBUMPMAPPING
          float4 viewVec     : TEXCOORDN;
#endif

#if %TEMP_MIXED_MAP
          float4 depthTC0    : TEXCOORDN;
  #if %TEMP_SHAD_SAMPLEMASK2
          float4 depthTC1    : TEXCOORDN;
  #endif
          float4 lightVec    : TEXCOORDN;
#endif

#ifdef D3D
  #if %TEMP_DEPTH_MAP || %TEMP_DEPTH_MAP_PS20
          float4 WTC         : TEXCOORDN;
  #endif
#endif

          float4 Color      : COLOR0;
#if %ENVCMAMB
          float4 envTC      : TEXCOORDN;
#endif
        };
      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.baseTC.xy = IN.TexCoord0.xy;

#if %PERPIXEL_SHADOWMAP || %OFFSETBUMPMAPPING
        TANG_MATR

        // compute view vector
        float3 vVec = CameraPos.xyz - vPos.xyz;
        float3 viewVec = mul(objToTangentSpace, vVec.xyz);
        OUT.viewVec.xyz = viewVec.xyz;
  #if %PERPIXEL_SHADOWMAP
        OUT.Tangent.xyz = IN.Tangent.xyz;
        OUT.Binormal.xyz = IN.Binormal.xyz;
  #endif
#endif

        float4 shadTC0 = mul(TexGen0, vPos);          
        OUT.shadTC0 = shadTC0;
#if %TEMP_SHAD_SAMPLEMASK1
        float4 shadTC1 = mul(TexGen1, vPos);
        OUT.shadTC1 = shadTC1;
#endif
#if %TEMP_SHAD_SAMPLEMASK2
        float4 shadTC2 = mul(TexGen2, vPos);
        OUT.shadTC2 = shadTC2;
#endif

#ifdef D3D
  #if %TEMP_DEPTH_MAP || %TEMP_DEPTH_MAP_PS20
        float4 WTC = (float4)0;
        WTC.w = 1;
        WTC.z = shadTC0.w * 0.5 + 0.5;
    #if %TEMP_SHAD_SAMPLEMASK1
        WTC.y = shadTC1.w * 0.5 + 0.5;
    #endif
    #if %TEMP_SHAD_SAMPLEMASK2
        WTC.x = shadTC2.w * 0.5 + 0.5;
    #endif
        OUT.WTC = WTC;
  #endif
#endif

#if %TEMP_MIXED_MAP  
        OUT.lightVec.xyz = LightPos.xyz - vPos.xyz;
        
        float fZ = dot(ShadowModelMatr0._11_12_13_14, vPos);
        float fW = dot(ShadowModelMatr0._21_22_23_24, vPos);
        OUT.depthTC0.x = fZ;
        OUT.depthTC0.y = fW;

    #if %TEMP_SHAD_SAMPLEMASK1
        fZ = dot(ShadowModelMatr1._11_12_13_14, vPos);
        fW = dot(ShadowModelMatr1._21_22_23_24, vPos);
        OUT.depthTC0.z = fZ;
        OUT.depthTC0.w = fW;
    #endif

    #if %TEMP_SHAD_SAMPLEMASK2
        fZ = dot(ShadowModelMatr2._11_12_13_14, vPos);
        fW = dot(ShadowModelMatr2._21_22_23_24, vPos);
        OUT.depthTC1.x = fZ;
        OUT.depthTC1.y = fW;
    #endif
#endif

#if %TEMP_ENVLIGHT
        // Calculate average radiosity color from 6 colors (Cube)
        float3 tNormal;
        tNormal = mul((float3x3)TexMatrix, IN.TNormal.xyz);        
        float3 Compare1 = step(tNormal, 0);
        float3 Compare0 = 1 - Compare1;
        float3 signN = sign(tNormal);
        tNormal = tNormal * tNormal;
        tNormal = tNormal * signN;
        float4 ColorX = EnvColors[0]*tNormal.x*Compare0.x + EnvColors[1]*(-tNormal.x)*Compare1.x;
        float4 ColorY = EnvColors[2]*tNormal.y*Compare0.y + EnvColors[3]*(-tNormal.y)*Compare1.y;
        float4 ColorZ = EnvColors[4]*tNormal.z*Compare0.z + EnvColors[5]*(-tNormal.z)*Compare1.z;
        OUT.Color = (ColorX + ColorY + ColorZ) * 2.0;
#elif %ENVCMAMB
  #if !%PERPIXEL_SHADOWMAP && !%OFFSETBUMPMAPPING
        float3 vVec = CameraPos.xyz - vPos.xyz;
  #endif
        float3 tCamVec = normalize(vVec);
        float3 tNormal = IN.TNormal.xyz;
        float3 tRef = dot(tNormal.xyz, tCamVec.xyz) * tNormal.xyz * 2 - tCamVec.xyz;
        float4 tRM;
        tRM.xyz = tRef.xyz;
        tRM.w = vPos.w;
        OUT.envTC = mul(tRM, TexMatrix);
 #if %ENVCM_MASKED
        OUT.baseTC.zw = IN.TexCoord0.xy;
 #endif  
#endif

# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif        
      }
    