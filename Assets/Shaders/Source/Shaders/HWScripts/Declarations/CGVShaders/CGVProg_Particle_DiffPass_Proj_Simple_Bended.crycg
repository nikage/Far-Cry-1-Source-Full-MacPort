      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 }
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, LIGHT_MATRIX, uniform float4 LightColor, uniform float4 MulOverbright, uniform float4 AmbColor, BEND }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_C0
        };

      }
      PositionScript = PosBending
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1 = mul(LightMatrix, vPos);
        OUT.Color = IN.Color * LightColor * MulOverbright + AmbColor;
      }
    