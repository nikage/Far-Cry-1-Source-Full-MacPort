      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 Layer1TexGen0, uniform float4 Layer1TexGen1, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_T3_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);          
        OUT.Tex0.y = dot(BaseTexGen1, vPos);          
        OUT.Tex1.x = dot(Layer1TexGen0, vPos);          
        OUT.Tex1.y = dot(Layer1TexGen1, vPos);          
        OUT.Tex2.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex3.xy  = mul(FogMatrix, vPos);
        OUT.Color.a = IN.Color.a;
        OUT.Color.b = IN.Color.r;
      }
    