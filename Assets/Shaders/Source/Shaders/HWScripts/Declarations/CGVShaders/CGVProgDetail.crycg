      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 TEXCOORD0_2 }
      MainInput { VIEWPROJ_MATRIX, uniform float4 TexGen00, uniform float4 TexGen01, uniform float4 DetailScaling }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy * DetailScaling.xy;
        OUT.Tex1.x = dot(TexGen00, vPos);
        OUT.Tex1.y = dot(TexGen01, vPos);
      }
    