// ===============================================================
// Vertex Program: Blur
// Description: displaces textures coordinates for texture bluring
// Last Update: 12/09/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"


NoFog

// setup vertex components
MainInput
{
  // common model view matrix
  VIEWPROJ_MATRIX,

  // texture offsets
  uniform float4   Offset0,
  uniform float4   Offset1,
  uniform float4   Offset2,
  uniform float4   Offset3,
  
  uniform float4   vTexCoordScale // need uv scale, for rectangular textures in gl...
}

DeclarationsScript
{
  // vertex input
  struct appin
  {
    IN_P
    IN_T0
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_T1_2
    OUT_T2_2
    OUT_T3_2
  };

}

// output vertex position
PositionScript = PosCommon

CoreScript
{
  // output texture coordinates
  OUT.Tex0.xy = IN.TexCoord0.xy*vTexCoordScale.xy+Offset0.xy;//*vTexCoordScale.w;
  OUT.Tex1.xy = IN.TexCoord0.xy*vTexCoordScale.xy+Offset1.xy;//*vTexCoordScale.w;
  OUT.Tex2.xy = IN.TexCoord0.xy*vTexCoordScale.xy+Offset2.xy;//*vTexCoordScale.w;
  OUT.Tex3.xy = IN.TexCoord0.xy*vTexCoordScale.xy+Offset3.xy;//*vTexCoordScale.w;

  return OUT;
}
