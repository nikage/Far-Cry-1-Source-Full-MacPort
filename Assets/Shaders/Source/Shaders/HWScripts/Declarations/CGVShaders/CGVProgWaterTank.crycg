#include "../CGVPMacro.csi"


VertAttributes 
{ 
    POSITION_3 
    TEXCOORD0_2
    TANG_3X3
}

MainInput 
{ 
    VIEWPROJ_MATRIX, 
    LIGHT_POS,
    CAMERA_POS,
    ATTEN,
    uniform float4 Constants
}

DeclarationsScript
{
    struct appin
    {
      IN_P
      IN_T0
      IN_TANG
    };
    
    struct vertout
    {
      OUT_P
      OUT_T0
      OUT_T1
      OUT_T2_2
      OUT_T3
      OUT_T4      
      OUT_C0
    };

}

PositionScript = PosCommon

CoreScript
{  
    float4 vHPos = mul(ModelViewProj, vPos);
    if(vHPos.w<0.5) vHPos.w=0.5;

    float2 vTranslation=Constants.yy%1;
    OUT.Tex0.xy =IN.TexCoord0.xy*0.005+vTranslation.xy;
    OUT.Tex0.zw=IN.TexCoord0.xy*0.005-vTranslation.yy;
    
    // optimized perspective correct projection
    OUT.Tex1.xz = (vHPos.xz  + vHPos.w)*0.5;
    OUT.Tex1.y =  (-vHPos.y  + vHPos.w)*0.5;
    OUT.Tex1.w   = vHPos.w;  

    float3 ViewVec=CameraPos.xyz-IN.Position.xyz;
    float3 LightVec=LightPos.xyz-IN.Position.xyz;
    
    float3 OSViewVec=normalize(ViewVec);
    float3 OSLightVec=normalize(LightVec);
    float fReflDot= dot(OSViewVec, IN.TNormal.xyz);  
    float3 reflVector =(2*IN.TNormal.xyz*fReflDot-OSViewVec.xyz);  
    OUT.Tex2.xy = (reflVector.xz+1.0)*0.5;

    TANG_MATR
    OUT.Tex3.xyz = mul(objToTangentSpace, ViewVec.xyz);

    OUT.Tex4.xyz = mul(objToTangentSpace,IN.TNormal.xyz);
    OUT.Color.w=1; 

    return OUT;
}
