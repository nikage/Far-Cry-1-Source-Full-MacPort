      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 Offset }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        // Offset.x - Bias
        float4 hPos = mul(ModelViewProj, vPos);
        hPos.w = hPos.w + Offset.x;
        OUT.HPosition = hPos;
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Color = IN.Color;
      }
    