      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 DecalAtten }
      
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);
        OUT.Tex0.y = dot(BaseTexGen1, vPos);

        float3 binorm = BaseTexGen0;
        float3 tang = BaseTexGen1;
        float3 norm = cross(binorm, tang);
        binorm = cross(norm, tang);

        float3x3 objToTangentSpace;
        objToTangentSpace[0] = normalize(tang);
        objToTangentSpace[1] = normalize(binorm);
        objToTangentSpace[2] = normalize(norm);
                
        float3 vVec = DecalAtten.xyz - vPos.xyz;
        float3 vtVec = mul(objToTangentSpace, vVec);          
        float3 vDist = vtVec * ((1/DecalAtten.w) * 0.5) + 0.5;
        OUT.Tex1.xyz = vDist;
        OUT.Color.xyz = vDist;
      }
    