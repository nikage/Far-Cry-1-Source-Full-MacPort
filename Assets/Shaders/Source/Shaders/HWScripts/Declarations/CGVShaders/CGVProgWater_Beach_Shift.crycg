      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR }
      MainInput { VIEWPROJ_MATRIX, uniform float4 TexScale, uniform float4 TexShift }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy * TexScale.xy + TexShift.xy;
        OUT.Color = IN.Color;
      }
    