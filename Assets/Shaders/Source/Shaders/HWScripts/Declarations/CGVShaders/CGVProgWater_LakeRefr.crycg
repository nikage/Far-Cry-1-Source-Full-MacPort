      #include "../CGVPMacro.csi"

      Noise
      Projected

      Param4f ( Name = NoisePos Comp 'time 0.8' Comp 'time 0.6' Comp = 0 User 'WaveAmplitude') // xy = wavepos, z = 0, w = amplitude

      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexProjMatrix, uniform float4 NoisePos, uniform float4 pg[66] : register(c30) }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_C0
        };

      }
      PositionScript = PosWaterDeform
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        
        float4 vProjTex;
        vProjTex = mul(TexProjMatrix, vPos);
  #ifdef PROJECTEDENVBUMP
        OUT.Tex1 = vProjTex;
  #endif        
  #ifdef OTHER
        vProjTex.xy = vProjTex.xy / vProjTex.w;
        OUT.Tex1.xy = clamp(vProjTex.xy, (0).xx, vPos.ww);
        OUT.Tex1.zw = vPos.ww;
  #endif        

        OUT.Color = IN.Color;
      }
    