// ===============================================================
// Vertex Program: Glare
// Description: output glare texture coordinates
// Last Update: 09/08/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

// setup vertex components
MainInput
{
  // common model view matrix
  VIEWPROJ_MATRIX,

  // texture offsets
  uniform float4 vTexCoordScale01,
  uniform float4 vTexCoordScale02,
  uniform float4 vTexCoordScale03,
  uniform float4 vTexCoordScale04 
}

DeclarationsScript
{
  // vertex input
  struct appin
  {
    IN_P
    IN_T0
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_T1_2
    OUT_T2_2
    OUT_T3_2
  };

}

// output vertex position
PositionScript = PosCommon

CoreScript
{

  // output texture coordinates
  OUT.Tex0.xy = (IN.TexCoord0.xy+vTexCoordScale01.zw)*vTexCoordScale01.xy;
  OUT.Tex1.xy = (IN.TexCoord0.xy+vTexCoordScale02.zw)*vTexCoordScale02.xy;
  OUT.Tex2.xy = (IN.TexCoord0.xy+vTexCoordScale03.zw)*vTexCoordScale03.xy;
  OUT.Tex3.xy = (IN.TexCoord0.xy+vTexCoordScale04.zw)*vTexCoordScale04.xy;
    
  return OUT;
}

