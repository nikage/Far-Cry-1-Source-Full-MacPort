      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, BEND, uniform float2x4 TexGen }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_C0
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = mul(TexGen, vPos);
        OUT.Color   = IN.Color;
      }
    