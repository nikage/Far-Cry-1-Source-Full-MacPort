      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      NoFog
      VS20Only

      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, uniform float4x4 TexGen1, uniform float4x4 TexGen2, LIGHT_POS, ATTEN, LIGHT_MATRIX }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3_2
          OUT_T4
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex3.xy = IN.TexCoord0.xy;
        OUT.Tex4 = mul(LightMatrix, vPos);
        OUT.Color = IN.Color;
        
        OUT.Tex0 = mul(TexGen0, vPos);          
        OUT.Tex1 = mul(TexGen1, vPos);          
        OUT.Tex2 = mul(TexGen2, vPos);          
      }
    