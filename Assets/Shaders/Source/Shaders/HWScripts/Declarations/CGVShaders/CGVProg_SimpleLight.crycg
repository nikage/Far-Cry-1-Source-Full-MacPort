      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, LIGHT_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        // Ambient color
        float3 cAmbient = float3(0.2, 0.2, 0.2);
        // Diffuse color
        float3 cDiffuse = float3(1, 0.8, 0.2);
        
        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);
        float fDiffuse = dot(vLightDir, IN.Normal);
        OUT.Color.xyz = cDiffuse * fDiffuse + cAmbient;
        OUT.Color.w = 1;
        OUT.Tex0 = IN.TexCoord;
      }
    