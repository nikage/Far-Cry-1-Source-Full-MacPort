      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR }

      NoFog      
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, uniform float4x4 TexGen1, LIGHT_POS, ATTEN }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex2.xy = IN.TexCoord0.xy;
        OUT.Tex0 = mul(TexGen0, vPos);          
        OUT.Tex1 = mul(TexGen1, vPos);          
        
        OUT.Color1.xyz = AttenInfo.x-length(LightPos.xyz - vPos.xyz)*AttenInfo.y;
        OUT.Color = IN.Color;
      }
    