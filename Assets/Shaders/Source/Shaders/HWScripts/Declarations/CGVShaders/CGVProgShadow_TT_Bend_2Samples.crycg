      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      //NoFog      
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, uniform float4x4 TexGen1, BEND, TEX_MATRIX2x4 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2_2
          OUT_T3
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        float4 shadTC0 = mul(TexGen0, vPos);
        OUT.Tex0 = shadTC0;
        float4 shadTC1 = mul(TexGen1, vPos);
        OUT.Tex1 = shadTC1;

        OUT.Tex2.xy = mul(TexMatrix, IN.TexCoord0);
#ifdef D3D
        float4 WTC = (float4)0;
        WTC.w = 1;
        WTC.z = shadTC0.w * 0.5 + 0.5;
        WTC.y = shadTC1.w * 0.5 + 0.5;
        OUT.Tex3 = WTC;
#endif        
      }
    