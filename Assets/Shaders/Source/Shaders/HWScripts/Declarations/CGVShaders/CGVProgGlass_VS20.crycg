
      #include "../CGVPMacro.csi"

      VS20Only
      
      VertAttributes { POSITION_3 NORMAL_3 }
      MainInput { VIEWPROJ_MATRIX, CAMERA_POS, uniform float4x4 TexProjMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xyz = IN.Normal.xyz;
        OUT.Tex1.xyz = CameraPos.xyz - vPos.xyz;
      }
    