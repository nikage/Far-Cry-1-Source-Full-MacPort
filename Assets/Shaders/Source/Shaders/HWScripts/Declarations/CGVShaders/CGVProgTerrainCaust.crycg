      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 PRIM_COLOR }
      
      MainInput { VIEWPROJ_MATRIX, CAMERA_POS, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 CaustTexGen0, uniform float4 CaustTexGen1, uniform float3 WaterLevel }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);
        OUT.Tex0.y = dot(BaseTexGen1, vPos);
        OUT.Tex1.x = dot(CaustTexGen0, vPos);
        OUT.Tex1.y = dot(CaustTexGen1, vPos);
        
        float fDistBlendFactor = vPos.w - length(vPos.xyz - CameraPos.xyz) * CameraPos.w;
        OUT.Color.xyz = fDistBlendFactor * (float)((WaterLevel.x - vPos.z) >= 2);
        OUT.Color.a = IN.Color.w;
      }
    