      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      NoFog      
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, uniform float4x4 TexGen1, uniform float4x4 TexGen2, uniform float4x4 TexGen3 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0 = mul(TexGen0, vPos);          
        OUT.Tex1 = mul(TexGen1, vPos);          
        OUT.Tex2 = mul(TexGen2, vPos);          
        OUT.Tex3 = mul(TexGen3, vPos);          
      }
    