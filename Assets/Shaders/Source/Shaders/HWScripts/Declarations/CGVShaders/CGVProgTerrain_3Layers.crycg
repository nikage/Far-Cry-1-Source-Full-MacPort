      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 Layer1TexGen0, uniform float4 Layer1TexGen1, uniform float4 Layer2TexGen0, uniform float4 Layer2TexGen1, uniform float4 Layer3TexGen0, uniform float4 Layer3TexGen1, CAMERA_POS, uniform float4 FadingDist  }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_T3_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);          
        OUT.Tex0.y = dot(BaseTexGen1, vPos);          
        OUT.Tex1.x = dot(Layer1TexGen0, vPos);          
        OUT.Tex1.y = dot(Layer1TexGen1, vPos);          
        OUT.Tex2.x = dot(Layer2TexGen0, vPos);          
        OUT.Tex2.y = dot(Layer2TexGen1, vPos);          
        OUT.Tex3.x = dot(Layer3TexGen0, vPos);          
        OUT.Tex3.y = dot(Layer3TexGen1, vPos);          
        OUT.Color.a = IN.Color.a;

        float3 viewVec = CameraPos.xyz - vPos.xyz;
        float fDist = length(viewVec.xyz);
        float fFade = max(0.001, FadingDist.x);
        fDist = fDist / fFade;
        fDist = min(fDist, 1);
        fDist = fDist * fDist;
        fDist = fDist * fDist;
        
        OUT.Color.b = IN.Color.r * fDist;
        OUT.Color1.b = IN.Color.g * fDist;
        OUT.Color1.g = IN.Color.b * fDist;
    
# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color1.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif        
      }
    