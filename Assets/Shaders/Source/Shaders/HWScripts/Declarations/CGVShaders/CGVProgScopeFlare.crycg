// ===============================================================
// Vertex Program: Scope Flare
// Description: used for scope flare effect
// Last Update: 16/12/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR }

Projected

// setup vertex components
MainInput
{
  // common model view matrix
  VIEWPROJ_MATRIX,
  uniform float4   CameraPos
}

DeclarationsScript
{

  // vertex input
  struct appin
  {
    IN_P
    IN_T0
    IN_C0
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_T1
    OUT_T2
    OUT_C0
  };

}

// output vertex position
PositionScript = PosCommon

CoreScript
{
  // output texture coordinates           
  OUT.Tex0.xy =IN.TexCoord0.xy;

  // output particle color
  OUT.Color.w = IN.Color;  
  
  return OUT;
}
