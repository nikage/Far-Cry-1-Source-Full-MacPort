      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 NORMAL_3 TEXCOORD0_2 }
      
      MainInput { VIEWPROJ_MATRIX, uniform float4 Constants }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        vPos.xyz = vPos.xyz + IN.Normal.xyz * Constants.z;
        float4 vHPos = mul(ModelViewProj, vPos);        
        OUT.Tex1.xy = (vHPos.xy / vHPos.w + Constants.x) * Constants.y;
        OUT.Color.xyz = (0.3).xxx;
        OUT.Tex0.xy = IN.TexCoord0;
        OUT.Tex2.xy = IN.TexCoord0;
      }
    