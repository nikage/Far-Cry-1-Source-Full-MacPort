      #include "../CGVPMacro.csi"

      VertAttributes { POSITION_3 TEXCOORD0_2 }

      VS20Only

      //NoFog      
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, uniform float4x4 TexGen0, uniform float4x4 TexGen1, uniform float4x4 TexGen2, BEND, TEX_MATRIX2x4, uniform float2x4 ShadowModelMatr0, uniform float2x4 ShadowModelMatr1, uniform float2x4 ShadowModelMatr2, uniform float ShadowBias }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3_2
          OUT_T4
          OUT_T5_2
        };

      }
      PositionScript = PosBending                 
      CoreScript
      {
        OUT.Tex0 = mul(TexGen0, vPos);          
        OUT.Tex1 = mul(TexGen1, vPos);          
        OUT.Tex2 = mul(TexGen2, vPos);          
        OUT.Tex3.xy = mul(TexMatrix, IN.TexCoord0);

        float fZ = dot(ShadowModelMatr0._11_12_13_14, vPos);
        float fW = dot(ShadowModelMatr0._21_22_23_24, vPos);
        OUT.Tex4.x = fZ;
        OUT.Tex4.y = fW;

        fZ = dot(ShadowModelMatr1._11_12_13_14, vPos);
        fW = dot(ShadowModelMatr1._21_22_23_24, vPos);
        OUT.Tex4.z = fZ;
        OUT.Tex4.w = fW;

        fZ = dot(ShadowModelMatr2._11_12_13_14, vPos);
        fW = dot(ShadowModelMatr2._21_22_23_24, vPos);
        OUT.Tex5.x = fZ;
        OUT.Tex5.y = fW;
      }
    