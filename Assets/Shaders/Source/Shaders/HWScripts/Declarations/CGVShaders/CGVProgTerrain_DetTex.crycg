      #include "../CGVPMacro.csi"

      DefaultPos

      MainInput { VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1, uniform float4 DetTexGen0, uniform float4 DetTexGen1 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);          
        OUT.Tex0.y = dot(BaseTexGen1, vPos);          
        OUT.Tex1.x = dot(DetTexGen0, vPos);          
        OUT.Tex1.y = dot(DetTexGen1, vPos);          
        OUT.Color.xyz = IN.Color.www;
      }
    