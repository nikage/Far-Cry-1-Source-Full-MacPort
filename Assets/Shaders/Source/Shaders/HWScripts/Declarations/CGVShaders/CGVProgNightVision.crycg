#include "../CGVPMacro.csi"


// setup vertex components
MainInput
{
  // common model view matrix
  VIEWPROJ_MATRIX,
  
  // screen noise parameters, xy is tilling, zw is offset
  uniform float4   fNoiseParams
}

DeclarationsScript
{
  // vertex input
  struct appin
  {
    IN_P
    IN_T0
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
    OUT_T1_2
  };

}

// output vertex position
PositionScript = PosCommon

CoreScript
{
  // output texture coordinates
  OUT.Tex0.xy = IN.TexCoord0.xy;
  OUT.Tex1.xy = float2(IN.TexCoord0.x*fNoiseParams.x+fNoiseParams.z, IN.TexCoord0.y*fNoiseParams.y+fNoiseParams.w);

  return OUT;
}
