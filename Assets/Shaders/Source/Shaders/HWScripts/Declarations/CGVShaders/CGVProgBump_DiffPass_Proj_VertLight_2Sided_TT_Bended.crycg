      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 TNORMAL_3 }
      Param4f (Name = Bend Comp 'ObjWaveX' Comp 'ObjWaveY' Comp 'Bending' Comp = 1)
      MainInput { VIEWPROJ_MATRIX, TEX_MATRIX2x4, LIGHT_MATRIX, LIGHT_POS, ATTEN, BEND }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TN
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosBending
      CoreScript
      {
        float2 tCoords = mul(TexMatrix, IN.TexCoord0);
        OUT.Tex0.xy = tCoords;
        OUT.Tex1 = mul(LightMatrix, vPos);

        // store normalized light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        float fiSqDist = rsqrt(dot(lightVec, lightVec));
        float3 lVec = lightVec * fiSqDist;

        float3 normal = IN.TNormal;
        float fDot = dot(lVec, normal);
        normal = normal * sign(fDot);
        
        OUT.Color.xyz = IN.Color.xyz;
        float fAtten = PROC_ATTENVERT;
        OUT.Color.w = fAtten * saturate(dot(lVec, normal.xyz));
# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color1.xyzw = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif        
      }
    