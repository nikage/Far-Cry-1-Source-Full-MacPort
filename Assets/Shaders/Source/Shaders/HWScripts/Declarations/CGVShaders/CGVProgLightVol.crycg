      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 TANG_3X3 }
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TN
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;

        float3 lightVec = LightPos.xyz - vPos.xyz;
        OUT.Tex3.xyz = lightVec.xyz;

        float3 viewVec = vPos.xyz - CameraPos.xyz;
        OUT.Tex1.xyz = viewVec.xyz;

        float3 lVec = LightPos.xyz - CameraPos.xyz;
        OUT.Tex2.xyz = lVec;
        OUT.Tex4.xyz = IN.TNormal.xyz;
      }
    