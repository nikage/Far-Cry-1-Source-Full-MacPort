      #include "../CGVPMacro.csi"

      NoFog

      VertAttributes { POSITION_3 TNORMAL_3 }
      
      MainInput { VIEWPROJ_MATRIX, uniform float4 Offset }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        vPos.xyz = vPos.xyz + IN.TNormal.xyz*Offset.x;
        OUT.HPosition = mul(ModelViewProj, vPos);
        float fZ = dot(ModelViewProj._31_32_33_34, vPos);
        float fW = dot(ModelViewProj._41_42_43_44, vPos);
        OUT.Tex0.xy = fZ;
        OUT.Tex0.zw = fW;
      }
    