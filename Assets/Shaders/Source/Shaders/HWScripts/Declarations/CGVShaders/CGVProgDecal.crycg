      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, uniform float4 BaseTexGen0, uniform float4 BaseTexGen1 }
      
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.x = dot(BaseTexGen0, vPos);
        OUT.Tex0.y = dot(BaseTexGen1, vPos);
      }
    