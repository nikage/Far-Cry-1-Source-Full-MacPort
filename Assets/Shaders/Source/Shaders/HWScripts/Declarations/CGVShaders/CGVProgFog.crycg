      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 }
      MainInput { VIEWPROJ_MATRIX, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex1.xy  = mul(FogMatrix, vPos);
      }
    