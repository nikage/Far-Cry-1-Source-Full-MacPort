      #include "../CGVPMacro.csi"


      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, uniform float4 Modifiers }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_C0
        };

      }
      PositionScript = PosFur

      CoreScript
      {
        OUT.Tex0 = IN.TexCoord0;

        // Simple light calculations (L dot N)
        // Diffuse color
        float3 cDiffuse = float3(1, 1, 1);
        float3 vLightDir = normalize(LightPos.xyz - vPos.xyz);
        float fDiffuse = dot(vLightDir, IN.Normal.xyz);
        OUT.Color.xyz = cDiffuse * fDiffuse;

        // Here we set the diffuse alpha component
        OUT.Color.w = Modifiers.y;
      }
    