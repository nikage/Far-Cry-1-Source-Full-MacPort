      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 TEXCOORD0_2 TEXCOORD1_2 }
      
      MainInput { VIEWPROJ_MATRIX }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_T1
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_T3_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;
        OUT.Tex2.xy = IN.TexCoord1.xy;
        OUT.Tex3.xy = IN.TexCoord1.xy;
      }
    