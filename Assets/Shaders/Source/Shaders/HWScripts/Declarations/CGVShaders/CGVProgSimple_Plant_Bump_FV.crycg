      #include "../CGVPMacro.csi"

      NoFog

      VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR SEC_COLOR }
      MainInput { VIEWPROJ_MATRIX, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
          IN_C1
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_T3_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy; // * float2(4,0.5);
                
        // Tangent space light vector
        OUT.Color1.xyz = IN.Color1.xyz;
        OUT.Color   = IN.Color;

        OUT.Tex2.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex3.xy  = mul(FogMatrix, vPos);
      }
    