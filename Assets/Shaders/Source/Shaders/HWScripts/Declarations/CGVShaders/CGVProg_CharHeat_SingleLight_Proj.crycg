
      #include "../CGVPMacro.csi"


      VertAttributes { TNORMAL_3 TANG_3X3 }
      MainInput { VIEWPROJ_MATRIX, uniform float3 LightPos, LIGHT_MATRIX, ATTEN, CAMERA_POS }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;
        OUT.Tex2 = mul(LightMatrix, vPos);

        TANG_MATR

        // store normalized light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        float fiSqDist = rsqrt(dot(lightVec, lightVec));
        lightVec = lightVec * fiSqDist;
        
        OUT.Color.a = PROC_ATTENVERT;
        float fDirect = (AttenInfo.z - AttenInfo.y) * AttenInfo.w;
        lightVec = lightVec * fDirect.x;
        OUT.Color1.xyz = 0.5 * mul(objToTangentSpace, lightVec.xyz) + 0.5.xxx;

        // calc normalized eye vector
        float3 eyeVec = normalize(CameraPos.xyz - vPos.xyz);
        
        OUT.Color.xyz = (dot(IN.TNormal, eyeVec)).xxx;
      }
    