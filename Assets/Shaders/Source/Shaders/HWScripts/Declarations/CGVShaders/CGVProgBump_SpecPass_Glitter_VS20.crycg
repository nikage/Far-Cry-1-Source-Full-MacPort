
      #include "../CGVPMacro.csi"

      VS20Only

      VertAttributes { POSITION_3 TEXCOORD0_2 TANG_3X3 }
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, uniform float4x4 ObjMatrix }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_TANG
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2
          OUT_T3
          OUT_T4
          OUT_T5
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;

        TANG_MATR

        // store light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        // transform light vector from object space to tangent space and pass it as a tex coords
        OUT.Tex2.xyz = mul(objToTangentSpace, lightVec.xyz);

        // store view vector
        float4 viewVec;
        viewVec.xyz = CameraPos.xyz - vPos.xyz;
        viewVec.w = vPos.w;
        // transform view vector from object space to tangent space and pass it as a tex coords
        OUT.Tex3.xyz = mul(objToTangentSpace, viewVec.xyz);
        
        OUT.Tex4.xyz = vPos.xyz;
        OUT.Tex5 = mul(ObjMatrix, viewVec);
      }
    