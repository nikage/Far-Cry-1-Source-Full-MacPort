      #include "../CGVPMacro.csi"

      DefaultPos

      VertAttributes { POSITION_3 TEXCOORD0_2 PRIM_COLOR SEC_COLOR }
      MainInput { VIEWPROJ_MATRIX, uniform float4 TexGenSR0, uniform float4 TexGenSR1 }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_T0
          IN_C0
          IN_C1
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_C0
          OUT_C1
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy = IN.TexCoord0.xy;
        OUT.Tex1.xy = IN.TexCoord0.xy;
        OUT.Tex2.x = dot(TexGenSR0, vPos);
        OUT.Tex2.y = dot(TexGenSR1, vPos);
                
        // Tangent space light vector
        OUT.Color1.xyz = IN.Color1.xyz;

        OUT.Color   = IN.Color;

# ifdef _HDR
        float ffCameraSpacePosZ = dot(ModelViewProj._31_32_33_34, vPos);
        OUT.Color1.w = clamp((Fog.y - Fog.x*ffCameraSpacePosZ), g_VSCONST_0_025_05_1.x, g_VSCONST_0_025_05_1.w);
# endif        
      }
    