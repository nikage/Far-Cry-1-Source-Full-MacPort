
#include "../CGVPMacro.csi"


NoFog

// setup vertex components
MainInput
{
  // common model view matrix
  VIEWPROJ_MATRIX,

  uniform float4   PixelOffset
}

DeclarationsScript
{
  // vertex input
  struct appin
  {
    IN_P
    IN_T0
  };
  struct vertout
  {
    OUT_P
    OUT_T0_2
  };

}

// output vertex position
PositionScript = PosCommon

CoreScript
{
  // output texture coordinates
  OUT.Tex0.xy = IN.TexCoord0.xy + PixelOffset.xy * 0.5;

  return OUT;
}
