  // setup vertex components
  VertAttributes
  {
    POSITION_3
    TEXCOORD0_2
    TANG_3X3
  }

  // setup vertex components
  MainInput
  {
    VIEWPROJ_MATRIX,
    LIGHT_POS,
    CAMERA_POS
  }

  DeclarationsScript
  {
    IN_T0_TANG
    OUT_T0_T1_C0
  }

  PositionScript = PosCommon

  CoreScript
  {

    OUT.Tex0.xy = IN.TexCoord0.xy;
    OUT.Tex1.xy = IN.TexCoord0.xy;

    // get 3x3 tangent space tranformation matrix
    float3x3 MatrixTS;
    MatrixTS[0] = IN.Tangent;
    MatrixTS[1] = IN.Binormal;
    MatrixTS[2] = IN.TNormal;

    //  compute light vector
    float3 vLightOS = normalize(LightPos.xyz - IN.Position.xyz);

    // xform to tangent space
    vLightOS= mul(MatrixTS, vLightOS);
    OUT.Color.xyz=normalize(vLightOS);

    return OUT;
  }


