      #include "../CGVPMacro.csi"


      NoFog
      UnifiedPosScript
      
      VertAttributes { POSITION_3 }
      MainInput { uniform float4x4 ModelViewProj, uniform float2x4 FogMatrix, uniform float2x4 FogEnterMatrix, uniform float4 CaustTexGen0, uniform float4 CaustTexGen1, uniform float3 WaterLevel, uniform float4 CameraPos }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1_2
          OUT_T2_2
          OUT_C0
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        OUT.Tex0.xy  = mul(FogEnterMatrix, vPos);
        OUT.Tex1.xy  = mul(FogMatrix, vPos);
        OUT.Tex2.x = dot(CaustTexGen0, vPos);
        OUT.Tex2.y = dot(CaustTexGen1, vPos);

        float fDistBlendFactor = vPos.w - length(vPos.xyz - CameraPos.xyz) * CameraPos.w;
        OUT.Color.w = fDistBlendFactor * (float)((WaterLevel.x - vPos.z) >= vPos.w);
        OUT.Color.xyz = IN.Color.xyz;
      }
    