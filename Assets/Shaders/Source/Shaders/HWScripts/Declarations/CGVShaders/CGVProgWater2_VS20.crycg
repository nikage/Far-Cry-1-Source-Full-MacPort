      #include "../CGVPMacro.csi"

      VS20Only

      VertAttributes { POSITION_3 TEXCOORD0_2 NORMAL_3 PRIM_COLOR }
      MainInput { VIEWPROJ_MATRIX, CAMERA_POS, uniform float4 Scale }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
          IN_C0
          IN_N
        };
        struct vertout
        {
          OUT_P
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
        };

      }
      PositionScript = PosCommon
      CoreScript
      {
        OUT.Tex0.xyz = vPos.xyz * Scale.xyz;
        OUT.Tex1.xyz = IN.Normal.xyz;
        OUT.Tex2.xyz = vPos.xyz - CameraPos.xyz;
        OUT.Color = IN.Color;
      }
    