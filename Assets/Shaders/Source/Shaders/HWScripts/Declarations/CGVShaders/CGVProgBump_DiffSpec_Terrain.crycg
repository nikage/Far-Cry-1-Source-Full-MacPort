      #include "../CGVPMacro.csi"


      VertAttributes { POSITION_3 }
      
      MainInput { VIEWPROJ_MATRIX, LIGHT_POS, CAMERA_POS, uniform float3 Tangent, uniform float3 Binormal, uniform float3 ScaleBumpTex, uniform float2x4 TexGen }
      DeclarationsScript
      {
        struct appin
        {
          IN_P
        };
        struct vertout
        {
          OUT_P
          OUT_T0_2
          OUT_T1
          OUT_T2
          OUT_T3_2
        };

      }
      PositionScript = PosCommon                 
      CoreScript
      {
        float2 vTex = mul(TexGen, vPos);
        OUT.Tex0.xy = vTex * ScaleBumpTex.xy;
        OUT.Tex3.xy = vTex;
        
        float3 TNormal = cross(Tangent, Binormal);

        // compute the 3x3 tranform from tangent space to object space
        float3x3 objToTangentSpace;
        objToTangentSpace[0] = Tangent;
        objToTangentSpace[1] = Binormal;
        objToTangentSpace[2] = TNormal;

        // store normalized light vector
        float3 lightVec = LightPos.xyz - vPos.xyz;
        // transform light vector from object space to tangent space and pass it as a tex coords
        OUT.Tex1.xyz = mul(objToTangentSpace, lightVec.xyz);

        // compute view vector
        float3 viewVec = CameraPos.xyz - vPos.xyz;

        // compute half angle vector
        float3 halfAngleVector = lightVec.xyz + viewVec;

        // transform half angle vector from object space to tangent space and pass it as a tex coords
        OUT.Tex2.xyz = mul(objToTangentSpace, halfAngleVector);
      }
    