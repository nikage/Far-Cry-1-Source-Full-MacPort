
#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0,
  uniform FLOAT4 vSampleOffsets[1]
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  FLOAT4 sample = 0.0f;

  for(int i=0; i<1; i++)
  {
    sample += tex2D(baseMap, IN.Tex0.xy + vSampleOffsets[i].xy);
  }
    
  OUT.Color = sample;
}

