      #include "../CGVPMacro.csi"

      PS20Only
      NoFog

      MainInput { uniform sampler2D shadMap0 : register(s0),
                  uniform sampler2D baseMap : register(s1),
                  uniform float4 Ambient,
                  uniform float4 Diffuse,
                  uniform float4 Fading }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        FLOAT4 decalColor = tex2D(baseMap, IN.Tex1.xy);

        FLOAT3 dif = (decalColor.xyz * Diffuse.xyz * IN.Color1.xyz * IN.Color.xyz);
        FLOAT3 amb = decalColor.xyz * Ambient.xyz;
        dif = HDREncode(dif);
        amb = HDREncodeAmb(amb);

        // load the 1 shadow sample
        FLOAT4 shadColor0 = tex2Dproj(shadMap0, IN.Tex0.xyzw);
        FLOAT fShadow = (1-shadColor0.b) * Fading.x;
                
        OUT.Color.xyz = amb + dif * (1-fShadow);
        OUT.Color.w = decalColor.w * Ambient.w * IN.Color.a;
      }
      
