      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D heatMap : texunit1,
                  uniform sampler2D alphaMap : texunit2 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(heatMap, IN.Tex1.xy);
        OUT.Color.xyz = decalColor;
        OUT.Color.w = tex2D(alphaMap, IN.Tex2.xy).w * IN.Color.w;
      }
      
