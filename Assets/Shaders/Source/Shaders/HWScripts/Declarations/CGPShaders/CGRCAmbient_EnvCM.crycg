      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE envMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Reflect }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);
        float3 amb = lerp(decalColor.xyz*Ambient.xyz, envColor.xyz, Reflect.x);
        OUT.Color.xyz = amb.xyz;
        OUT.Color.a = decalColor.a * Ambient.a;
      }