#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_C0
  };

# ifdef _HDR_MRT
        FOUT_2
# else
        FOUT
# endif
}

CoreScript
{
  float4 vSample = tex2D(baseMap, IN.Tex0.xy) * IN.Color;
  vSample.xyz = HDREncodeAmb(vSample.xyz);

  HDROutput(OUT, vSample, 1);
}

