#include "../CGVPMacro.csi"

PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0,
  uniform sampler2D glossMap : texunit1
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
    OUT_C1
  };

  FOUT
}

CoreScript
{
  float4 vSample = tex2D(baseMap, IN.Tex0.xy) * IN.Color;
  vSample += tex2D(glossMap, IN.Tex1.xy);
  vSample.xyz = HDREncodeAmb(vSample.xyz);
  vSample.xyz = HDRFogBlend(vSample.xyz, IN.Color1.w, GlobalFogColor.xyz);

  OUT.Color = vSample;
}

