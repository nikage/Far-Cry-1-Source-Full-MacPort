      #include "../CGVPMacro.csi"

      NoFog
      PS20Only

      MainInput { uniform sampler2D offsMap : register(s0),
                  uniform sampler2D clampMap : register(s1) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
        };

        FOUT
      }
      CoreScript
      {
        // load the offset
        float4 vOffs = tex2D(offsMap, IN.Tex0.xy);
        
        float2 vForce = IN.Tex1.xy*0.5+0.5;
        float2 offs = IN.Tex2.x*vForce.xy + (1-IN.Tex2.x)*vOffs.xy;

        float4 vClamp = tex2D(clampMap, offs.xy);
        
        OUT.Color = vClamp;
      }

