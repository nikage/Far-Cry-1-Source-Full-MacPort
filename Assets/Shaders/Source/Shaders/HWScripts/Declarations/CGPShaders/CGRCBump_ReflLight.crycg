      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D bumpMap : texunit1,
                  uniform samplerCUBE envMap : texunit3,
                  uniform float4 Diffuse,
                  uniform float4 Specular }

      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);
        bumpNormal.xyz = normalize(bumpNormal.xyz);
        float3 lightVec = normalize(IN.Tex2.xyz);
        float NdotL = saturate(dot(bumpNormal.xyz, lightVec));
        float3 reflVec = (2*NdotL*bumpNormal.xyz)-lightVec.xyz;
        float4 envSpec = texCUBE(envMap, reflVec);
        float3 lit = IN.Color.xyz * Diffuse.xyz * decalColor.xyz * 2;
        float3 spec = envSpec.xyz * Specular.xyz * 2;
        OUT.Color.xyz = lit + spec;
        OUT.Color.w = decalColor.w * Diffuse.w;
      }
