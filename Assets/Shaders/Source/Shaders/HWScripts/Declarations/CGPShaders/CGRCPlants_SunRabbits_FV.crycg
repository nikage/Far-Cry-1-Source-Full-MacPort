      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D sunMap : texunit1,
                  uniform sampler2D fogMap : texunit2,
                  uniform sampler2D fogEnterMap : texunit3,
                  uniform float4 Ambient,
                  uniform float4 Diffuse,
                  uniform float4 FogColor }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the decal
        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);

        // load the fog
        float4 fogColor = tex2D(fogMap, IN.Tex2.xy);
        float4 fogEnterColor = tex2D(fogEnterMap, IN.Tex3.xy);
        
        float4 color = decalColor * Ambient;
        color.xyz = HDREncode(color.xyz * IN.Color.xyz);
        float3 colorSun = HDREncodeAmb(sunColor.xyz) * IN.Color.a * Ambient.xyz * Diffuse.a;
        float fog = fogColor.a * fogEnterColor.a;
        color.xyz = color.xyz + colorSun.xyz;
        color.xyz = HDREncodeAmb(FogColor.xyz)*fog + color.xyz*(1-fog);
        
        OUT.Color = color;
      }
      

