      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D bumpMap : texunit0,
                  uniform samplerCUBE envMap : texunit3 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
# ifdef _PS_1_1
        float4 env = texCUBE_reflect_dp3x3(envMap, IN.Tex3, IN.Tex1, IN.Tex2, bumpColor);
# else
        float3 E = float3(IN.Tex1.w, IN.Tex2.w, IN.Tex3.w);
        float3 N = float3(dot(IN.Tex1.xyz, bumpColor.xyz),
                          dot(IN.Tex2.xyz, bumpColor.xyz),
                          dot(IN.Tex3.xyz, bumpColor.xyz));
        float4 env = texCUBE(envMap, 2*(dot(N, E)/dot(N, N))*N - E);
# endif        
        float3 vColor = HDREncodeAmb(env.xyz);
        OUT.Color.xyz = HDRFogBlend(vColor.xyz, IN.Color1.w, GlobalFogColor.xyz);
        OUT.Color.a = IN.Color.a;
      }

