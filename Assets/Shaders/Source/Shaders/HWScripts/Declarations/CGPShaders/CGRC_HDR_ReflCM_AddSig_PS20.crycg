#include "../CGVPMacro.csi"

PS20Only

MainInput 
{
  uniform samplerCUBE reflMap : texunit0,
  uniform sampler2D baseMap : texunit1
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
    OUT_C1
  };

  FOUT
}

CoreScript
{
  float3 vRefl = texCUBE(reflMap, IN.Tex0.xyz).xyz * IN.Color.xyz + IN.Color1.xyz;
  float4 vBase = tex2D(baseMap, IN.Tex1.xy);
  float4 vColor;
  vColor.xyz = HDREncodeAmb(vRefl.xyz + vBase.xyz - 0.5);
  vColor.a = vBase.a * IN.Color.a;

  OUT.Color = vColor;
}

