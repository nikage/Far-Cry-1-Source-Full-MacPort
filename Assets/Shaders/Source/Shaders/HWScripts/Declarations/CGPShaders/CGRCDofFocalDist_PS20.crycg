#include "../CGVPMacro.csi"

PS20Only
NoFog

MainInput 
{
	uniform sampler2D ScreenMap : texunit0,
	uniform float4    DofFocalParams
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_T1
      OUT_C0
    };

    FOUT
}

CoreScript
{
	float4 vScrColor = tex2D(ScreenMap, IN.Tex0.xy);

	// get max scale
	const float fDistanceScale=1.0/2048.0;
	
	float fFocus=saturate(DofFocalParams.x*fDistanceScale);
	float fRange=1/(DofFocalParams.y*fDistanceScale);
		
	// compute pixel depth
	float fDepth=saturate(fDistanceScale*IN.Tex1.w);
	// compute pixel focal distance
	float fFocalDist=saturate(fRange*abs(fFocus-fDepth));	
	
    OUT.Color.xyz =fFocalDist;
    //OUT.Color.xyz = IN.Tex1.w; //IN.Color.w; //vScrColor.xyz;
    OUT.Color.a = vScrColor.w;
}
