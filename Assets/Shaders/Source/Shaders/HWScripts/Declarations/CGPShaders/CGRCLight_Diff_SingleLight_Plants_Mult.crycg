      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float3 dif = HDREncode(decalColor.xyz * Diffuse.xyz);

        // finally add them all together
        OUT.Color.xyz = HDRFogBlend(dif, IN.Color1.w, GlobalFogColor.xyz);
        OUT.Color.w = decalColor.w * Diffuse.w;
      }

