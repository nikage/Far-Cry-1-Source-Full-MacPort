      #include "../CGVPMacro.csi"

      MainInput { uniform samplerCUBE projMap : texunit0,
                  uniform sampler2D attenMap : texunit1,
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        float4 projColor = texCUBE(projMap, IN.Tex0.xyz);
        float atten = saturate((2*(IN.Color.b-0.5)) * -(2*(IN.Color.b-0.5)) + (1-tex2D(attenMap, IN.Tex1.xy).b));
        atten = atten * IN.Color.a;

        // finally add them all together
        OUT.Color.xyz = Ambient.xyz*atten + projColor.xyz*(1-atten);
        OUT.Color.w = Ambient.w;
      }

