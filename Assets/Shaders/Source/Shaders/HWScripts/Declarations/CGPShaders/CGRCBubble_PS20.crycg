      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform samplerCUBE envMap : register(s1),
                  uniform float4 AlphaScaleBias : register(c0) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 baseColor = tex2D(baseMap, IN.Tex0.xy);
        // load the env cube
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);
        
        float3 color = saturate(baseColor.xyz * envColor.xyz * 2);
        float fresnel = (1-abs(IN.Tex2.r)) * AlphaScaleBias.x + AlphaScaleBias.y;
        float glow = saturate((envColor.a*envColor.a-0.75)*4);
        
        color = lerp(color.xyz, envColor.xyz, glow);
        float alpha = fresnel + glow;

        OUT.Color.xyz = color.xyz;
        OUT.Color.a = alpha;
      }

