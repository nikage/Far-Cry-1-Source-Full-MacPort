      #include "../CGVPMacro.csi"

      NoFog
      
      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Color }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color = IN.Color.a * decalColor * Color;
      }
