      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE envMap : texunit1,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 envColor = texCUBE(envMap, IN.Tex1.xyz);

        float3 col = (envColor.xyz * (1-Diffuse.xyz)) + (decalColor.xyz * Diffuse.xyz);
        col = HDREncodeAmb(col.xyz);

        // finally add them all together
        OUT.Color.xyz = HDRFogBlend(col.xyz, IN.Color.w, GlobalFogColor.xyz);
        OUT.Color.w = decalColor.a * Diffuse.a;
      }

