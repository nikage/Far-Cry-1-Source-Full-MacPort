      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D sunMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Sun }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the decal
        float4 sunColor = tex2D(sunMap, IN.Tex1.xy);
        float3 colorS = sunColor.xyz * IN.Color.a * Ambient.xyz * Sun.a;
        color.xyz = colorS;
        color.a = decalColor.a * Ambient.a;
        OUT.Color = color;
      }
      
