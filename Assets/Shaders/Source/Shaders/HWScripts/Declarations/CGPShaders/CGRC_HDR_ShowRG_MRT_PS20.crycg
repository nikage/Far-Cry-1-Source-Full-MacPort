#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMapRG : texunit0,
  uniform sampler2D baseMapBA : texunit1
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  float4 vSample;
  vSample.xy = tex2D(baseMapRG, IN.Tex0.xy).xy;
  vSample.zw = tex2D(baseMapBA, IN.Tex0.xy).xy;

  OUT.Color = vSample;
}

