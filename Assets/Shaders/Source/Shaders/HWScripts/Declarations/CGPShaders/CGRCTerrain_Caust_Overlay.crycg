      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D caustMap : texunit0,
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the detail
        float4 caustColor = tex2D(caustMap, IN.Tex1.xy);
        
        float3 caust = caustColor.xyz * IN.Color.a * Ambient.xyz;
        OUT.Color.xyz = caust.xyz * 2;
        OUT.Color.a = caustColor.a * Ambient.a;
      }
      
      