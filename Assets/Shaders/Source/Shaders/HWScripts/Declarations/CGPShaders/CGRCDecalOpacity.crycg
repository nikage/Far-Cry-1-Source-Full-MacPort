      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D opacityMap : texunit1 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the opacity
        float4 opColor = tex2D(opacityMap, IN.Tex1.xy);
        float4 color = IN.Color * decalColor;
        color.a = color.a * opColor.a;
        OUT.Color = color;
      }

