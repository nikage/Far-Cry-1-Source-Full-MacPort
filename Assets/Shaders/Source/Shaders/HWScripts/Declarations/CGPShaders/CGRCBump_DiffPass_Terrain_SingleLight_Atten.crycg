      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D bumpMap : texunit1,
                  uniform samplerCUBE normCubeMap : texunit2,
                  uniform sampler2D attenMap : texunit3,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        float4 bumpNormal = EXPAND(tex2D(bumpMap, IN.Tex1.xy));
        float atten = saturate(EXPAND(IN.Color1.b) * -(EXPAND(IN.Color1.b)) + (1-tex2D(attenMap, IN.Tex3.xy).b));

        // Light vector from normalization cube-map
        float4 lVec = EXPAND(texCUBE(normCubeMap, IN.Tex2.xyz));
        float NdotL = saturate(dot(lVec.xyz, bumpNormal.xyz));

# ifdef _HDR
        float3 dif = (decalColor.xyz * NdotL * atten * Diffuse.xyz);
        dif.xyz = HDREncode(dif.xyz);
# else        
        float3 dif = ((decalColor.xyz*0.75+0.25) * NdotL * atten * Diffuse.xyz);
# endif	

        // finally add them all together
        OUT.Color.xyz = HDRFogBlend(dif, IN.Color.w, GlobalFogColor.xyz);
        OUT.Color.w = decalColor.w * Diffuse.w;
      }

