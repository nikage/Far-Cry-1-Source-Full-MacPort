      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D bumpMap : texunit1,
                  uniform samplerCUBE envMap : texunit2,
                  uniform float4 Ambient,
                  uniform float4 EnvMapParams,
                  uniform float4 FresnelParams }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
          OUT_T4
          OUT_T5
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        float4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);

        // normalize post-filtered bump normals
        bumpNormal.xyz = normalize(bumpNormal.xyz);

        half fEnvmapAmount = EnvMapParams.x;

        half fFresnelScale = FresnelParams.x;
        half fFresnelBias = FresnelParams.y;
        half fFresnelPow = FresnelParams.z;

        // Calc Reflection Vector
        half3x3 worldTangentSpace;
        worldTangentSpace[0] = IN.Tex3.xyz;
        worldTangentSpace[1] = IN.Tex4.xyz;
        worldTangentSpace[2] = IN.Tex5.xyz;

        float3 viewVec = normalize(IN.Tex2.xyz);
        half NdotE = dot(bumpNormal.xyz, viewVec);
        half3 reflectVect = (2.0*NdotE*bumpNormal.xyz)-(dot(bumpNormal.xyz, bumpNormal.xyz)*viewVec);
        half3 worldReflectVec = mul(reflectVect, worldTangentSpace);

        // Calc Fresnel factor
        half fresnel = fFresnelBias + (pow((1-NdotE), fFresnelPow) * fFresnelScale);

        // Calc environment
        half3 env = texCUBE(envMap, worldReflectVec).xyz * fEnvmapAmount;
        env *= fresnel;
        
        amb = Ambient.xyz * decalColor.xyz + decalColor.w * decalColor.xyz;
        
        OUT.Color.xyz = amb + env;
        OUT.Color.w = Ambient.w;
      }
      
