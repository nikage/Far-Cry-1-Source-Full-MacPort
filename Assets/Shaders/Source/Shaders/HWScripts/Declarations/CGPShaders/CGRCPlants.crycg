      #include "../CGVPMacro.csi"

      SupportsInstancing

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
          OUT_C1
        };

# ifdef _HDR_MRT
        FOUT_2
# else
        FOUT
# endif
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 color;
        color = decalColor * IN.Color;
        color.xyz = HDREncode(color.xyz);
        HDROutput(OUT, color, 1, GlobalFogColor.xyz, IN.Color1.w);
      }
      
