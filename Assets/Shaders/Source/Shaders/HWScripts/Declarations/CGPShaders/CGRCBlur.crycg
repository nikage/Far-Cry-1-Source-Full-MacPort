// ===============================================================
// Fragment Program: Blur
// Description: averages texture colors
// Last Update: 12/09/2003
// Coder: Tiago Sousa
// ===============================================================

#include "../CGVPMacro.csi"

NoFog

MainInput 
{
	uniform sampler2D baseMap0 : texunit0,
	uniform sampler2D baseMap1 : texunit1,
	uniform sampler2D baseMap2 : texunit2,
	uniform sampler2D baseMap3 : texunit3 
}

DeclarationsScript
{
	struct vertout
	{
	  OUT_T0
	  OUT_T1
	  OUT_T2
	  OUT_T3
	};

	FOUT
}

CoreScript
{
	// load the decal
	float4 color0 = tex2D(baseMap0, IN.Tex0.xy);
	float4 color1 = tex2D(baseMap1, IN.Tex1.xy);
	float4 color2 = tex2D(baseMap2, IN.Tex2.xy);
	float4 color3 = tex2D(baseMap3, IN.Tex3.xy);

  // safe/acurate version
	//float4 avg= float4(0.5, 0.5, 0.5, 0.5);
	//float4 colorA = saturate(color0*avg+color1*avg)*0.5;
	//float4 colorB = saturate(color2*avg+color3*avg)*0.5;
	
	// fast version
	float4 avg=saturate(color0*0.25+color2*0.25+color1*0.25+color3*0.25);
	
	// finally add them all together
	OUT.Color =avg;
}

