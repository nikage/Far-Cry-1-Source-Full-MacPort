#ifdef D3D

      Script
      (
        
        ps.1.0

        
        tex t0			

        
        
        
        texm3x3pad t1, t0
        texm3x3pad t2, t0		
        texm3x3vspec t3, t0
        
        mul r0.rgb, t3, c0;
        +mov r0.a, c0;
      )
    
#endif

#ifdef OPENGL

      CombinersStat
      (
        !!RC1.0
        out.rgb = tex3 * const0;
        out.a = unsigned_invert(zero);
      )
    
#endif
