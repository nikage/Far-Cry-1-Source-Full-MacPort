      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D attenMap : texunit1 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the opacity
        float4 attenColor = tex2D(attenMap, IN.Tex1.xy);
        float3 color = decalColor.xyz*(1-attenColor.a) + 0.5*attenColor.a;
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = 1;
      }


