      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D baseMap : register(s0),
                  uniform sampler2D bumpMap : register(s1),
                  uniform sampler2D lightMap : register(s2),
                  uniform sampler2D lightDirMap : register(s3),
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
          OUT_T3
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        half4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the bump normal
        half4 bumpNormal = 2*(tex2D(bumpMap, IN.Tex1.xy)-0.5);
        // load the lm
        half4 lmColor = tex2D(lightMap, IN.Tex2.xy);
        // load the lm dir
        float4 lmDat = tex2D(lightDirMap, IN.Tex3.xy);
        float3 lmDir = 2*(lmDat.xyz-0.5);

        // normalize post-filtered bump normals
        bumpNormal.xyz = normalize(bumpNormal.xyz);

        // normalize post-filtered light dirs
        lmDir.xyz = normalize(lmDir.xyz);

        float NdotL = saturate(dot(lmDir.xyz, bumpNormal.xyz));
        half  lmIntens = NdotL * lmColor.a + (1-lmColor.a);
        half3 dif = (decalColor.xyz * lmColor.xyz * lmDat.a * lmIntens) * 4;
        half3 amb = decalColor.xyz * Ambient.xyz;

        // finally add them all together
        OUT.Color.xyz = amb + dif;
        OUT.Color.w = decalColor.w * Ambient.w;
      }

