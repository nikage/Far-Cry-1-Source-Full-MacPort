      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D detMap0 : texunit0,
                  uniform sampler2D detMap1 : texunit1 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the detail
        float4 detColor0 = tex2D(detMap0, IN.Tex0.xy);
        float4 detColor1 = tex2D(detMap1, IN.Tex1.xy);
        
        detColor0.xyz = detColor0.xyz*IN.Color.b + 0.5*(1-IN.Color.b);
        detColor1.xyz = detColor1.xyz*IN.Color1.b + 0.5*(1-IN.Color1.b);
        float3 color = detColor0.xyz * detColor1.xyz * 2;
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = 1;
      }
      
