      #include "../CGVPMacro.csi"

      PS20Only

      MainInput { uniform sampler2D screenMap : texunit0 }

      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        OUT.Color = tex2D(screenMap, IN.Tex0.xy);
      }
