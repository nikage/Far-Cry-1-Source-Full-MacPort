// ===============================================================
// Vertex Program: color contrast
// Description: used in color contrast post-processing fx
// Last Update: 02/06/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D baseMap0 : texunit0,
            uniform float4 fContrastAmount            
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  // load the decal
  float3 fTex0 = tex2D(baseMap0, IN.Tex0.xy).rgb;
      
  OUT.Color.rgb= 0.5f+fContrastAmount.a*(fTex0-0.5f);
  OUT.Color.a = 1.0f;
}


