#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0,
  uniform float4 Ambient
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  float4 vSample = tex2D(baseMap, IN.Tex0.xy) * Ambient;
  vSample.xyz = HDREncode(vSample.xyz);

  OUT.Color = vSample;
}

