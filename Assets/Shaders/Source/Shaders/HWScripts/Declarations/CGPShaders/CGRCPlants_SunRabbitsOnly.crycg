      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D sunMap : texunit0,
                  uniform float4 Ambient,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        float4 sunColor = tex2D(sunMap, IN.Tex0.xy);

        float3 colorSun = HDREncodeAmb(sunColor.xyz * IN.Color.a * Ambient.xyz * Diffuse.a);

        OUT.Color.xyz = colorSun.xyz;
        OUT.Color.a = Ambient.a;
      }
      
