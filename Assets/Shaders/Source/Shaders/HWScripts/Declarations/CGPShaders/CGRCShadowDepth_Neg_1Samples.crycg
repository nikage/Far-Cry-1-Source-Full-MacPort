      #include "../CGVPMacro.csi"

      NoFog
#ifdef NV4X
      PS20Only
#endif

      MainInput { uniform sampler2D shadowMap0 : texunit0,
                  uniform sampler2D baseMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Fading }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_T2
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        FLOAT4 shadowColor0 = tex2Dproj(shadowMap0, IN.Tex0.xyzw);
        FLOAT4 decalColor = tex2D(baseMap, IN.Tex1.xy);
        FLOAT3 color = decalColor.xyz * Ambient.xyz;
        color = HDREncodeAmb(color);
        FLOAT shadow = (IN.Tex2.z>0.5)?1-shadowColor0.b:0;
        shadow *= Fading.x;
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = shadow;
      }
      
