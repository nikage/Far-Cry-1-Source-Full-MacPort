      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D shadMap : texunit1,
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        // load the detail
        float4 shadColor = tex2Dproj(shadMap, IN.Tex1.xyzw);
        
        float3 color = (decalColor.xyz * IN.Color.xyz * Ambient.xyz);
        color.xyz = HDREncode(color.xyz);
        OUT.Color.xyz = HDRFogBlend(color.xyz, IN.Color.w, GlobalFogColor.xyz);
        OUT.Color.a = 1-shadColor.b;
      }
      
