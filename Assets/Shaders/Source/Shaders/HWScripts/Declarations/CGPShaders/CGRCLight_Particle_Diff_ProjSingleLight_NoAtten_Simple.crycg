      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform samplerCUBE projMap : texunit1 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 projColor = texCUBE(projMap, IN.Tex1.xyz);

        float3 dif = (decalColor.xyz * projColor.xyz * IN.Color.xyz);
        dif.xyz = HDREncode(dif.xyz);

        // finally add them all together
        OUT.Color.xyz = dif;
        OUT.Color.w = decalColor.w * IN.Color.a;
      }

