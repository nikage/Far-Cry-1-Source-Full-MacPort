#include "../CGVPMacro.csi"

PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_C0
    OUT_C1
  };

  FOUT
}

CoreScript
{
  float4 vSample = tex2D(baseMap, IN.Tex0.xy);
  vSample.xyz = HDREncodeAmb(vSample.xyz)*IN.Color.xyz;

  OUT.Color.xyz = HDRFogBlend(vSample.xyz, IN.Color1.w, GlobalFogColor.xyz);
  OUT.Color.a = vSample.a*IN.Color.a;
}

