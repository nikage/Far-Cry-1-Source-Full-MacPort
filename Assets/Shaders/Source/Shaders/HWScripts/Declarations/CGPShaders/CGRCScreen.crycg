      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D bumpMap : texunit0,
                  uniform sampler2D baseMap : texunit1  }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);
        float4 decalColor = tex2D(baseMap, IN.Tex1.xy);
        OUT.Color.xyz = decalColor.xyz;
        OUT.Color.a = 1;
      }
      
