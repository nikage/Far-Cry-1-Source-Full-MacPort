    float tapLerp=tapCenter.w*0.5+tapBlured.w*0.5;        
    float3 vFinalColor=tapBlured.xyz*tapCenter.w+tapCenter.xyz*(1-tapCenter.w);
    
    OUT.Color.xyz = vFinalColor.xyz*vBlurAmount.w+tapCenter.xyz*(1-vBlurAmount.w);
    OUT.Color.a = 1;
}
