#include "../CGVPMacro.csi"

PS20Only
NoFog

MainInput 
{
#ifdef OPENGL
    uniform samplerRECT ScreenMap : texunit0,
    uniform samplerRECT FocalDistMap : texunit1,
#endif    
#ifdef D3D
    uniform sampler2D ScreenMap : register(s0),
    uniform sampler2D FocalDistMap : register(s1),
#endif    
    uniform float4 vFocalDistance,
    uniform float4 vBlurAmount,
    uniform float4 vPixelSize
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1 
  };

  FOUT
}

CoreScript
{
    // fetch textures
#ifdef OPENGL
    float4 vTapCenterColor = texRECT(ScreenMap, IN.Tex0.xy);
    float4 vTapBluredColor = texRECT(FocalDistMap, IN.Tex1.xy);
#endif    
#ifdef D3D
    float4 vTapCenterColor = tex2D(ScreenMap, IN.Tex0.xy);
    float4 vTapBluredColor = tex2D(FocalDistMap, IN.Tex1.xy);
#endif	

	float4 tapCenter=vTapCenterColor;
	float4 tapBlured=vTapBluredColor;
	
	/*
