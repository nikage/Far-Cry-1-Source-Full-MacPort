      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D attenMap : texunit1,
                  uniform float4 Ambient,
                  uniform float4 Diffuse }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
          OUT_C0
          OUT_C1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float atten = saturate((2*(IN.Color.a-0.5)) * -(2*(IN.Color.a-0.5)) + (1-tex2D(attenMap, IN.Tex1.xy).b));

        // Light vector from normalization cube-map
        float3 dif = HDREncode(decalColor.xyz * atten * Diffuse.xyz);
        float3 amb = HDREncode(Ambient.xyz * decalColor.xyz * IN.Color.xyz);

        // finally add them all together
        OUT.Color.xyz = HDRFogBlend(amb + dif, IN.Color1.w, GlobalFogColor.xyz);
        OUT.Color.w = decalColor.w * Ambient.w;
      }


