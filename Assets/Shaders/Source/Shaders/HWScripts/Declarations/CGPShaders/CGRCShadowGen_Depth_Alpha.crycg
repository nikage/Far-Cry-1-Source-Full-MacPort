      #include "../CGVPMacro.csi"

      NoFog

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color.xyz = decalColor.xyz;
        OUT.Color.a = 1;
      }