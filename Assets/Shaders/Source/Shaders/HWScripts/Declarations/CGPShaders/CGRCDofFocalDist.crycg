#include "../CGVPMacro.csi"

NoFog

MainInput 
{
	uniform sampler2D ScreenMap : texunit0
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
      OUT_C0
    };

    FOUT
}

CoreScript
{
	float4 vScrColor = tex2D(ScreenMap, IN.Tex0.xy);

    OUT.Color.xyz = IN.Color.w; //vScrColor.xyz;
    OUT.Color.a = vScrColor.w;
}
