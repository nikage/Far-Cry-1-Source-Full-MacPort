#include "../CGVPMacro.csi"

NoFog

MainInput 
{
    uniform sampler2D ScreenMap : texunit0
}

DeclarationsScript
{
    struct vertout
    {
      OUT_P
      OUT_C0
    };

    FOUT
}

CoreScript
{	
    OUT.Color.xyz = IN.Color.w;
    OUT.Color.w = 1;
}
