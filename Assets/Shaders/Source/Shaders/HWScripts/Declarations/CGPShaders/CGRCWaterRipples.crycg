#include "../CGVPMacro.csi"

MainInput { uniform sampler2D bumpMask : texunit0, 
            uniform sampler2D bumpMap : texunit1,
#ifdef OPENGL
            uniform samplerRECT refMap : texunit2, 
#endif
#ifdef D3D
            uniform sampler2D refMap : texunit2,
#endif
            uniform float4 Matrix
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_T2
    OUT_C0
  };

  FOUT
}

CoreScript
{
  // fetch mask/bump/refraction maps  
  float4 maskColor = tex2D(bumpMask, IN.Tex0.xy);
  float4 bumpColor = tex2D(bumpMap, IN.Tex1.xy);

#ifdef D3D
  #ifdef PROFILE_PS_1_1 
    float4 refrColor = offsettex2D(refMap, IN.Tex2.xy, bumpColor, Matrix); 
  #endif
  #ifdef OTHER
    newst = IN.Tex2.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = tex2D(refMap, newst);
  #endif
#endif

#ifdef OPENGL
  #ifdef PROFILE_PS_1_1 
    float4 refrColor = offsettexRECT(refMap, IN.Tex2.xy, bumpColor, Matrix);
    
  #endif
  #ifdef OTHER
    float2 newst = IN.Tex2.xy / IN.Tex1.w;
    newst = newst + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
    float4 refrColor = texRECT(refMap, newst);
  #endif    
#endif

  OUT.Color.xyz =2*refrColor*0.52;
  OUT.Color.w= maskColor.w; //*IN.Color.w;
}
