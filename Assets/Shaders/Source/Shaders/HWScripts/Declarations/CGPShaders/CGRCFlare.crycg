      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Flare }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 flareColor = tex2D(baseMap, IN.Tex0.xy);

        float3 color = flareColor.xyz * Flare.xyz * IN.Color.xyz;
        OUT.Color.xyz = color.xyz;
        OUT.Color.a = flareColor.a;
      }

