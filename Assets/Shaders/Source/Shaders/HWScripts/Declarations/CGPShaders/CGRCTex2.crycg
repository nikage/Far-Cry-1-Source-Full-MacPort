      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform sampler2D depthMap : texunit1,
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_T1
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float4 depthColor = tex2D(depthMap, IN.Tex1.xy);
        OUT.Color.xyz = depthColor.xyz;
        OUT.Color.a = 1; //decalColor.a;
      }