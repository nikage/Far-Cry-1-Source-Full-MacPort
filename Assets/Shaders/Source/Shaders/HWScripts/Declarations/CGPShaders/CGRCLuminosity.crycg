      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color.xyz = dif.r*0.33 + dif.g*0.59 + dif.b*0.11;
        OUT.Color.w = 1;
      }

