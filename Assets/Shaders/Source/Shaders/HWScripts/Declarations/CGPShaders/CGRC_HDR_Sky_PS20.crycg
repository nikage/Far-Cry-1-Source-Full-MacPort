#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_C0
  };

# ifdef _HDR_MRT
        FOUT_2
# else
        FOUT
# endif
}

CoreScript
{
  FLOAT4 vSample = tex2D(baseMap, IN.Tex0.xy);
  vSample.xyz *= IN.Color.xyz * (1 + vSample.w*8);
  vSample.w = IN.Color.w;

  HDROutput(OUT, vSample, 1);
}

