// This include is required for all vertex/fragment programs. Contains shared stuff.
#include "../CGVPMacro.csi"

// Fragment program inputs. Can be texture samplers and constants
MainInput 
{
    uniform sampler2D BumpMap : texunit0    
}

// Fragment program inputs declaration. Where data comes from, vertex texture coordinates, vertex colors, etc.
DeclarationsScript
{
  struct vertout
  {
    OUT_T0    
  };

  FOUT
}

// This is where main CG/HLSL fragment program code goes
CoreScript
{
    float4 vBumpColor = tex2D(BumpMap, IN.Tex0.xy);
    
    OUT.Color.xyz = vBumpColor.xyz;
    OUT.Color.a = 1;
}
