
#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0,
  uniform sampler2D baseMap_K : texunit1,
  uniform float4 vSampleOffsets[16]
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  FLOAT4 sample = 0.0f;

  for(int i=0; i<16; i++)
  {
    float4 vColor = tex2D(baseMap, IN.Tex0.xy + vSampleOffsets[i].xy);
    vColor.xyz *= tex2D(baseMap_K, IN.Tex0.xy + vSampleOffsets[i].xy).x;
    sample += vColor;
  }
    
  FLOAT4 Col = sample / 16;
  OUT.Color = Col;
}

