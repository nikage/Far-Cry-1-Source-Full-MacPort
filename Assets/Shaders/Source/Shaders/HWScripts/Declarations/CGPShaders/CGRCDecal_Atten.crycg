      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0,
                  uniform float4 Ambient }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        OUT.Color.xyz = decalColor.xyz * Ambient.xyz;
        float atten = (1-saturate(2*(IN.Color.a-0.5)));
        OUT.Color.a = decalColor.a * Ambient.a * IN.Color.b * atten;
      }


