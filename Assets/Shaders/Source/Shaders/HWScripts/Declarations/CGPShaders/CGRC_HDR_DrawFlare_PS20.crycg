#include "../CGVPMacro.csi"

PS20Only

MainInput 
{
  uniform sampler2D baseMap : texunit0
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_C0
  };

  FOUT
}

CoreScript
{
  FLOAT4 vSample = tex2D(baseMap, IN.Tex0.xy);
  vSample.xyz = vSample.xyz * IN.Color.xyz * 4;
  vSample.w *= IN.Color.w;

  OUT.Color = vSample;
}

