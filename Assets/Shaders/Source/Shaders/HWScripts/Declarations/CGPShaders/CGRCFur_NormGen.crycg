      #include "../CGVPMacro.csi"

      NoFog
      PS20Only

      MainInput { uniform sampler2D offsMap : register(s0),
                  uniform sampler2D normMap : register(s1) }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
        };

        FOUT
      }
      CoreScript
      {
        // load the offset
        float4 vOffs = tex2D(offsMap, IN.Tex0.xy);
        float4 vNorm = tex2D(normMap, vOffs.xy);
        
        OUT.Color = vNorm;
      }

