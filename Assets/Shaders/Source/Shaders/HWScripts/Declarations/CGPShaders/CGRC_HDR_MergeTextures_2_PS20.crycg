
#include "../CGVPMacro.csi"

NoFog
PS20Only

MainInput 
{
  uniform sampler2D baseMap0 : texunit0,
  uniform sampler2D baseMap1 : texunit1,
  uniform FLOAT4 vSampleWeights[2]
}

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
  };

  FOUT
}

CoreScript
{
  FLOAT4 vColor = 0.0f;
  
  vColor += vSampleWeights[0] * tex2D(baseMap0, IN.Tex0.xy);
  vColor += vSampleWeights[1] * tex2D(baseMap1, IN.Tex0.xy);
    
  OUT.Color = vColor;
}

