#include "../CGVPMacro.csi"

MainInput 
{
	uniform sampler2D ScreenMap : texunit0
}

DeclarationsScript
{
    struct vertout
    {
      OUT_T0
    };

    FOUT
}

CoreScript
{
	float4 vScrColor = tex2D(ScreenMap, IN.Tex0.xy);

    OUT.Color.xyz = vScrColor.xyz;
    OUT.Color.a = vScrColor.z;
}
