      #include "../CGVPMacro.csi"

      MainInput { uniform sampler2D baseMap : texunit0 }
      DeclarationsScript
      {
        struct vertout
        {
          OUT_T0
          OUT_C0
        };

        FOUT
      }
      CoreScript
      {
        // load the decal
        float4 decalColor = tex2D(baseMap, IN.Tex0.xy);
        float3 color = HDREncode(decalColor.xyz * IN.Color.xyz);
        color.xyz = HDRFogBlend(color.xyz, IN.Color.w, GlobalFogColor.xyz);

        // finally add them all together
        OUT.Color.xyz = color.xyz;
        OUT.Color.w = decalColor.w * IN.Color.w;
      }

