// ===============================================================
// Fragment Program: Indoor Water
// Description: used in indoor refractive water (w/ fake specular)
// Last Update: 03/09/2003
// Coder: Tiago Sousa
// ===============================================================


#include "../CGVPMacro.csi"


MainInput { uniform sampler2D bumpMap : texunit0,
            uniform sampler2D refMap : texunit1,
            uniform float4 Matrix,
            uniform float4 Ambient,
            uniform float4 WaterColor
          }

DeclarationsScript
{
  struct vertout
  {
    OUT_T0
    OUT_T1
    OUT_C0
  };

  FOUT
}

CoreScript
{  
  // load the decal
  float4 bumpColor = tex2D(bumpMap, IN.Tex0.xy);

  // get env bump map surface
# ifdef _PS_1_1
  float4 refrColor = offsettex2D(refMap, IN.Tex1.xy, bumpColor, Matrix);          
# else
  float2 newst = IN.Tex1.xy + Matrix.xy * bumpColor.xx + Matrix.zw * bumpColor.yy;
  float4 refrColor = tex2D(refMap, newst);
# endif                
  
  // get brightest color  
  float fDiffuse=2*(dot(refrColor.xyz, float3(0.33, 0.59, 0.11))-0.5);                          

  // aprox~ spec^8      
  float fFakeSpec=fDiffuse;
  fFakeSpec=saturate(2*(fFakeSpec*fFakeSpec-0.6));                                            
        
  // compute water surface color  
  float3 fWaterSurfColor=saturate(fDiffuse*WaterColor.xyz+fFakeSpec*Ambient.w);            
  
  // set water to ambient color
  OUT.Color.xyz =Ambient.xyz*fWaterSurfColor;                                    
  // output fresnel*transparency amount
  OUT.Color.w = IN.Color.w*WaterColor.w; 
}